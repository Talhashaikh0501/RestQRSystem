@model IEnumerable<RestaurantQR.Models.MenuItem>

@{
    ViewData["Title"] = "Menu Management";

    var menuItems = Model?.ToList() ?? new List<RestaurantQR.Models.MenuItem>();
    var totalItems = menuItems.Count;
    var availableItems = menuItems.Count(x => x.IsAvailable);
    var unavailableItems = totalItems - availableItems;
}

<style>
    :root {
        --rq-white: #fffdf7;
        --rq-cream: #f5e6ca;
        --rq-beige: #dcc7aa;
        --rq-coffee: #6f4e37;
        --rq-espresso: #4b3832;
        --rq-deep: #352822;
        --rq-text: #4b3832;
        --rq-muted: #8c7665;
        --rq-gold: #b98a52;
        --rq-green: #6f963f;
        --rq-green-light: #edf6df;
        --rq-red: #a75b50;
        --rq-red-light: #fae9e6;
        --rq-border: rgba(111, 78, 55, .13);
        --rq-shadow: 0 22px 60px rgba(75, 56, 50, .10);
    }

    /* =========================================================
                   PAGE
                   ========================================================= */

    .rq-mm-page {
        position: relative;
        width: 100%;
        min-height: calc(100vh - 100px);
        overflow: hidden;
        padding: clamp(30px, 5vw, 70px) clamp(16px, 5vw, 70px) 100px;
        color: var(--rq-text);
        background: radial-gradient( circle at 5% 15%, rgba(255,255,255,.95) 0%, rgba(255,255,255,.50) 18%, transparent 40% ), radial-gradient( circle at 94% 17%, rgba(220,199,170,.45) 0%, transparent 35% ), radial-gradient( circle at 80% 90%, rgba(185,138,82,.09) 0%, transparent 32% ), linear-gradient( 135deg, var(--rq-white) 0%, #f9efdf 48%, var(--rq-cream) 100% );
    }

        .rq-mm-page::before {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            left: -210px;
            top: 150px;
            border-radius: 50%;
            background: rgba(255,255,255,.50);
            filter: blur(3px);
            pointer-events: none;
            animation: rqMmFloatOne 10s ease-in-out infinite alternate;
        }

        .rq-mm-page::after {
            content: "";
            position: absolute;
            width: 360px;
            height: 360px;
            right: -160px;
            bottom: 40px;
            border-radius: 50%;
            background: rgba(220,199,170,.25);
            pointer-events: none;
            animation: rqMmFloatTwo 12s ease-in-out infinite alternate;
        }

    @@keyframes rqMmFloatOne {
        from {
            transform: translate3d(0,0,0) scale(1);
        }

        to {
            transform: translate3d(35px,-25px,0) scale(1.08);
        }
    }

    @@keyframes rqMmFloatTwo {
        from {
            transform: translate3d(0,0,0);
        }

        to {
            transform: translate3d(-35px,-20px,0);
        }
    }

    /* =========================================================
                   CONTENT
                   ========================================================= */

    .rq-mm-content {
        position: relative;
        z-index: 2;
        width: min(1380px,100%);
        margin: 0 auto;
    }

    /* =========================================================
                   HERO
                   ========================================================= */

    .rq-mm-hero {
        display: grid;
        grid-template-columns: minmax(0,1fr) auto;
        align-items: end;
        gap: 40px;
        margin-bottom: 35px;
        animation: rqMmReveal .75s cubic-bezier(.2,.8,.2,1) both;
    }

    .rq-mm-eyebrow {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 17px;
        color: var(--rq-coffee);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 4px;
        text-transform: uppercase;
    }

        .rq-mm-eyebrow::before {
            content: "";
            display: block;
            width: 48px;
            height: 1px;
            background: linear-gradient( 90deg, transparent, var(--rq-gold) );
        }

    .rq-mm-title {
        margin: 0;
        max-width: 850px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(46px,6vw,82px);
        line-height: .94;
        letter-spacing: -4px;
        font-weight: 500;
        color: var(--rq-espresso);
    }

        .rq-mm-title span {
            color: var(--rq-coffee);
            font-style: italic;
            font-weight: 400;
        }

    .rq-mm-description {
        max-width: 680px;
        margin: 21px 0 0;
        color: var(--rq-muted);
        font-size: 15px;
        line-height: 1.85;
    }

    .rq-mm-hero-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* =========================================================
                   ADD / CATEGORY BUTTONS
                   ========================================================= */

    .rq-mm-add {
        position: relative;
        flex-shrink: 0;
        min-height: 58px;
        padding: 7px 24px 7px 8px;
        border: 1px solid rgba(75,56,50,.13);
        border-radius: 999px;
        background: var(--rq-espresso);
        color: white !important;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        gap: 14px;
        overflow: hidden;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 18px 36px rgba(75,56,50,.19);
        transition: transform .3s ease, box-shadow .3s ease;
    }

        .rq-mm-add::before {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            left: -90px;
            top: -30px;
            background: rgba(255,255,255,.14);
            border-radius: 50%;
            transition: transform .55s ease;
        }

        .rq-mm-add:hover {
            transform: translateY(-3px);
            box-shadow: 0 24px 45px rgba(75,56,50,.27);
        }

            .rq-mm-add:hover::before {
                transform: translateX(170px) scale(1.3);
            }

    .rq-mm-add-icon {
        position: relative;
        z-index: 1;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(255,255,255,.14);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: Georgia,serif;
        font-size: 25px;
        font-weight: 400;
        transition: transform .35s ease;
    }

    .rq-mm-add:hover .rq-mm-add-icon {
        transform: rotate(90deg);
    }

    .rq-mm-add-text {
        position: relative;
        z-index: 1;
    }

    /* =========================================================
                   STATS
                   ========================================================= */

    .rq-mm-stats {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 15px;
        margin-bottom: 28px;
        animation: rqMmReveal .75s .08s cubic-bezier(.2,.8,.2,1) both;
    }

    .rq-mm-stat {
        position: relative;
        min-height: 108px;
        padding: 21px 22px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.90);
        border-radius: 27px;
        background: rgba(255,253,247,.67);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        box-shadow: 0 14px 38px rgba(75,56,50,.07);
        transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    }

        .rq-mm-stat:hover {
            transform: translateY(-5px);
            border-color: rgba(185,138,82,.28);
            box-shadow: 0 22px 44px rgba(75,56,50,.11);
        }

        .rq-mm-stat::after {
            content: "";
            position: absolute;
            width: 95px;
            height: 95px;
            right: -32px;
            top: -34px;
            border-radius: 50%;
            background: rgba(220,199,170,.25);
        }

    .rq-mm-stat-label {
        position: relative;
        z-index: 1;
        margin-bottom: 7px;
        color: var(--rq-muted);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 2.2px;
        text-transform: uppercase;
    }

    .rq-mm-stat-value {
        position: relative;
        z-index: 1;
        color: var(--rq-espresso);
        font-family: Georgia,serif;
        font-size: 32px;
        line-height: 1;
        font-weight: 600;
        transition: transform .25s ease;
    }

        .rq-mm-stat-value.bump {
            animation: rqMmNumberBump .35s ease;
        }

    @@keyframes rqMmNumberBump {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.18);
        }

        100% {
            transform: scale(1);
        }
    }

    .rq-mm-stat-note {
        position: relative;
        z-index: 1;
        margin-top: 7px;
        color: #a08a78;
        font-size: 10px;
    }

    /* =========================================================
                   ALERT
                   ========================================================= */

    .rq-mm-alert {
        position: relative;
        margin-bottom: 18px;
        padding: 16px 19px;
        border: 1px solid rgba(111,78,55,.12);
        border-radius: 19px;
        background: rgba(255,253,247,.82);
        box-shadow: 0 12px 30px rgba(75,56,50,.07);
        font-size: 13px;
        animation: rqMmReveal .45s ease both;
    }

    .rq-mm-alert-success {
        border-left: 4px solid var(--rq-green);
    }

    .rq-mm-alert-error {
        border-left: 4px solid var(--rq-red);
    }

    /* =========================================================
                   EMPTY
                   ========================================================= */

    .rq-mm-empty {
        position: relative;
        padding: 75px 25px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.92);
        border-radius: 34px;
        background: rgba(255,253,247,.72);
        text-align: center;
        box-shadow: var(--rq-shadow);
        backdrop-filter: blur(14px);
        animation: rqMmReveal .7s ease both;
    }

    .rq-mm-empty-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 22px;
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--rq-espresso);
        color: var(--rq-cream);
        font-size: 27px;
        box-shadow: 0 14px 30px rgba(75,56,50,.18);
    }

    .rq-mm-empty h3 {
        margin: 0 0 9px;
        color: var(--rq-espresso);
        font-family: Georgia,serif;
        font-size: 26px;
    }

    .rq-mm-empty p {
        max-width: 430px;
        margin: 0 auto 24px;
        color: var(--rq-muted);
        font-size: 13px;
        line-height: 1.7;
    }

    /* =========================================================
                   TABLE
                   ========================================================= */

    .rq-mm-table-card {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.92);
        border-radius: 34px;
        background: rgba(255,253,247,.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow: var(--rq-shadow);
        animation: rqMmReveal .8s .12s cubic-bezier(.2,.8,.2,1) both;
    }

    .rq-mm-table-head {
        padding: 25px 29px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 1px solid var(--rq-border);
    }

    .rq-mm-table-title {
        color: var(--rq-espresso);
        font-family: Georgia,serif;
        font-size: 24px;
    }

    .rq-mm-table-count {
        padding: 8px 12px;
        border: 1px solid rgba(111,78,55,.10);
        border-radius: 999px;
        background: rgba(220,199,170,.18);
        color: var(--rq-muted);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 2px;
        white-space: nowrap;
    }

    .rq-mm-table-scroll {
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(111,78,55,.28) transparent;
    }

    .rq-mm-table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
    }

        .rq-mm-table thead {
            background: rgba(220,199,170,.18);
        }

        .rq-mm-table th {
            padding: 17px 20px;
            text-align: left;
            color: #927b68;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 2.6px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .rq-mm-table td {
            padding: 18px 20px;
            border-top: 1px solid rgba(111,78,55,.075);
            vertical-align: middle;
        }

        .rq-mm-table tbody tr {
            transition: background .25s ease, opacity .25s ease;
        }

            .rq-mm-table tbody tr:hover {
                background: rgba(220,199,170,.10);
            }

    /* =========================================================
                   ITEM IMAGE
                   ========================================================= */

    .rq-mm-image {
        width: 66px;
        height: 66px;
        display: block;
        object-fit: cover;
        border: 1px solid rgba(111,78,55,.12);
        border-radius: 18px;
        background: var(--rq-cream);
        box-shadow: 0 8px 20px rgba(75,56,50,.10);
        transition: transform .35s ease;
    }

    .rq-mm-table tbody tr:hover .rq-mm-image {
        transform: scale(1.05) rotate(-1deg);
    }

    .rq-mm-image-placeholder {
        width: 66px;
        height: 66px;
        border: 1px dashed rgba(111,78,55,.18);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: var(--rq-cream);
        color: #9c8774;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* =========================================================
                   DETAILS
                   ========================================================= */

    .rq-mm-item-name {
        color: var(--rq-espresso);
        font-family: Georgia,serif;
        font-size: 18px;
        font-weight: 600;
        transition: color .25s ease;
    }

    .rq-mm-item-description {
        max-width: 300px;
        margin-top: 5px;
        color: #988472;
        font-size: 11px;
        line-height: 1.5;
    }

    .rq-mm-category {
        display: inline-flex;
        padding: 7px 11px;
        border: 1px solid rgba(111,78,55,.10);
        border-radius: 999px;
        background: rgba(220,199,170,.17);
        color: #765b47;
        font-size: 10px;
        white-space: nowrap;
    }

    .rq-mm-price {
        color: var(--rq-coffee);
        font-family: Georgia,serif;
        font-size: 17px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* =========================================================
                   AVAILABILITY TOGGLE
                   ========================================================= */

    .rq-mm-availability-form {
        display: inline-block;
        margin: 0;
        padding: 0;
    }

    .rq-mm-availability {
        position: relative;
        width: 126px;
        height: 46px;
        padding: 4px;
        border: 1px solid rgba(111,78,55,.14);
        border-radius: 999px;
        display: flex;
        align-items: center;
        cursor: pointer;
        overflow: hidden;
        font-family: inherit;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 1px;
        transition: background .3s ease, border-color .3s ease, box-shadow .3s ease, transform .2s ease;
    }

        .rq-mm-availability:hover {
            transform: translateY(-2px);
        }

        .rq-mm-availability:active {
            transform: scale(.96);
        }

        .rq-mm-availability:disabled {
            cursor: wait;
            opacity: .7;
        }

    .rq-mm-availability-slider {
        position: absolute;
        top: 4px;
        left: 4px;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: white;
        box-shadow: 0 3px 10px rgba(0,0,0,.17);
        transition: transform .32s cubic-bezier(.2,.8,.2,1), box-shadow .25s ease;
    }

    .rq-mm-availability-text {
        position: absolute;
        top: 0;
        bottom: 0;
        display: flex;
        align-items: center;
        pointer-events: none;
        transition: opacity .25s ease, transform .25s ease;
    }

    .rq-mm-availability-text-on {
        right: 15px;
        color: #58752f;
    }

    .rq-mm-availability-text-off {
        left: 15px;
        color: #8f7565;
    }

    /* ON */

    .rq-mm-availability.on {
        background: var(--rq-green-light);
        border-color: rgba(111,150,63,.35);
        box-shadow: 0 8px 20px rgba(111,150,63,.12);
    }

        .rq-mm-availability.on .rq-mm-availability-slider {
            transform: translateX(80px);
            background: var(--rq-green);
            box-shadow: 0 4px 12px rgba(111,150,63,.28);
        }

        .rq-mm-availability.on .rq-mm-availability-text-on {
            opacity: 1;
            transform: translateX(0);
        }

        .rq-mm-availability.on .rq-mm-availability-text-off {
            opacity: 0;
            transform: translateX(-8px);
        }

    /* OFF */

    .rq-mm-availability.off {
        background: rgba(167,91,80,.08);
        border-color: rgba(167,91,80,.22);
        box-shadow: 0 8px 20px rgba(75,56,50,.06);
    }

        .rq-mm-availability.off .rq-mm-availability-slider {
            transform: translateX(0);
            background: #9b8878;
        }

        .rq-mm-availability.off .rq-mm-availability-text-on {
            opacity: 0;
            transform: translateX(8px);
        }

        .rq-mm-availability.off .rq-mm-availability-text-off {
            opacity: 1;
            transform: translateX(0);
        }

    /* Loading */

    .rq-mm-availability.loading .rq-mm-availability-slider {
        animation: rqMmPulse .8s ease-in-out infinite;
    }

    @@keyframes rqMmPulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: .55;
            transform: scale(.85);
        }
    }

    /* =========================================================
                   ROW STATUS
                   ========================================================= */

    .rq-mm-table tbody tr.item-unavailable {
        opacity: .72;
    }

        .rq-mm-table tbody tr.item-unavailable:hover {
            opacity: 1;
        }

        .rq-mm-table tbody tr.item-unavailable .rq-mm-item-name {
            color: #806f64;
        }

    /* =========================================================
                   ACTIONS
                   ========================================================= */

    .rq-mm-actions {
        display: flex;
        justify-content: flex-end;
        gap: 7px;
    }

    .rq-mm-action {
        min-height: 38px;
        padding: 0 15px;
        border: 1px solid rgba(111,78,55,.15);
        border-radius: 999px;
        background: rgba(255,253,247,.73);
        color: var(--rq-coffee);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        text-decoration: none !important;
        font-family: inherit;
        font-size: 10px;
        font-weight: 700;
        transition: background .25s ease, color .25s ease, transform .25s ease, box-shadow .25s ease;
    }

        .rq-mm-action:hover {
            transform: translateY(-2px);
            background: var(--rq-espresso);
            border-color: var(--rq-espresso);
            color: white !important;
            box-shadow: 0 8px 18px rgba(75,56,50,.15);
        }

    .rq-mm-action-delete:hover {
        background: var(--rq-red);
        border-color: var(--rq-red);
    }

    /* =========================================================
                   MOBILE
                   ========================================================= */

    .rq-mm-mobile-list {
        display: none;
    }

    .rq-mm-mobile-card {
        position: relative;
        margin-bottom: 14px;
        padding: 17px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.92);
        border-radius: 26px;
        background: rgba(255,253,247,.78);
        box-shadow: 0 14px 35px rgba(75,56,50,.08);
        backdrop-filter: blur(13px);
        transition: opacity .3s ease, transform .3s ease;
    }

        .rq-mm-mobile-card.item-unavailable {
            opacity: .72;
        }

            .rq-mm-mobile-card.item-unavailable:hover {
                opacity: 1;
            }

    .rq-mm-mobile-top {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .rq-mm-mobile-image {
        width: 72px;
        height: 72px;
        flex-shrink: 0;
        object-fit: cover;
        border-radius: 19px;
        border: 1px solid rgba(111,78,55,.10);
    }

    .rq-mm-mobile-info {
        min-width: 0;
        flex: 1;
    }

    .rq-mm-mobile-name {
        margin: 0 0 7px;
        color: var(--rq-espresso);
        font-family: Georgia,serif;
        font-size: 20px;
        line-height: 1.1;
    }

    .rq-mm-mobile-category {
        color: #917b68;
        font-size: 10px;
        letter-spacing: .5px;
    }

    .rq-mm-mobile-description {
        margin: 15px 0;
        color: var(--rq-muted);
        font-size: 12px;
        line-height: 1.6;
    }

    .rq-mm-mobile-meta {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 14px;
        padding-top: 15px;
        border-top: 1px solid rgba(111,78,55,.09);
    }

    .rq-mm-mobile-price {
        margin-bottom: 11px;
        color: var(--rq-coffee);
        font-family: Georgia,serif;
        font-size: 20px;
    }

    .rq-mm-mobile-actions {
        display: flex;
        gap: 7px;
    }

    /* =========================================================
                   BOTTOM
                   ========================================================= */

    .rq-mm-bottom-links {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 25px;
        animation: rqMmReveal .8s .18s ease both;
    }

    .rq-mm-secondary {
        min-height: 47px;
        padding: 0 19px;
        border: 1px solid rgba(111,78,55,.15);
        border-radius: 999px;
        background: rgba(255,253,247,.60);
        color: var(--rq-coffee);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none !important;
        font-size: 11px;
        font-weight: 700;
        transition: all .25s ease;
    }

        .rq-mm-secondary:hover {
            transform: translateY(-2px);
            background: var(--rq-espresso);
            border-color: var(--rq-espresso);
            color: white !important;
        }

    /* =========================================================
                   ANIMATION
                   ========================================================= */

    @@keyframes rqMmReveal {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
                   TABLET
                   ========================================================= */

    @@media (max-width: 1050px) {

        .rq-mm-hero {
            grid-template-columns: 1fr;
            align-items: start;
            gap: 25px;
        }

        .rq-mm-hero-actions {
            width: 100%;
        }

            .rq-mm-hero-actions .rq-mm-add {
                flex: 1;
                justify-content: center;
            }
    }

    @@media (max-width: 950px) {

        .rq-mm-page {
            padding: 28px 20px 95px;
        }

        .rq-mm-stats {
            grid-template-columns: repeat(3,1fr);
        }

        .rq-mm-title {
            letter-spacing: -3px;
        }
    }

    /* =========================================================
                   MOBILE
                   ========================================================= */

    @@media (max-width: 700px) {

        .rq-mm-page {
            padding: 22px 12px 90px;
        }

        .rq-mm-eyebrow {
            gap: 9px;
            font-size: 8px;
            letter-spacing: 2.5px;
        }

            .rq-mm-eyebrow::before {
                width: 28px;
            }

        .rq-mm-title {
            font-size: clamp(43px,14vw,61px);
            letter-spacing: -2.5px;
        }

        .rq-mm-description {
            margin-top: 15px;
            font-size: 13px;
            line-height: 1.7;
        }

        .rq-mm-hero-actions {
            flex-direction: column;
        }

            .rq-mm-hero-actions .rq-mm-add {
                width: 100%;
            }

        .rq-mm-stats {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .rq-mm-stat:first-child {
            grid-column: 1 / -1;
        }

        .rq-mm-stat {
            min-height: 96px;
            padding: 17px;
        }

        .rq-mm-stat-value {
            font-size: 27px;
        }

        .rq-mm-table-card {
            display: none;
        }

        .rq-mm-mobile-list {
            display: block;
        }

        .rq-mm-mobile-card {
            animation: rqMmReveal .5s ease both;
        }

        .rq-mm-mobile-meta {
            align-items: stretch;
            flex-direction: column;
        }

        .rq-mm-mobile-actions {
            width: 100%;
        }

            .rq-mm-mobile-actions .rq-mm-action {
                flex: 1;
            }

        .rq-mm-availability {
            width: 126px;
        }

        .rq-mm-bottom-links {
            flex-direction: column;
        }

        .rq-mm-secondary {
            width: 100%;
        }
    }

    /* =========================================================
                   SMALL MOBILE
                   ========================================================= */

    @@media (max-width: 430px) {

        .rq-mm-page {
            padding-left: 10px;
            padding-right: 10px;
        }

        .rq-mm-title {
            font-size: 45px;
            letter-spacing: -2px;
        }

        .rq-mm-add {
            min-height: 54px;
        }

        .rq-mm-add-icon {
            width: 40px;
            height: 40px;
        }

        .rq-mm-mobile-top {
            gap: 11px;
        }

        .rq-mm-mobile-image,
        .rq-mm-image-placeholder {
            width: 64px;
            height: 64px;
        }

        .rq-mm-mobile-name {
            font-size: 18px;
        }
    }

    /* =========================================================
                   REDUCED MOTION
                   ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        .rq-mm-page::before,
        .rq-mm-page::after,
        .rq-mm-hero,
        .rq-mm-stats,
        .rq-mm-table-card,
        .rq-mm-mobile-card,
        .rq-mm-bottom-links {
            animation: none !important;
        }

        .rq-mm-add,
        .rq-mm-action,
        .rq-mm-secondary,
        .rq-mm-stat,
        .rq-mm-image,
        .rq-mm-availability,
        .rq-mm-availability-slider,
        .rq-mm-availability-text {
            transition: none !important;
        }
    }
</style>


<div class="rq-mm-page">

    <div class="rq-mm-content">

        <!-- =====================================================
             HERO
             ===================================================== -->

        <section class="rq-mm-hero">

            <div class="rq-mm-hero-content">

                <div class="rq-mm-eyebrow">
                    Restaurant Menu Command Center
                </div>

                <h1 class="rq-mm-title">
                    Menu
                    <span>Management.</span>
                </h1>

                <p class="rq-mm-description">
                    Create, organize and manage everything
                    your guests can discover from your
                    restaurant's digital menu.
                </p>

            </div>


            <div class="rq-mm-hero-actions">

                <a asp-area="Kitchen"
                   asp-controller="MenuItem"
                   asp-action="Create"
                   class="rq-mm-add">

                    <span class="rq-mm-add-icon">
                        +
                    </span>

                    <span class="rq-mm-add-text">
                        Add Menu Item
                    </span>

                </a>




            </div>

        </section>


        <!-- =====================================================
             STATS
             ===================================================== -->

        <section class="rq-mm-stats">

            <div class="rq-mm-stat">

                <div class="rq-mm-stat-label">
                    Total Items
                </div>

                <div class="rq-mm-stat-value"
                     id="totalItemsCount">
                    @totalItems
                </div>

                <div class="rq-mm-stat-note">
                    Items in your digital menu
                </div>

            </div>


            <div class="rq-mm-stat">

                <div class="rq-mm-stat-label">
                    Available
                </div>

                <div class="rq-mm-stat-value"
                     id="availableItemsCount">
                    @availableItems
                </div>

                <div class="rq-mm-stat-note">
                    Currently visible to guests
                </div>

            </div>


            <div class="rq-mm-stat">

                <div class="rq-mm-stat-label">
                    Unavailable
                </div>

                <div class="rq-mm-stat-value"
                     id="unavailableItemsCount">
                    @unavailableItems
                </div>

                <div class="rq-mm-stat-note">
                    Temporarily disabled
                </div>

            </div>

        </section>


        <!-- =====================================================
             ALERTS
             ===================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="rq-mm-alert rq-mm-alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="rq-mm-alert rq-mm-alert-error">
                @TempData["Error"]
            </div>
        }


        <!-- =====================================================
             EMPTY
             ===================================================== -->
        @if (!menuItems.Any())
        {
            <section class="rq-mm-empty">

                <div class="rq-mm-empty-icon">
                    ✦
                </div>

                <h3>
                    No Menu Items Yet
                </h3>

                <p>
                    Start building your restaurant's digital menu
                    by creating the first menu item.
                </p>

                <a asp-area="Kitchen"
                   asp-controller="MenuItem"
                   asp-action="Create"
                   class="rq-mm-add">

                    <span class="rq-mm-add-icon">
                        +
                    </span>

                    <span class="rq-mm-add-text">
                        Create First Item
                    </span>

                </a>

            </section>
        }
        else
        {

            <!-- =================================================
                 DESKTOP TABLE
                 ================================================= -->

            <section class="rq-mm-table-card">

                <div class="rq-mm-table-head">

                    <div class="rq-mm-table-title">
                        Menu Collection
                    </div>

                    <div class="rq-mm-table-count"
                         id="menuItemCount">
                        @totalItems ITEMS
                    </div>

                </div>


                <div class="rq-mm-table-scroll">

                    <table class="rq-mm-table">

                        <thead>

                            <tr>

                                <th>
                                    Image
                                </th>

                                <th>
                                    Menu Item
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Price
                                </th>

                                <th>
                                    Availability
                                </th>

                                <th style="text-align:right;">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in menuItems)
                            {

                                <tr class="@(item.IsAvailable ? "item-available" : "item-unavailable")"
                                    data-menu-item-row="@item.Id">


                                    <!-- IMAGE -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.Name"
                                                 class="rq-mm-image" />
                                        }
                                        else
                                        {
                                            <div class="rq-mm-image-placeholder">
                                                NO IMAGE
                                            </div>
                                        }

                                    </td>


                                    <!-- NAME -->

                                    <td>

                                        <div class="rq-mm-item-name">
                                            @item.Name
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="rq-mm-item-description">
                                                @item.Description
                                            </div>
                                        }

                                    </td>


                                    <!-- CATEGORY -->

                                    <td>

                                        <span class="rq-mm-category">
                                            @(item.Category?.Name ?? "Uncategorized")
                                        </span>

                                    </td>


                                    <!-- PRICE -->

                                    <td>

                                        <span class="rq-mm-price">
                                            ₹ @item.Price.ToString("0.00")
                                        </span>

                                    </td>


                                    <!-- AVAILABILITY -->

                                    <td>

                                        <form asp-area="Kitchen"
                                              asp-controller="MenuItem"
                                              asp-action="ToggleAvailability"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="rq-mm-availability-form js-availability-form">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="rq-mm-availability @(item.IsAvailable ? "on" : "off")"
                                                    data-menu-item-id="@item.Id"
                                                    data-current-state="@item.IsAvailable.ToString().ToLowerInvariant()"
                                                    title="Click to change availability">

                                                <span class="rq-mm-availability-slider">
                                                </span>

                                                <span class="rq-mm-availability-text rq-mm-availability-text-on">
                                                    ON
                                                </span>

                                                <span class="rq-mm-availability-text rq-mm-availability-text-off">
                                                    OFF
                                                </span>

                                            </button>

                                        </form>

                                    </td>


                                    <!-- ACTIONS -->

                                    <td>

                                        <div class="rq-mm-actions">

                                            <a asp-area="Kitchen"
                                               asp-controller="MenuItem"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="rq-mm-action">
                                                Edit
                                            </a>


                                            <form asp-area="Kitchen"
                                                  asp-controller="MenuItem"
                                                  asp-action="Delete"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  style="display:inline;"
                                                  onsubmit="return confirm('Delete this menu item?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="rq-mm-action rq-mm-action-delete">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </section>


            <!-- =================================================
                 MOBILE CARDS
                 ================================================= -->

            <section class="rq-mm-mobile-list">

                @foreach (var item in menuItems)
                {

                    <article class="rq-mm-mobile-card @(item.IsAvailable ? "item-available" : "item-unavailable")"
                             data-menu-item-card="@item.Id">


                        <div class="rq-mm-mobile-top">

                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     alt="@item.Name"
                                     class="rq-mm-mobile-image" />
                            }
                            else
                            {
                                <div class="rq-mm-image-placeholder">
                                    NO IMAGE
                                </div>
                            }


                            <div class="rq-mm-mobile-info">

                                <h3 class="rq-mm-mobile-name">
                                    @item.Name
                                </h3>

                                <div class="rq-mm-mobile-category">
                                    @(item.Category?.Name ?? "Uncategorized")
                                </div>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <div class="rq-mm-mobile-description">
                                @item.Description
                            </div>
                        }


                        <div class="rq-mm-mobile-meta">

                            <div>

                                <div class="rq-mm-mobile-price">
                                    ₹ @item.Price.ToString("0.00")
                                </div>


                                <form asp-area="Kitchen"
                                      asp-controller="MenuItem"
                                      asp-action="ToggleAvailability"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="rq-mm-availability-form js-availability-form">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="rq-mm-availability @(item.IsAvailable ? "on" : "off")"
                                            data-menu-item-id="@item.Id"
                                            data-current-state="@item.IsAvailable.ToString().ToLowerInvariant()"
                                            title="Click to change availability">

                                        <span class="rq-mm-availability-slider">
                                        </span>

                                        <span class="rq-mm-availability-text rq-mm-availability-text-on">
                                            ON
                                        </span>

                                        <span class="rq-mm-availability-text rq-mm-availability-text-off">
                                            OFF
                                        </span>

                                    </button>

                                </form>

                            </div>


                            <div class="rq-mm-mobile-actions">

                                <a asp-area="Kitchen"
                                   asp-controller="MenuItem"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="rq-mm-action">
                                    Edit
                                </a>


                                <form asp-area="Kitchen"
                                      asp-controller="MenuItem"
                                      asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      style="display:flex;"
                                      onsubmit="return confirm('Delete this menu item?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="rq-mm-action rq-mm-action-delete">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    </article>
                }

            </section>

        }


        <!-- =====================================================
             BOTTOM LINKS
             ===================================================== -->

        <div class="rq-mm-bottom-links">

            <a asp-area="Kitchen"
               asp-controller="Dashboard"
               asp-action="Index"
               class="rq-mm-secondary">

                Dashboard

            </a>

        </div>

    </div>

</div>


<!-- =============================================================
     AJAX AVAILABILITY SCRIPT
     ============================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const forms =
            document.querySelectorAll(".js-availability-form");

        forms.forEach(function (form) {

            form.addEventListener("submit", async function (event) {

                event.preventDefault();

                const button =
                    form.querySelector(".rq-mm-availability");

                if (!button) {
                    return;
                }

                if (button.disabled) {
                    return;
                }

                const itemId =
                    button.dataset.menuItemId;

                const oldState =
                    button.dataset.currentState === "true";

                const newState =
                    !oldState;

                const row =
                    document.querySelector(
                        `[data-menu-item-row="${itemId}"]`
                    );

                const card =
                    document.querySelector(
                        `[data-menu-item-card="${itemId}"]`
                    );

                const token =
                    form.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    );

                if (!token) {
                    console.error(
                        "Anti-forgery token not found."
                    );

                    return;
                }

                /* -------------------------------------------------
                   DISABLE BUTTON WHILE REQUEST IS RUNNING
                   ------------------------------------------------- */

                button.disabled = true;
                button.classList.add("loading");

                /* -------------------------------------------------
                   UPDATE UI IMMEDIATELY
                   ------------------------------------------------- */

                setAvailabilityUI(
                    button,
                    newState
                );

                updateItemVisualState(
                    row,
                    card,
                    newState
                );

                updateStatistics(
                    oldState,
                    newState
                );

                try {

                    const response =
                        await fetch(
                            form.action,
                            {
                                method: "POST",

                                headers: {
                                    "X-Requested-With":
                                        "XMLHttpRequest",

                                    "RequestVerificationToken":
                                        token.value
                                },

                                body:
                                    new URLSearchParams({
                                        "__RequestVerificationToken":
                                            token.value
                                    })
                            }
                        );


                    if (!response.ok) {
                        throw new Error(
                            "Server returned " +
                            response.status
                        );
                    }


                    const data =
                        await response.json();


                    if (!data.success) {
                        throw new Error(
                            "Toggle operation failed."
                        );
                    }


                    /* ---------------------------------------------
                       SERVER CONFIRMED THE NEW STATE
                       --------------------------------------------- */

                    const confirmedState =
                        data.isAvailable === true;

                    button.dataset.currentState =
                        confirmedState
                            ? "true"
                            : "false";

                    setAvailabilityUI(
                        button,
                        confirmedState
                    );

                    updateItemVisualState(
                        row,
                        card,
                        confirmedState
                    );


                }
                catch (error) {

                    console.error(
                        "Availability toggle error:",
                        error
                    );


                    /* ---------------------------------------------
                       ROLLBACK UI IF SERVER REQUEST FAILED
                       --------------------------------------------- */

                    setAvailabilityUI(
                        button,
                        oldState
                    );

                    updateItemVisualState(
                        row,
                        card,
                        oldState
                    );

                    updateStatistics(
                        newState,
                        oldState
                    );


                    showToggleError(
                        "Could not update availability. Please try again."
                    );

                }
                finally {

                    button.disabled = false;

                    button.classList.remove("loading");

                }

            });

        });


        /* =========================================================
           SET TOGGLE UI
           ========================================================= */

        function setAvailabilityUI(
            button,
            isAvailable
        ) {

            button.classList.toggle(
                "on",
                isAvailable
            );

            button.classList.toggle(
                "off",
                !isAvailable
            );

            button.dataset.currentState =
                isAvailable
                    ? "true"
                    : "false";

            button.setAttribute(
                "aria-label",
                isAvailable
                    ? "Currently available. Click to make unavailable."
                    : "Currently unavailable. Click to make available."
            );

            button.title =
                isAvailable
                    ? "Available — click to make unavailable"
                    : "Unavailable — click to make available";

        }


        /* =========================================================
           ROW / CARD VISUAL STATE
           ========================================================= */

        function updateItemVisualState(
            row,
            card,
            isAvailable
        ) {

            if (row) {

                row.classList.toggle(
                    "item-available",
                    isAvailable
                );

                row.classList.toggle(
                    "item-unavailable",
                    !isAvailable
                );

            }


            if (card) {

                card.classList.toggle(
                    "item-available",
                    isAvailable
                );

                card.classList.toggle(
                    "item-unavailable",
                    !isAvailable
                );

            }

        }


        /* =========================================================
           UPDATE STATISTICS
           ========================================================= */

        function updateStatistics(
            oldState,
            newState
        ) {

            if (oldState === newState) {
                return;
            }

            const availableElement =
                document.getElementById(
                    "availableItemsCount"
                );

            const unavailableElement =
                document.getElementById(
                    "unavailableItemsCount"
                );


            if (!availableElement ||
                !unavailableElement) {

                return;
            }


            let available =
                parseInt(
                    availableElement.textContent,
                    10
                ) || 0;


            let unavailable =
                parseInt(
                    unavailableElement.textContent,
                    10
                ) || 0;


            if (oldState === true &&
                newState === false) {

                available--;
                unavailable++;

            }
            else if (oldState === false &&
                     newState === true) {

                available++;
                unavailable--;

            }


            available =
                Math.max(
                    0,
                    available
                );

            unavailable =
                Math.max(
                    0,
                    unavailable
                );


            availableElement.textContent =
                available;

            unavailableElement.textContent =
                unavailable;


            animateNumber(
                availableElement
            );

            animateNumber(
                unavailableElement
            );

        }


        /* =========================================================
           NUMBER ANIMATION
           ========================================================= */

        function animateNumber(
            element
        ) {

            element.classList.remove(
                "bump"
            );

            void element.offsetWidth;

            element.classList.add(
                "bump"
            );

        }


        /* =========================================================
           ERROR MESSAGE
           ========================================================= */

        function showToggleError(
            message
        ) {

            const existing =
                document.querySelector(
                    ".rq-mm-toggle-error"
                );

            if (existing) {
                existing.remove();
            }


            const alert =
                document.createElement("div");

            alert.className =
                "rq-mm-alert rq-mm-alert-error rq-mm-toggle-error";

            alert.textContent =
                message;


            const tableCard =
                document.querySelector(
                    ".rq-mm-table-card"
                );

            const mobileList =
                document.querySelector(
                    ".rq-mm-mobile-list"
                );


            if (tableCard &&
                tableCard.parentNode) {

                tableCard.parentNode.insertBefore(
                    alert,
                    tableCard
                );

            }
            else if (mobileList &&
                     mobileList.parentNode) {

                mobileList.parentNode.insertBefore(
                    alert,
                    mobileList
                );

            }


            setTimeout(
                function () {

                    if (alert &&
                        alert.parentNode) {

                        alert.remove();

                    }

                },
                3500
            );

        }

    });

</script>