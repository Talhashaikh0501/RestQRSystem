                            </span>
>>>>>>> Stashed changes

                        </div>

                    </div>



                    <!-- =====================================
                         STATUS
                         ===================================== -->

                    <div class="status-row">

                        <span class="status-pill">

                            <span class="status-dot"></span>

                            @order.Status

                        </span>

                    </div>



                    <!-- =====================================
                         ITEMS
                         ===================================== -->

                    <div class="items-list">

                        @foreach (var item in order.Items)
                        {

                            <div class="order-item">

                                <span class="item-name">
                                    @item.Name
                                </span>

                                <span class="item-quantity">
                                    × @item.Quantity
                                </span>

                            </div>

                        }

                    </div>



                    <!-- =====================================
                         CUSTOMER NOTE
                         ===================================== -->
                    @if (!string.IsNullOrWhiteSpace(
                                order.CustomerNote))
                    {

                        <div class="customer-note">

                            <div class="note-title">
                                Customer Note
                            </div>

                            <div class="note-text">
                                @order.CustomerNote
                            </div>

                        </div>

                    }



                    <!-- =====================================
                         FOOTER
                         ===================================== -->

                    <div class="order-bottom">

                        <div class="order-time">

                            <span>
                                ORDERED AT
                            </span>

                            <span class="time-value">

                                @order.CreatedAt
                                .ToLocalTime()
                                .ToString("hh:mm tt")

                            </span>

                        </div>



                        <!-- =================================
                             STATUS ACTION
                             ================================= -->
                        @if (order.Status == "Pending")
                        {

                            <form asp-action="UpdateStatus"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@order.Id" />

                                <input type="hidden"
                                       name="status"
                                       value="Accepted" />

                                <button type="submit"
                                        class="order-action">

                                    Accept Order

                                    <span class="action-arrow">
