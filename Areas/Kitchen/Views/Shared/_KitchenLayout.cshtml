@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var isDashboard =
        currentController.Equals("Dashboard", StringComparison.OrdinalIgnoreCase);

    var userName =
        User.FindFirst("FullName")?.Value
        ?? User.Identity?.Name
        ?? "Kitchen Staff";

    var initials = string.Join(
        "",
        userName
            .Split(
                new[] { ' ', '.', '_', '-' },
                StringSplitOptions.RemoveEmptyEntries
            )
            .Take(2)
            .Select(x => x[0])
    ).ToUpperInvariant();

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "KS";
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - RestaurantQR Kitchen
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>

        :root {
            --rq-white: #FFFDF7;
            --rq-cream: #F5E6CA;
            --rq-beige: #DCC7AA;
            --rq-coffee: #6F4E37;
            --rq-espresso: #4B3832;
            --rq-deep: #352822;
            --rq-gold: #B8894D;
            --rq-muted: #8B7565;
            --rq-green: #91A760;
            --rq-line: rgba(111,78,55,.14);
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100%;
            min-height: 100%;
            overflow-x: hidden;
            background: var(--rq-cream) !important;
            color: var(--rq-espresso);
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
        }

        /* =========================================================
                   MAIN PAGE
                   ========================================================= */

        .kitchen-shell {
            position: relative;
            width: 100%;
            min-height: 100vh;
            overflow-x: hidden;
            background: radial-gradient( circle at 8% 10%, rgba(255,255,255,.95), transparent 28% ), radial-gradient( circle at 92% 12%, rgba(220,199,170,.60), transparent 32% ), linear-gradient( 135deg, #FFFDF7 0%, #F5E6CA 52%, #EBD8B9 100% );
        }

            .kitchen-shell::before {
                content: "";
                position: fixed;
                width: 430px;
                height: 430px;
                left: -220px;
                top: 180px;
                border-radius: 50%;
                background: rgba(111,78,55,.04);
                pointer-events: none;
            }

            .kitchen-shell::after {
                content: "";
                position: fixed;
                width: 520px;
                height: 520px;
                right: -270px;
                bottom: -260px;
                border-radius: 50%;
                background: rgba(184,137,77,.07);
                pointer-events: none;
            }

        /* =========================================================
                   NAVBAR
                   ========================================================= */

        .kitchen-header {
            position: fixed;
            z-index: 2000;
            top: 18px;
            left: 50%;
            transform: translateX(-50%);
            width: min( 1180px, calc(100% - 44px) );
            height: 82px;
            background: rgba(255,253,247,.92);
            border: 1px solid rgba(255,255,255,.95);
            border-radius: 44px;
            box-shadow: 0 18px 50px rgba(75,56,50,.13), inset 0 1px 0 rgba(255,255,255,.95);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            transition: top .3s ease, height .3s ease, box-shadow .3s ease;
        }

            .kitchen-header.scrolled {
                top: 10px;
                height: 72px;
                box-shadow: 0 18px 52px rgba(75,56,50,.18), inset 0 1px 0 rgba(255,255,255,.95);
            }

        /* =========================================================
                   MENU BUTTON
                   ========================================================= */

        .kitchen-menu-button {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            width: 54px;
            height: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 5px;
            padding: 0;
            border: 0;
            border-radius: 50%;
            background: var(--rq-espresso);
            cursor: pointer;
            box-shadow: 0 12px 28px rgba(75,56,50,.21);
            transition: transform .25s ease, box-shadow .25s ease;
        }

            .kitchen-menu-button:hover {
                transform: translateY(-50%) scale(1.035);
                box-shadow: 0 16px 34px rgba(75,56,50,.26);
            }

            .kitchen-menu-button span {
                width: 21px;
                height: 2px;
                border-radius: 10px;
                background: var(--rq-white);
                transition: transform .25s ease, opacity .25s ease;
            }

            .kitchen-menu-button.active span:nth-child(1) {
                transform: translateY(7px) rotate(45deg);
            }

            .kitchen-menu-button.active span:nth-child(2) {
                opacity: 0;
            }

            .kitchen-menu-button.active span:nth-child(3) {
                transform: translateY(-7px) rotate(-45deg);
            }

        /* =========================================================
                   CENTER BRAND
                   ========================================================= */

        .kitchen-brand {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            width: max-content;
            text-align: center;
            text-decoration: none;
            white-space: nowrap;
            z-index: 5;
        }

            .kitchen-brand:hover {
                transform: translate(-50%, -50%);
                text-decoration: none;
            }

        .kitchen-brand-main {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 27px;
            font-weight: 700;
            letter-spacing: -.9px;
            color: var(--rq-espresso);
        }

            .kitchen-brand-main span {
                color: var(--rq-gold);
                font-style: italic;
            }

        .kitchen-brand-sub {
            display: block;
            margin-top: 6px;
            font-size: 7px;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: rgba(75,56,50,.48);
        }

        /* =========================================================
                   RIGHT STATUS / USER
                   ========================================================= */

        .kitchen-user-area {
            position: absolute;
            right: 17px;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .kitchen-live {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 42px;
            padding: 0 15px;
            border-radius: 24px;
            background: rgba(145,167,96,.13);
            color: #647544;
            font-size: 10px;
            font-weight: 700;
        }

        .kitchen-live-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--rq-green);
            box-shadow: 0 0 0 6px rgba(145,167,96,.12);
            animation: kitchenPulse 1.8s ease-in-out infinite;
        }

        .kitchen-user-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            min-height: 52px;
            padding: 5px 16px 5px 5px;
            border-radius: 30px;
            background: var(--rq-espresso);
            color: var(--rq-white);
            box-shadow: 0 9px 24px rgba(75,56,50,.18);
        }

        .kitchen-avatar {
            width: 42px;
            height: 42px;
            flex: 0 0 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--rq-cream);
            color: var(--rq-espresso);
            font-family: Georgia, serif;
            font-size: 13px;
            font-weight: 700;
        }

        .kitchen-user-copy {
            display: flex;
            flex-direction: column;
        }

            .kitchen-user-copy small {
                margin-bottom: 4px;
                font-size: 7px;
                letter-spacing: 2px;
                text-transform: uppercase;
                color: rgba(255,253,247,.60);
            }

            .kitchen-user-copy strong {
                max-width: 130px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                font-family: Georgia, serif;
                font-size: 12px;
                color: var(--rq-white);
            }

        /* =========================================================
                   OVERLAY
                   ========================================================= */

        .kitchen-overlay {
            position: fixed;
            inset: 0;
            z-index: 3000;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            background: rgba(53,40,34,.25);
            backdrop-filter: blur(11px);
            -webkit-backdrop-filter: blur(11px);
            transition: opacity .3s ease, visibility .3s ease;
        }

            .kitchen-overlay.open {
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
            }

        /* =========================================================
                   SIDE MENU
                   ========================================================= */

        .kitchen-menu {
            position: fixed;
            z-index: 3100;
            top: 22px;
            left: 22px;
            width: 320px;
            max-width: calc(100vw - 44px);
            padding: 26px 20px 20px;
            border: 1px solid rgba(255,255,255,.97);
            border-radius: 28px;
            background: rgba(255,253,247,.97);
            box-shadow: 0 30px 80px rgba(53,40,34,.25), inset 0 1px 0 rgba(255,255,255,.96);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            transform: translateX( calc(-100% - 50px) );
            opacity: 0;
            visibility: hidden;
            transition: transform .38s cubic-bezier(.22,.61,.36,1), opacity .28s ease, visibility .28s ease;
        }

            .kitchen-menu.open {
                transform: translateX(0);
                opacity: 1;
                visibility: visible;
            }

        .kitchen-menu-heading {
            padding: 0 11px;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: rgba(111,78,55,.60);
        }

        .kitchen-menu-divider {
            width: 100%;
            height: 1px;
            margin: 16px 0 10px;
            background: var(--rq-line);
        }

        .kitchen-menu-link,
        .kitchen-logout {
            width: 100%;
            min-height: 58px;
            display: grid;
            grid-template-columns: 42px 1fr 24px;
            align-items: center;
            gap: 10px;
            padding: 7px 12px;
            margin: 5px 0;
            border-radius: 18px;
            text-decoration: none;
            color: var(--rq-espresso);
            transition: .25s ease;
        }

            .kitchen-menu-link:hover {
                color: var(--rq-espresso);
                background: rgba(220,199,170,.30);
                transform: translateX(3px);
            }

            .kitchen-menu-link.active {
                color: var(--rq-white);
                background: var(--rq-espresso);
                box-shadow: 0 12px 26px rgba(75,56,50,.18);
            }

        .kitchen-menu-icon {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: rgba(220,199,170,.39);
            color: var(--rq-coffee);
        }

        .kitchen-menu-link.active
        .kitchen-menu-icon {
            background: rgba(255,253,247,.16);
            color: var(--rq-white);
        }

        .kitchen-menu-name {
            font-size: 13px;
            font-weight: 700;
        }

        .kitchen-menu-arrow {
            text-align: right;
            font-size: 18px;
            opacity: .55;
        }

        .kitchen-menu form {
            margin: 0;
        }

        .kitchen-logout {
            border: 0;
            cursor: pointer;
            text-align: left;
            background: rgba(220,199,170,.22);
        }

            .kitchen-logout:hover {
                color: var(--rq-white);
                background: var(--rq-espresso);
                transform: translateX(3px);
            }

                .kitchen-logout:hover
                .kitchen-menu-icon {
                    color: var(--rq-white);
                    background: rgba(255,255,255,.14);
                }

        /* =========================================================
                   CONTENT
                   ========================================================= */

        .kitchen-content {
            position: relative;
            z-index: 1;
            width: 100%;
            min-height: 100vh;
            padding-top: 125px;
            padding-bottom: 105px;
        }

        /* =========================================================
                   FOOTER
                   ========================================================= */

        .kitchen-footer {
            position: fixed;
            z-index: 1500;
            left: 50%;
            bottom: 16px;
            transform: translateX(-50%);
            width: min( 1180px, calc(100% - 44px) );
            min-height: 62px;
            padding: 0 28px;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            border-radius: 34px;
            color: var(--rq-white);
            background: var(--rq-espresso);
            box-shadow: 0 18px 45px rgba(75,56,50,.22);
        }

        .kitchen-footer-brand {
            font-family: Georgia, serif;
            font-size: 15px;
            font-weight: 700;
        }

            .kitchen-footer-brand span {
                color: var(--rq-gold);
                font-style: italic;
            }

        .kitchen-footer-center {
            font-size: 8px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: rgba(255,253,247,.62);
        }

        .kitchen-footer-status {
            justify-self: end;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 10px;
            color: rgba(255,253,247,.78);
        }

        /* =========================================================
                   ANIMATION
                   ========================================================= */

        @@keyframes kitchenPulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: .45;
            }
        }

        /* =========================================================
                   TABLET
                   ========================================================= */

        @@media (max-width: 900px) {

            .kitchen-header {
                width: calc(100% - 28px);
                top: 12px;
                height: 74px;
            }

            .kitchen-menu-button {
                left: 11px;
                width: 50px;
                height: 50px;
            }

            .kitchen-brand-main {
                font-size: 22px;
            }

            .kitchen-user-area {
                right: 11px;
            }

            .kitchen-live {
                display: none;
            }

            .kitchen-user-pill {
                max-width: 170px;
                height: 48px;
            }

            .kitchen-avatar {
                width: 38px;
                height: 38px;
                flex-basis: 38px;
            }

            .kitchen-content {
                padding-top: 105px;
            }

            .kitchen-footer {
                width: calc(100% - 28px);
            }
        }

        /* =========================================================
                   MOBILE
                   ========================================================= */

        @@media (max-width: 650px) {

            .kitchen-header {
                top: 9px;
                width: calc(100% - 18px);
                height: 66px;
                border-radius: 34px;
            }

            .kitchen-menu-button {
                left: 7px;
                width: 46px;
                height: 46px;
            }

            .kitchen-brand {
                left: 50% !important;
                transform: translate(-50%, -50%) !important;
            }

            .kitchen-brand-main {
                font-size: 18px;
            }

            .kitchen-brand-sub {
                margin-top: 4px;
                font-size: 5px;
                letter-spacing: 2px;
            }

            .kitchen-user-area {
                right: 7px;
            }

            .kitchen-user-pill {
                width: 44px;
                height: 44px;
                min-width: 44px;
                padding: 3px;
                justify-content: center;
                border-radius: 50%;
            }

            .kitchen-avatar {
                width: 38px;
                height: 38px;
                flex-basis: 38px;
            }

            .kitchen-user-copy {
                display: none;
            }

            .kitchen-menu {
                top: 10px;
                left: 10px;
                width: calc(100vw - 20px);
                max-width: calc(100vw - 20px);
                max-height: calc(100vh - 20px);
                overflow-y: auto;
                border-radius: 24px;
            }

            .kitchen-content {
                padding-top: 90px;
                padding-bottom: 82px;
            }

            .kitchen-footer {
                bottom: 8px;
                width: calc(100% - 18px);
                min-height: 50px;
                padding: 0 14px;
                border-radius: 27px;
            }

            .kitchen-footer-center {
                display: none;
            }

            .kitchen-footer-brand {
                font-size: 12px;
            }

            .kitchen-footer-status {
                font-size: 8px;
            }
        }

    </style>

</head>


<body>

    <div class="kitchen-shell">


        <!-- =========================================================
             NAVBAR
             ========================================================= -->

        <header class="kitchen-header"
                id="kitchenHeader">


            <!-- LEFT MENU -->

            <button type="button"
                    class="kitchen-menu-button"
                    id="kitchenMenuButton"
                    aria-label="Open kitchen menu"
                    aria-expanded="false">

                <span></span>
                <span></span>
                <span></span>

            </button>


            <!-- CENTER BRAND -->

            <a asp-area="Kitchen"
               asp-controller="Dashboard"
               asp-action="Index"
               class="kitchen-brand">

                <div class="kitchen-brand-main">
                    Restaurant<span>QR</span>
                </div>

                <span class="kitchen-brand-sub">
                    Kitchen Command
                </span>

            </a>


            <!-- RIGHT USER -->

            <div class="kitchen-user-area">

                <div class="kitchen-live">

                    <span class="kitchen-live-dot"></span>

                    Live Orders

                </div>


                <div class="kitchen-user-pill">

                    <div class="kitchen-avatar">
                        @initials
                    </div>

                    <div class="kitchen-user-copy">

                        <small>
                            Kitchen Staff
                        </small>

                        <strong title="@userName">
                            @userName
                        </strong>

                    </div>

                </div>

            </div>

        </header>


        <!-- =========================================================
             OVERLAY
             ========================================================= -->

        <div class="kitchen-overlay"
             id="kitchenOverlay">
        </div>


        <!-- =========================================================
             SIDE MENU
             ========================================================= -->

        <aside class="kitchen-menu"
               id="kitchenMenu"
               aria-hidden="true">


            <div class="kitchen-menu-heading">
                Kitchen Command
            </div>


            <div class="kitchen-menu-divider"></div>


            <a asp-area="Kitchen"
               asp-controller="Dashboard"
               asp-action="Index"
               class="kitchen-menu-link @(isDashboard ? "active" : "")">

                <span class="kitchen-menu-icon">
                    ◈
                </span>

                <span class="kitchen-menu-name">
                    Active Orders
                </span>

                <span class="kitchen-menu-arrow">
                    →
                </span>

            </a>


            <div class="kitchen-menu-divider"></div>


            <!-- LOGOUT ONLY INSIDE MENU -->

            <form asp-area=""
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                <button type="submit"
                        class="kitchen-logout">

                    <span class="kitchen-menu-icon">
                        ↪
                    </span>

                    <span class="kitchen-menu-name">
                        Logout
                    </span>

                    <span class="kitchen-menu-arrow">
                        →
                    </span>

                </button>

            </form>

        </aside>


        <!-- =========================================================
             CONTENT
             ========================================================= -->

        <main class="kitchen-content">

            @RenderBody()

        </main>


        <!-- =========================================================
             FOOTER
             ========================================================= -->

        <footer class="kitchen-footer">

            <div class="kitchen-footer-brand">
                Restaurant<span>QR</span>
            </div>

            <div class="kitchen-footer-center">
                Kitchen · Live Operations
            </div>

            <div class="kitchen-footer-status">

                <span class="kitchen-live-dot"></span>

                Live Orders

            </div>

        </footer>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const header =
                    document.getElementById(
                        "kitchenHeader"
                    );

                const button =
                    document.getElementById(
                        "kitchenMenuButton"
                    );

                const menu =
                    document.getElementById(
                        "kitchenMenu"
                    );

                const overlay =
                    document.getElementById(
                        "kitchenOverlay"
                    );


                if (
                    !header ||
                    !button ||
                    !menu ||
                    !overlay
                ) {
                    return;
                }


                function openMenu() {

                    button.classList.add(
                        "active"
                    );

                    menu.classList.add(
                        "open"
                    );

                    overlay.classList.add(
                        "open"
                    );

                    button.setAttribute(
                        "aria-expanded",
                        "true"
                    );

                    menu.setAttribute(
                        "aria-hidden",
                        "false"
                    );

                    document.body.style.overflow =
                        "hidden";

                }


                function closeMenu() {

                    button.classList.remove(
                        "active"
                    );

                    menu.classList.remove(
                        "open"
                    );

                    overlay.classList.remove(
                        "open"
                    );

                    button.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                    menu.setAttribute(
                        "aria-hidden",
                        "true"
                    );

                    document.body.style.overflow =
                        "";

                }


                button.addEventListener(
                    "click",
                    function () {

                        if (
                            menu.classList.contains(
                                "open"
                            )
                        ) {

                            closeMenu();

                        }
                        else {

                            openMenu();

                        }

                    }
                );


                overlay.addEventListener(
                    "click",
                    closeMenu
                );


                document.addEventListener(
                    "keydown",
                    function (event) {

                        if (
                            event.key === "Escape"
                        ) {

                            closeMenu();

                        }

                    }
                );


                document
                    .querySelectorAll(
                        ".kitchen-menu-link"
                    )
                    .forEach(
                        function (link) {

                            link.addEventListener(
                                "click",
                                closeMenu
                            );

                        }
                    );


                window.addEventListener(
                    "scroll",
                    function () {

                        if (
                            window.scrollY > 35
                        ) {

                            header.classList.add(
                                "scrolled"
                            );

                        }
                        else {

                            header.classList.remove(
                                "scrolled"
                            );

                        }

                    },
                    {
                        passive: true
                    }
                );

            }
        );

    </script>


    @await RenderSectionAsync(
    "Scripts",
        required: false
        )

</body>

</html>