        }
    }

    /* =========================================================
       FINAL MENU ANIMATION FIX
       - No excessive zoom
       - Small smooth opening
       - Stays close to navbar
       - Left side menu
       ========================================================= */

    .rq-floating-menu {
        left: 18px !important;
        right: auto !important;
        top: 112px !important;
        width: 300px !important;
        max-width: calc(100vw - 36px);
        transform: translateY(-8px) scale(.985) !important;
        transform-origin: top left !important;
        opacity: 0;
        visibility: hidden;
        transition: opacity .22s ease, visibility .22s ease, transform .22s cubic-bezier(.22,.61,.36,1) !important;
    }

        /* OPEN — only very little zoom */
        .rq-floating-menu.open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1) !important;
        }

    /* Overlay ko bhi soft rakho */
    .rq-menu-overlay {
        background: rgba(53,40,34,.18) !important;
