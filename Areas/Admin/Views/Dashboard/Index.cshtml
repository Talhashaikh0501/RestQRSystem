@model RestaurantQR.Models.ApplicationUser

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>

    /* =========================================================
           RESTAURANT QR — ADMIN DASHBOARD
           PREMIUM CREAM / COFFEE THEME
           ========================================================= */

    :root {
        --cream: #F5E6CA;
        --white: #FFFDF7;
        --beige: #DCC7AA;
        --coffee: #6F4E37;
        --espresso: #4B3832;
        --deep: #352822;
        --gold: #B8894D;
        --muted: #8B7565;
        --line: rgba(111, 78, 55, .16);
        --shadow: 0 20px 55px rgba(75, 56, 50, .12);
    }

    /* =========================================================
           REMOVE OLD ADMIN LAYOUT UI
           ========================================================= */

    body {
        margin: 0 !important;
        padding: 0 !important;
        background: var(--cream) !important;
        color: var(--espresso) !important;
        overflow-x: hidden;
    }

    .admin-sidebar,
    .admin-topbar {
        display: none !important;
    }

    .admin-content-wrapper {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        min-height: 100vh;
    }

    /* =========================================================
           MAIN PAGE
           ========================================================= */

    .rq-admin-page {
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
        background: radial-gradient( circle at 12% 10%, rgba(255,255,255,.95), transparent 28% ), radial-gradient( circle at 92% 12%, rgba(220,199,170,.55), transparent 30% ), linear-gradient( 135deg, #FFFDF7 0%, #F5E6CA 52%, #EBD8B9 100% );
    }

        .rq-admin-page::before {
            content: "";
            position: fixed;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            background: rgba(111, 78, 55, .045);
            top: 8%;
            left: -180px;
            pointer-events: none;
            filter: blur(2px);
        }

        .rq-admin-page::after {
            content: "";
            position: fixed;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: rgba(184, 137, 77, .055);
            bottom: -250px;
            right: -180px;
            pointer-events: none;
        }

    /* =========================================================
           MAIN CONTENT
           ========================================================= */

    .rq-main {
        width: min(1180px, calc(100% - 44px));
        margin: 0 auto;
        padding-top: 70px;
        padding-bottom: 145px;
        position: relative;
        z-index: 2;
    }

    /* =========================================================
           HERO
           ========================================================= */

    .rq-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 270px;
        gap: 40px;
        align-items: end;
        margin-bottom: 78px;
        animation: rqFadeUp .8s ease both;
    }

    .rq-eyebrow {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 22px;
        font-family: Arial, sans-serif;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: var(--coffee);
    }

        .rq-eyebrow::before {
            content: "";
            width: 42px;
            height: 1px;
            background: var(--coffee);
        }

    .rq-hero h1 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(58px, 7vw, 96px);
        line-height: .9;
        font-weight: 400;
        letter-spacing: -4px;
        color: var(--espresso);
    }

        .rq-hero h1 em {
            color: var(--coffee);
            font-style: italic;
        }

    .rq-hero-description {
        max-width: 690px;
        margin: 28px 0 0;
        font-family: Arial, sans-serif;
        font-size: 15px;
        line-height: 1.8;
        color: var(--muted);
    }

        .rq-hero-description strong {
            color: var(--coffee);
        }

    /* =========================================================
           ADMIN STATUS CARD
           ========================================================= */

    .rq-status-card {
        min-height: 128px;
        padding: 24px 25px;
        border-radius: 28px;
        background: rgba(255,253,247,.68);
        border: 1px solid rgba(255,255,255,.9);
        box-shadow: var(--shadow);
        display: flex;
        flex-direction: column;
        justify-content: center;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        animation: rqFadeUp .8s .12s ease both;
    }

    .rq-status-label {
        font-family: Arial, sans-serif;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 3px;
        color: rgba(111,78,55,.58);
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .rq-status-name {
        font-family: Georgia, serif;
        font-size: 23px;
        color: var(--espresso);
        margin-bottom: 12px;
    }

    .rq-status-online {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: Arial, sans-serif;
        font-size: 11px;
        color: var(--coffee);
    }

    .rq-online-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #9BA96A;
        box-shadow: 0 0 0 5px rgba(155,169,106,.13);
    }

    /* =========================================================
           SECTION HEADER
           ========================================================= */

    .rq-section-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 26px;
        animation: rqFadeUp .8s .18s ease both;
    }

    .rq-section-title {
        margin: 0;
        font-family: Georgia, serif;
        font-size: 40px;
        font-weight: 400;
        color: var(--espresso);
        letter-spacing: -1px;
    }

    .rq-section-label {
        font-family: Arial, sans-serif;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 3px;
        color: rgba(111,78,55,.48);
        text-transform: uppercase;
    }

    /* =========================================================
           CARD GRID
           ========================================================= */

    .rq-card-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    /* =========================================================
           CARDS
           ========================================================= */

    .rq-card {
        position: relative;
        min-height: 285px;
        padding: 30px;
        overflow: hidden;
        border-radius: 30px;
        background: radial-gradient( circle at 100% 0%, rgba(220,199,170,.32), transparent 25% ), rgba(255,253,247,.84);
        border: 1px solid rgba(255,255,255,.95);
        box-shadow: 0 18px 45px rgba(75,56,50,.09), inset 0 1px 0 rgba(255,255,255,.95);
        display: flex;
        flex-direction: column;
        transition: transform .4s cubic-bezier(.2,.8,.2,1), box-shadow .4s ease;
    }

        .rq-card::after {
            content: "";
            position: absolute;
            width: 170px;
            height: 170px;
            border-radius: 50%;
            right: -80px;
            top: -80px;
            background: rgba(220,199,170,.23);
            pointer-events: none;
        }

        .rq-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 28px 65px rgba(75,56,50,.15), inset 0 1px 0 rgba(255,255,255,.95);
        }

    .rq-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .rq-card-number {
        font-family: Arial, sans-serif;
        font-size: 9px;
        letter-spacing: 3px;
        color: rgba(111,78,55,.46);
    }

    .rq-card-icon {
        position: relative;
        z-index: 2;
        width: 58px;
        height: 58px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--coffee);
        color: var(--white);
        box-shadow: 0 12px 24px rgba(75,56,50,.17);
        font-size: 22px;
        transition: transform .35s ease;
    }

    .rq-card:hover .rq-card-icon {
        transform: rotate(-5deg) scale(1.06);
    }

    .rq-card h3 {
        margin: 40px 0 10px;
        font-family: Georgia, serif;
        font-size: 31px;
        font-weight: 400;
        letter-spacing: -.7px;
        color: var(--espresso);
    }

    .rq-card p {
        max-width: 540px;
        margin: 0;
        font-family: Arial, sans-serif;
        font-size: 13px;
        line-height: 1.7;
        color: var(--muted);
    }

    .rq-card-bottom {
        margin-top: auto;
        padding-top: 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid var(--line);
    }

    .rq-card-meta {
        font-family: Arial, sans-serif;
        font-size: 8px;
        letter-spacing: 2px;
        color: rgba(111,78,55,.5);
        text-transform: uppercase;
    }

    /* =========================================================
           MANAGE BUTTON
           ========================================================= */

    .rq-manage-button {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 10px 10px 17px;
        border-radius: 30px;
        background: var(--espresso);
        color: var(--white);
        text-decoration: none;
        font-family: Arial, sans-serif;
        font-size: 11px;
        font-weight: 700;
        transition: transform .3s ease, background .3s ease;
    }

        .rq-manage-button:hover {
            color: var(--white);
            background: var(--coffee);
            transform: translateX(3px);
        }

    .rq-manage-arrow {
        width: 29px;
        height: 29px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255,255,255,.12);
        font-size: 14px;
    }

    /* =========================================================
           FOOTER
           ========================================================= */

    .rq-footer {
        position: fixed;
        z-index: 900;
        left: 50%;
        bottom: 14px;
        transform: translateX(-50%);
        width: min(1180px, calc(100% - 44px));
        min-height: 58px;
        padding: 0 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-radius: 30px;
        background: rgba(75,56,50,.96);
        color: var(--cream);
        box-shadow: 0 15px 40px rgba(53,40,34,.2), inset 0 1px 0 rgba(255,255,255,.08);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
    }

    .rq-footer-brand {
        font-family: Georgia, serif;
        font-size: 13px;
    }

        .rq-footer-brand span {
            color: #D2A565;
            font-style: italic;
        }

    .rq-footer-copy {
        font-family: Arial, sans-serif;
        font-size: 9px;
        letter-spacing: 1px;
        color: rgba(245,230,202,.65);
    }

    .rq-footer-status {
        display: flex;
        align-items: center;
        gap: 7px;
        font-family: Arial, sans-serif;
        font-size: 9px;
        color: rgba(245,230,202,.72);
    }

    .rq-footer-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #A4AE78;
    }

    /* =========================================================
           ANIMATIONS
           ========================================================= */

    @@keyframes rqFadeUp {

        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .rq-card {
        animation: rqFadeUp .75s ease both;
    }

        .rq-card:nth-child(1) {
            animation-delay: .22s;
        }

        .rq-card:nth-child(2) {
            animation-delay: .30s;
        }

        .rq-card:nth-child(3) {
            animation-delay: .38s;
        }

        .rq-card:nth-child(4) {
            animation-delay: .46s;
        }

    /* =========================================================
           TABLET
           ========================================================= */

    @@media (max-width: 991px) {

        .rq-main {
            width: calc(100% - 30px);
            padding-top: 55px;
            padding-bottom: 130px;
        }

        .rq-hero {
            grid-template-columns: 1fr;
            gap: 25px;
            margin-bottom: 55px;
        }

        .rq-status-card {
            max-width: 320px;
        }

        .rq-card-grid {
            grid-template-columns: 1fr 1fr;
        }

        .rq-footer {
            width: calc(100% - 30px);
        }
    }

    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 700px) {

        .rq-main {
            width: calc(100% - 24px);
            padding-top: 45px;
            padding-bottom: 118px;
        }

        .rq-hero {
            margin-bottom: 48px;
        }

        .rq-eyebrow {
            font-size: 8px;
            letter-spacing: 3px;
            gap: 10px;
            margin-bottom: 18px;
        }

            .rq-eyebrow::before {
                width: 28px;
            }

        .rq-hero h1 {
            font-size: clamp(52px, 16vw, 75px);
            letter-spacing: -3px;
            line-height: .91;
        }

        .rq-hero-description {
            font-size: 13px;
            line-height: 1.7;
            margin-top: 22px;
        }

        .rq-status-card {
            max-width: none;
            min-height: 105px;
            padding: 20px;
            border-radius: 24px;
        }

        .rq-status-name {
            font-size: 21px;
        }

        .rq-section-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 18px;
        }

        .rq-section-title {
            font-size: 34px;
        }

        .rq-card-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .rq-card {
            min-height: 270px;
            padding: 24px;
            border-radius: 26px;
        }

            .rq-card h3 {
                margin-top: 32px;
                font-size: 27px;
            }

            .rq-card p {
                font-size: 12px;
            }

        .rq-card-bottom {
            padding-top: 20px;
        }

        .rq-footer {
            width: calc(100% - 20px);
            bottom: 8px;
            min-height: 52px;
            padding: 0 16px;
            border-radius: 27px;
        }

        .rq-footer-brand {
            font-size: 11px;
        }

        .rq-footer-copy {
            display: none;
        }

        .rq-footer-status {
            font-size: 8px;
        }
    }

    /* =========================================================
           SMALL MOBILE
           ========================================================= */

    @@media (max-width: 430px) {

        .rq-main {
            padding-top: 38px;
        }

        .rq-hero h1 {
            font-size: 51px;
        }

        .rq-card {
            min-height: 255px;
        }

        .rq-card-icon {
            width: 50px;
            height: 50px;
            border-radius: 15px;
        }

        .rq-card h3 {
            font-size: 25px;
        }
    }

</style>


<div class="rq-admin-page">

    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main class="rq-main">

        <!-- =================================================
             HERO
             ================================================= -->

        <section class="rq-hero">

            <div>

                <div class="rq-eyebrow">
                    Restaurant Command Center
                </div>

                <h1>
                    Welcome <em>Back.</em>
                </h1>

                <p class="rq-hero-description">

                    Everything your restaurant needs,
                    beautifully organized in one place.

                    Good to see you,

                    <strong>
                        @(Model?.FullName ?? "Administrator")
                    </strong>.

                </p>

            </div>


            <!-- =================================================
                 STATUS CARD
                 ================================================= -->

            <div class="rq-status-card">

                <div class="rq-status-label">
                    Administrator
                </div>

                <div class="rq-status-name">

                    @(Model?.FullName ?? "Administrator")

                </div>

                <div class="rq-status-online">

                    <span class="rq-online-dot"></span>

                    System Online

                </div>

            </div>

        </section>


        <!-- =================================================
             MANAGEMENT
             ================================================= -->

        <section>

            <div class="rq-section-header">

                <h2 class="rq-section-title">
                    Management
                </h2>

                <div class="rq-section-label">
                    Restaurant Operations
                </div>

            </div>


            <!-- =================================================
                 CARDS
                 ================================================= -->

            <div class="rq-card-grid">


                <!-- =================================================
                     MENU MANAGEMENT
                     ================================================= -->

                <article class="rq-card">

                    <div class="rq-card-top">

                        <span class="rq-card-number">
                            01
                        </span>

                        <div class="rq-card-icon">
                            ✦
                        </div>

                    </div>

                    <h3>
                        Menu Management
                    </h3>

                    <p>

                        Manage categories, dishes, pricing
                        and availability for your restaurant's
                        digital menu.

                    </p>

                    <div class="rq-card-bottom">

                        <span class="rq-card-meta">
                            Dishes · Categories · Pricing
                        </span>

                        <a asp-area="Admin"
                           asp-controller="MenuItem"
                           asp-action="Index"
                           class="rq-manage-button">

                            Manage

                            <span class="rq-manage-arrow">
                                →
                            </span>

                        </a>

                    </div>

                </article>


                <!-- =================================================
                     TABLES & QR
                     ================================================= -->

                <article class="rq-card">

                    <div class="rq-card-top">

                        <span class="rq-card-number">
                            02
                        </span>

                        <div class="rq-card-icon">
                            ▦
                        </div>

                    </div>

                    <h3>
                        Tables & QR
                    </h3>

                    <p>

                        Manage restaurant tables and control
                        the QR-powered dining experience
                        for every guest.

                    </p>

                    <div class="rq-card-bottom">

                        <span class="rq-card-meta">
                            Tables · QR · Dining
                        </span>

                        <a asp-area="Admin"
                           asp-controller="Table"
                           asp-action="Index"
                           class="rq-manage-button">

                            Manage

                            <span class="rq-manage-arrow">
                                →
                            </span>

                        </a>

                    </div>

                </article>


                <!-- =================================================
                     ORDERS
                     ================================================= -->

                <article class="rq-card">

                    <div class="rq-card-top">

                        <span class="rq-card-number">
                            03
                        </span>

                        <div class="rq-card-icon">
                            ◇
                        </div>

                    </div>

                    <h3>
                        Orders
                    </h3>

                    <p>

                        Monitor customer orders and keep track
                        of the complete restaurant ordering flow.

                    </p>

                    <div class="rq-card-bottom">

                        <span class="rq-card-meta">
                            Live Orders · Tracking
                        </span>

                        <a asp-area="Admin"
                           asp-controller="Order"
                           asp-action="Index"
                           class="rq-manage-button">

                            View Orders

                            <span class="rq-manage-arrow">
                                →
                            </span>

                        </a>

                    </div>

                </article>


                <!-- =================================================
                     KITCHEN STAFF
                     ================================================= -->

                <article class="rq-card">

                    <div class="rq-card-top">

                        <span class="rq-card-number">
                            04
                        </span>

                        <div class="rq-card-icon">
                            ♙
                        </div>

                    </div>

                    <h3>
                        Kitchen Staff
                    </h3>

                    <p>

                        Create and manage kitchen staff accounts
                        and keep restaurant operations organized.

                    </p>

                    <div class="rq-card-bottom">

                        <span class="rq-card-meta">
                            Staff · Access · Kitchen
                        </span>

                        <a asp-area="Admin"
                           asp-controller="Staff"
                           asp-action="Index"
                           class="rq-manage-button">

                            Manage Staff

                            <span class="rq-manage-arrow">
                                →
                            </span>

                        </a>

                    </div>

                </article>


            </div>

        </section>

    </main>


    <!-- =====================================================
         FIXED FOOTER
         ===================================================== -->

    <footer class="rq-footer">

        <div class="rq-footer-brand">

            Restaurant<span>QR</span>

        </div>

        <div class="rq-footer-copy">

            Smart Dining · Simplified

        </div>

        <div class="rq-footer-status">

            <span class="rq-footer-status-dot"></span>

            System Online

        </div>

    </footer>

</div>