@model RestaurantQR.ViewModels.RestaurantTableViewModel

@{
    ViewData["Title"] = "Create Table";
}

<h1 style="font-family:'Fraunces',serif; margin-bottom:10px;">
    Create Table
</h1>

<p style="color:#A39C90; margin-bottom:50px;">
    Add a new table to your restaurant.
</p>

<form asp-action="Create" method="post" style="max-width:600px;">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

    <div class="mb-4">
        <input asp-for="TableNumber"
               class="form-input-premium"
               placeholder="Table Number" />
    </div>

    <div class="mb-5">
        <input asp-for="Capacity"
               class="form-input-premium"
               placeholder="Capacity" />
    </div>

    <div class="d-flex gap-3">
        <a asp-action="Index" class="btn-ghost">Back</a>
        <button type="submit" class="btn-gold">
            Create Table
        </button>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}