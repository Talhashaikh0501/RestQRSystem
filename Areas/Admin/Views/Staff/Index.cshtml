@model IEnumerable<RestaurantQR.Models.ApplicationUser>

@{
    ViewData["Title"] = "Kitchen Staff";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>
            <h1>Kitchen Staff</h1>

            <p class="text-muted mb-0">
                Manage kitchen accounts for your restaurant.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Staff"
           asp-action="Create"
           class="btn btn-primary">
            Add Kitchen User
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No kitchen users have been created yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <table class="table table-hover mb-0">

                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                @user.FullName
                            </td>

                            <td>
                                @user.Email
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <div class="mt-4">

        <a asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Dashboard
        </a>

    </div>

</div>