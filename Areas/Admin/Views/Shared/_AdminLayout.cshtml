@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var isDashboard =
        currentController.Equals("Dashboard", StringComparison.OrdinalIgnoreCase);

    var isMenu =
        currentController.Equals("MenuItem", StringComparison.OrdinalIgnoreCase);

    var isTable =
        currentController.Equals("Table", StringComparison.OrdinalIgnoreCase);

    var isOrder =
        currentController.Equals("Order", StringComparison.OrdinalIgnoreCase);

    var isStaff =
        currentController.Equals("Staff", StringComparison.OrdinalIgnoreCase);

    var adminName =
        User.FindFirst("FullName")?.Value
        ?? User.Identity?.Name
        ?? "Administrator";

    var initials = string.Join(
        "",
        adminName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(x => x[0])
    ).ToUpperInvariant();

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "AD";
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - RestaurantQR
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/premium-theme.css"
          asp-append-version="true" />

    <style>

        :root {
            --rq-cream: #F5E6CA;
            --rq-white: #FFFDF7;
            --rq-beige: #DCC7AA;
            --rq-coffee: #6F4E37;
            --rq-espresso: #4B3832;
            --rq-deep: #352822;
            --rq-gold: #B8894D;
            --rq-muted: #8B7565;
            --rq-line: rgba(111, 78, 55, .16);
        }

        html,
        body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100%;
            min-height: 100%;
            background: var(--rq-cream) !important;
            color: var(--rq-espresso);
            overflow-x: hidden;
        }

        /* OLD NAVBAR / SIDEBAR COMPLETELY HIDDEN */

        .admin-sidebar,
        .admin-topbar,
        .admin-brand,
        .admin-link,
        .admin-user,
        .navbar:not(.rq-header) {
            display: none !important;
        }

        .admin-content-wrapper {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            min-height: 100vh;
        }

        /* PAGE */

        .rq-admin-page {
            position: relative;
            width: 100%;
            min-height: 100vh;
            overflow-x: hidden;
            background: radial-gradient( circle at 10% 10%, rgba(255,255,255,.96), transparent 27% ), radial-gradient( circle at 92% 15%, rgba(220,199,170,.62), transparent 31% ), linear-gradient( 135deg, #FFFDF7 0%, #F5E6CA 52%, #EBD8B9 100% );
        }

        /* ================= NAVBAR ================= */

        .rq-header {
            position: fixed;
            z-index: 2000;
            top: 18px;
            left: 50%;
            transform: translateX(-50%);
            width: min(1180px, calc(100% - 44px));
            height: 82px;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            padding: 0 18px;
            background: rgba(255,253,247,.92);
            border: 1px solid rgba(255,255,255,.95);
            border-radius: 44px;
            box-shadow: 0 18px 50px rgba(75,56,50,.13), inset 0 1px 0 rgba(255,255,255,.95);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
        }

        /* CENTER RESTAURANT QR */

        /* ================= CENTER RESTAURANT QR ================= */

.rq-brand {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);

    display: block;
    width: max-content;

    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    user-select: none;

    z-index: 20;
}

.rq-brand:hover {
    transform: translate(-50%, -50%);
}

.rq-brand-main {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 25px;
    font-weight: 700;
    letter-spacing: -.8px;
    line-height: 1;
    color: var(--rq-espresso);
}

.rq-brand-main span {
    color: var(--rq-gold);
    font-style: italic;
}

.rq-brand-sub {
    display: block;
    margin-top: 6px;
    font-family: Arial, sans-serif;
    font-size: 7px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(75,56,50,.55);
}

        /* ADMIN RIGHT */

        .rq-admin-area {
            grid-column: 3;
            justify-self: end;
            display: flex;
            align-items: center;
        }

        .rq-admin-pill {
            min-height: 48px;
            padding: 5px 17px 5px 6px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-radius: 30px;
            background: var(--rq-espresso);
            color: var(--rq-white);
            box-shadow: 0 8px 22px rgba(75,56,50,.18), inset 0 1px 0 rgba(255,255,255,.12);
        }

        .rq-admin-avatar {
            width: 38px;
            height: 38px;
            flex: 0 0 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--rq-cream);
            color: var(--rq-espresso);
            font-family: Georgia, serif;
            font-size: 13px;
            font-weight: 700;
        }

        .rq-admin-text {
            display: flex;
            flex-direction: column;
            line-height: 1.1;
        }

        .rq-admin-label {
            font-family: Arial, sans-serif;
            font-size: 7px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,253,247,.58);
            margin-bottom: 4px;
        }

        .rq-admin-name {
            font-family: Georgia, serif;
            font-size: 13px;
            color: var(--rq-white);
            max-width: 150px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* ================= MENU BUTTON ================= */

        .rq-menu-button {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            width: 54px;
            height: 54px;
            border: 0;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 5px;
            background: var(--rq-espresso);
            cursor: pointer;
            box-shadow: 0 12px 28px rgba(75,56,50,.20);
            z-index: 10;
        }

            .rq-menu-button:hover {
                transform: translateY(-50%) scale(1.035);
            }

            .rq-menu-button span {
                width: 21px;
                height: 2px;
                border-radius: 10px;
                background: var(--rq-white);
                transition: .25s ease;
            }

            .rq-menu-button.active span:nth-child(1) {
                transform: translateY(7px) rotate(45deg);
            }

            .rq-menu-button.active span:nth-child(2) {
                opacity: 0;
            }

            .rq-menu-button.active span:nth-child(3) {
                transform: translateY(-7px) rotate(-45deg);
            }

        /* ================= OVERLAY ================= */

        .rq-menu-overlay {
            position: fixed;
            inset: 0;
            z-index: 3000;
            background: rgba(53,40,34,.24);
            backdrop-filter: blur(13px);
            -webkit-backdrop-filter: blur(13px);
            opacity: 0;
            visibility: hidden;
            transition: opacity .3s ease, visibility .3s ease;
        }

            .rq-menu-overlay.open {
                opacity: 1;
                visibility: visible;
            }

        /* ================= SLIDE MENU ================= */

        .rq-floating-menu {
            position: fixed;
            z-index: 3100;
            top: 24px;
            left: 24px;
            width: 320px;
            max-width: calc(100vw - 48px);
            padding: 26px 20px 20px;
            background: rgba(255,253,247,.97);
            border: 1px solid rgba(255,255,255,.95);
            border-radius: 28px;
            box-shadow: 0 28px 70px rgba(75,56,50,.25), inset 0 1px 0 rgba(255,255,255,.95);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            transform: translateX(calc(-100% - 40px));
            opacity: 0;
            visibility: hidden;
            transition: transform .4s cubic-bezier(.22,.61,.36,1), opacity .3s ease, visibility .3s ease;
        }

            .rq-floating-menu.open {
                transform: translateX(0);
                opacity: 1;
                visibility: visible;
            }

        .rq-menu-heading {
            padding: 0 12px;
            font-family: Arial, sans-serif;
            font-size: 9px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: rgba(111,78,55,.58);
        }

        .rq-menu-divider {
            width: 100%;
            height: 1px;
            margin: 16px 0 10px;
            background: var(--rq-line);
        }

        .rq-menu-link,
        .rq-menu-logout {
            width: 100%;
            min-height: 58px;
            display: grid;
            grid-template-columns: 42px 1fr 24px;
            align-items: center;
            gap: 10px;
            padding: 7px 12px;
            margin: 5px 0;
            border-radius: 18px;
            text-decoration: none;
            color: var(--rq-espresso);
            background: transparent;
            transition: .25s ease;
        }

            .rq-menu-link:hover {
                background: rgba(220,199,170,.30);
                transform: translateX(3px);
            }

            .rq-menu-link.active {
                color: var(--rq-white);
                background: var(--rq-espresso);
                box-shadow: 0 12px 26px rgba(75,56,50,.18);
            }

        .rq-menu-icon {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: rgba(220,199,170,.38);
            color: var(--rq-coffee);
            font-size: 15px;
        }

        .rq-menu-link.active .rq-menu-icon {
            background: rgba(255,253,247,.16);
            color: var(--rq-white);
        }

        .rq-menu-name {
            font-family: Arial, sans-serif;
            font-size: 13px;
            font-weight: 600;
        }

        .rq-menu-arrow {
            text-align: right;
            font-size: 18px;
            opacity: .55;
        }

        .rq-floating-menu form {
            margin: 0;
        }

        .rq-menu-logout {
            border: 0;
            background: rgba(220,199,170,.22);
            cursor: pointer;
            text-align: left;
        }

            .rq-menu-logout:hover {
                background: var(--rq-espresso);
                color: var(--rq-white);
            }

        /* ================= CONTENT ================= */

        .rq-main {
            position: relative;
            z-index: 1;
            width: 100%;
            min-height: 100vh;
            padding-top: 145px;
            padding-bottom: 100px;
        }

        /* ================= FOOTER ================= */

        .rq-footer {
            position: fixed;
            z-index: 1500;
            left: 50%;
            bottom: 16px;
            transform: translateX(-50%);
            width: min(1180px, calc(100% - 44px));
            min-height: 62px;
            padding: 0 28px;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            background: var(--rq-espresso);
            color: var(--rq-white);
            border-radius: 34px;
            box-shadow: 0 18px 45px rgba(75,56,50,.22);
        }

        .rq-footer-brand {
            font-family: Georgia, serif;
            font-size: 15px;
            font-weight: 700;
        }

            .rq-footer-brand span {
                color: var(--rq-gold);
                font-style: italic;
            }

        .rq-footer-copy {
            font-family: Arial, sans-serif;
            font-size: 8px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: rgba(255,253,247,.62);
        }

        .rq-footer-status {
            justify-self: end;
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: Arial, sans-serif;
            font-size: 10px;
            color: rgba(255,253,247,.78);
        }

        .rq-footer-status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #A8B86A;
            box-shadow: 0 0 0 6px rgba(168,184,106,.12);
        }

        /* ================= MOBILE ================= */

        @@media (max-width: 650px) {

            .rq-header {
                width: calc(100% - 20px);
                height: 68px;
            }

            .rq-brand-main {
                font-size: 19px;
            }

            .rq-brand-sub {
                font-size: 5px;
                letter-spacing: 2.5px;
            }

            .rq-menu-button {
                left: 7px;
                width: 46px;
                height: 46px;
            }

            .rq-admin-pill {
                width: 43px;
                height: 43px;
                min-height: 43px;
                padding: 3px;
                justify-content: center;
                border-radius: 50%;
            }

            .rq-admin-avatar {
                width: 37px;
                height: 37px;
                flex-basis: 37px;
            }

            .rq-admin-text {
                display: none;
            }

            .rq-floating-menu {
                top: 12px;
                left: 10px;
                width: calc(100vw - 20px);
                max-width: calc(100vw - 20px);
                padding: 22px 14px 15px;
                border-radius: 24px;
            }

            .rq-main {
                padding-top: 105px;
                padding-bottom: 85px;
            }

            .rq-footer {
                bottom: 10px;
                width: calc(100% - 20px);
                min-height: 52px;
                padding: 0 15px;
            }

            .rq-footer-copy {
                display: none;
            }
        }

    </style>

</head>

<body>

    <div class="rq-admin-page">

        <!-- ONLY ONE NAVBAR -->

        <header class="rq-header" id="rqHeader">

            <!-- LEFT MENU BUTTON -->

            <button type="button"
                    class="rq-menu-button"
                    id="rqMenuButton"
                    aria-label="Open admin menu"
                    aria-expanded="false">

                <span></span>
                <span></span>
                <span></span>

            </button>

            <!-- CENTER RESTAURANT QR -->

            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="rq-brand">

                <div class="rq-brand-main">
                    Restaurant<span>QR</span>
                </div>

                <span class="rq-brand-sub">
                    Smart Dining
                </span>

            </a>

            <!-- RIGHT ADMIN -->

            <div class="rq-admin-area">

                <div class="rq-admin-pill">

                    <div class="rq-admin-avatar">
                        @initials
                    </div>

                    <div class="rq-admin-text">

                        <span class="rq-admin-label">
                            Administrator
                        </span>

                        <span class="rq-admin-name">
                            @adminName
                        </span>

                    </div>

                </div>

            </div>

        </header>

        <!-- MENU OVERLAY -->

        <div class="rq-menu-overlay"
             id="rqMenuOverlay">
        </div>

        <!-- SLIDE MENU -->

        <aside class="rq-floating-menu"
               id="rqFloatingMenu"
               aria-hidden="true">

            <div class="rq-menu-heading">
                Restaurant Command
            </div>

            <div class="rq-menu-divider"></div>

            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="rq-menu-link @(isDashboard ? "active" : "")">

                <span class="rq-menu-icon">◈</span>

                <span class="rq-menu-name">
                    Dashboard
                </span>

                <span class="rq-menu-arrow">→</span>

            </a>

            <a asp-area="Admin"
               asp-controller="MenuItem"
               asp-action="Index"
               class="rq-menu-link @(isMenu ? "active" : "")">

                <span class="rq-menu-icon">✦</span>

                <span class="rq-menu-name">
                    Menu Management
                </span>

                <span class="rq-menu-arrow">→</span>

            </a>

            <a asp-area="Admin"
               asp-controller="Table"
               asp-action="Index"
               class="rq-menu-link @(isTable ? "active" : "")">

                <span class="rq-menu-icon">▦</span>

                <span class="rq-menu-name">
                    Tables & QR
                </span>

                <span class="rq-menu-arrow">→</span>

            </a>

            <a asp-area="Admin"
               asp-controller="Order"
               asp-action="Index"
               class="rq-menu-link @(isOrder ? "active" : "")">

                <span class="rq-menu-icon">◇</span>

                <span class="rq-menu-name">
                    Orders
                </span>

                <span class="rq-menu-arrow">→</span>

            </a>

            <a asp-area="Admin"
               asp-controller="Staff"
               asp-action="Index"
               class="rq-menu-link @(isStaff ? "active" : "")">

                <span class="rq-menu-icon">♙</span>

                <span class="rq-menu-name">
                    Kitchen Staff
                </span>

                <span class="rq-menu-arrow">→</span>

            </a>

            <div class="rq-menu-divider"></div>

            <!-- LOGOUT ONLY HERE -->

            <form asp-area=""
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                <button type="submit"
                        class="rq-menu-logout">

                    <span class="rq-menu-icon">
                        ↪
                    </span>

                    <span class="rq-menu-name">
                        Logout
                    </span>

                    <span class="rq-menu-arrow">
                        →
                    </span>

                </button>

            </form>

        </aside>

        <!-- PAGE CONTENT -->

        <main class="rq-main">

            @RenderBody()

        </main>

        <!-- FOOTER -->

        <footer class="rq-footer">

            <div class="rq-footer-brand">
                Restaurant<span>QR</span>
            </div>

            <div class="rq-footer-copy">
                Smart Dining · Simplified
            </div>

            <div class="rq-footer-status">

                <span class="rq-footer-status-dot"></span>

                System Online

            </div>

        </footer>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const menuButton =
                document.getElementById("rqMenuButton");

            const menu =
                document.getElementById("rqFloatingMenu");

            const overlay =
                document.getElementById("rqMenuOverlay");

            if (!menuButton || !menu || !overlay) {
                return;
            }

            function openMenu() {

                menuButton.classList.add("active");

                menu.classList.add("open");

                overlay.classList.add("open");

                menuButton.setAttribute(
                    "aria-expanded",
                    "true"
                );

                menu.setAttribute(
                    "aria-hidden",
                    "false"
                );

                document.body.style.overflow = "hidden";
            }

            function closeMenu() {

                menuButton.classList.remove("active");

                menu.classList.remove("open");

                overlay.classList.remove("open");

                menuButton.setAttribute(
                    "aria-expanded",
                    "false"
                );

                menu.setAttribute(
                    "aria-hidden",
                    "true"
                );

                document.body.style.overflow = "";
            }

            menuButton.addEventListener(
                "click",
                function () {

                    if (menu.classList.contains("open")) {
                        closeMenu();
                    }
                    else {
                        openMenu();
                    }

                }
            );

            overlay.addEventListener(
                "click",
                closeMenu
            );

            document.addEventListener(
                "keydown",
                function (event) {

                    if (event.key === "Escape") {
                        closeMenu();
                    }

                }
            );

            document
                .querySelectorAll(".rq-menu-link")
                .forEach(function (link) {

                    link.addEventListener(
                        "click",
                        closeMenu
                    );

                });

        });

    </script>

    @await RenderSectionAsync(
    "Scripts",
        required: false
        )

</body>

</html>