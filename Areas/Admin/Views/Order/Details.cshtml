        <div>

            <div class="order-card">

                <div class="order-card-header">

                    <div class="order-card-heading">

                        <div class="order-card-icon">
                            ◇
                        </div>

                        <div>

                            <h2 class="order-card-title">
                                Order Information
                            </h2>

                            <div class="order-card-subtitle">
                                Details & current status
                            </div>

                        </div>

                    </div>

                </div>


                <div class="order-info-body">


                    <!-- TABLE -->

                    <div class="info-block">

                        <div class="info-label">
                            Table
                        </div>

                        <div class="info-value">
                            Table @Model.TableNumber
                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="info-block">

                        <div class="info-label">
                            Order Status
                        </div>

                        <div>

                            <span class="order-status">

                                <span class="order-status-dot">
                                </span>

                                @Model.Status

                            </span>

                        </div>

                    </div>


                    <!-- CREATED -->

                    <div class="info-block">

                        <div class="info-label">
                            Created
                        </div>

                        <div class="info-date">

                            @(Model.CreatedAt
                                                        .ToLocalTime()
                                                        .ToString("dd MMM yyyy"))

                            <br />

                            @(Model.CreatedAt
                                                        .ToLocalTime()
                                                        .ToString("hh:mm tt"))

                        </div>

                    </div>


                    <!-- CUSTOMER NOTE -->
                    @if (!string.IsNullOrWhiteSpace(Model.CustomerNote))
                    {

                        <div class="customer-note">

                            <div class="customer-note-title">

                                <span>
                                    ✦
                                </span>

                                Customer Note

                            </div>


                            <div class="customer-note-text">

                                @Model.CustomerNote

                            </div>

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>

</div>