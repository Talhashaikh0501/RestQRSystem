        border-radius: 27px;
    }

    }


    @@edia (max-width: 390px) {
        .rq-brand-main

    {
        font-size: 18px;
    }

    .rq-menu-trigger {
        width: 50px;
        height: 50px;
    }

    .rq-admin-avatar {
        width: 40px;
        height: 40px;
    }

    .rq-page-heading h1 {
        font-size: 45px;
    }

    .rq-mobile-actions .rq-action {
        padding: 0 11px;
    }

    }
</style>


<!-- =========================================================
     PAGE
     ========================================================= -->

<div class="rq-menu-page" id="rqMenuPage">


    <!-- =====================================================
         NAVBAR
         ===================================================== -->

    


    <!-- =====================================================
         CONTENT
         ===================================================== -->

    <div class="rq-content">


        <!-- PAGE HEADING -->

        <div class="rq-page-heading">

            <div>

                <div class="rq-eyebrow">
                    RESTAURANT MENU COMMAND CENTER
                </div>

                <h1>
                    Menu
                    <em>Management.</em>
                </h1>

                <p class="rq-page-description">
                    Create, organize and manage everything
                    your guests can discover from your
                    restaurant's digital menu.
                </p>

            </div>


            <!-- ADD MENU ITEM -->

            <a asp-area="Admin"
               asp-controller="MenuItem"
               asp-action="Create"
               class="rq-primary-btn">

                <span>+</span>

                Add Menu Item

            </a>

        </div>



        <!-- =================================================
             ALERTS
             ================================================= -->
        @if (TempData["Success"] != null)
        {
            <div class="rq-alert success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="rq-alert error">
                @TempData["Error"]
            </div>
        }



        @if (Model == null || !Model.Any())
        {

            <!-- =================================================
                 EMPTY
                 ================================================= -->

            <div class="rq-empty">

                <div class="rq-empty-icon">
                    ✦
                </div>

                <h3>
                    No Menu Items Yet
                </h3>

                <p>
                    Start building your digital menu
                    by adding your first menu item.
                </p>

                <br />

                <a asp-area="Admin"
                   asp-controller="MenuItem"
                   asp-action="Create"
                   class="rq-primary-btn">

                    <span>+</span>

                    Create First Item

                </a>

            </div>

        }
        else
        {

            <!-- =================================================
                 DESKTOP TABLE
                 ================================================= -->

            <div class="rq-table-card">

                <div class="rq-table-top">

                    <div class="rq-table-title">
                        Menu Collection
                    </div>

                    <div class="rq-table-count">
                        @Model.Count() ITEMS
                    </div>

                </div>


                <div class="rq-table-scroll">

                    <table class="rq-table">

                        <thead>

                            <tr>

                                <th>
                                    Image
                                </th>

                                <th>
                                    Menu Item
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Price
                                </th>

                                <th>
                                    Status
                                </th>

                                <th style="text-align:right;">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {

                                <tr>

                                    <!-- IMAGE -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.Name"
                                                 class="rq-table-image" />
                                        }
                                        else
                                        {
                                            <div class="rq-image-placeholder">
                                                NO IMAGE
                                            </div>
                                        }

                                    </td>


                                    <!-- NAME -->

                                    <td>

                                        <div class="rq-item-name">
                                            @item.Name
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="rq-description">
                                                @item.Description
                                            </div>
                                        }

                                    </td>


                                    <!-- CATEGORY -->

                                    <td>

                                        <span class="rq-category">
                                            @item.Category.Name
                                        </span>

                                    </td>


                                    <!-- PRICE -->

                                    <td>

                                        <span class="rq-price">
                                            ₹ @item.Price.ToString("0.00")
                                        </span>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (item.IsAvailable)
                                        {
                                            <span class="rq-status available">
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="rq-status unavailable">
                                                Unavailable
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->

                                    <td>

                                        <div class="rq-actions">

                                            <a asp-area="Admin"
                                               asp-controller="MenuItem"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="rq-action">

                                                Edit

                                            </a>


                                            <form asp-area="Admin"
                                                  asp-controller="MenuItem"
                                                  asp-action="Delete"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  style="display:inline;"
                                                  onsubmit="return confirm('Delete this menu item?');">

                                                <button type="submit"
                                                        class="rq-action delete">

                                                    Delete

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            </div>



            <!-- =================================================
                 MOBILE LIST
                 ================================================= -->

            <div class="rq-mobile-list">

                @foreach (var item in Model)
                {

                    <div class="rq-mobile-item">


                        <div class="rq-mobile-top">


                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     alt="@item.Name"
                                     class="rq-mobile-image" />
                            }
                            else
                            {
                                <div class="rq-image-placeholder">
                                    NO IMAGE
                                </div>
                            }


                            <div class="rq-mobile-info">

                                <h3>
                                    @item.Name
                                </h3>

                                <div class="rq-mobile-category">
                                    @item.Category.Name
                                </div>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <div class="rq-mobile-description">
                                @item.Description
                            </div>
                        }


                        <div class="rq-mobile-meta">

                            <div>

                                <div class="rq-mobile-price">
                                    ₹ @item.Price.ToString("0.00")
                                </div>

                                <br />

                                @if (item.IsAvailable)
                                {
                                    <span class="rq-status available">
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="rq-status unavailable">
                                        Unavailable
                                    </span>
                                }

                            </div>


                            <div class="rq-mobile-actions">

                                <a asp-area="Admin"
                                   asp-controller="MenuItem"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="rq-action">

                                    Edit

                                </a>


                                <form asp-area="Admin"
                                      asp-controller="MenuItem"
                                      asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Delete this menu item?');">

                                    <button type="submit"
                                            class="rq-action delete">

                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                }

            </div>

        }


        <!-- =================================================
             BOTTOM NAVIGATION
             ================================================= -->

        <div class="rq-bottom-links">

            <a asp-area="Admin"
               asp-controller="Category"
               asp-action="Index"
               class="rq-secondary-btn">

                ← Categories

            </a>


            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="rq-secondary-btn">

                Dashboard

            </a>

        </div>

    </div>



    <!-- =====================================================
         FLOATING FOOTER
         ===================================================== -->

    <div class="rq-floating-footer">

        <div class="rq-footer-brand">
            Restaurant<span>QR</span>
        </div>

        <div class="rq-footer-center">
            SMART DINING · SIMPLIFIED
        </div>

        <div class="rq-footer-status">

            <span class="rq-online-dot"></span>

            System Online

        </div>

    </div>

</div>



<!-- =========================================================
     DARK OVERLAY
     ========================================================= -->

<div class="rq-menu-overlay"
     id="rqMenuOverlay">
</div>



<!-- =========================================================
     SIDE MENU
     ========================================================= -->

<aside class="rq-side-menu"
       id="rqSideMenu">


    <!-- MENU HEADER -->

    <div class="rq-menu-header">

        <span class="rq-menu-title">
            RESTAURANT COMMAND
        </span>

        <button type="button"
                class="rq-menu-close"
                id="rqMenuClose"
                aria-label="Close menu">

            ×

        </button>

    </div>



    <!-- MENU LINKS -->

    <div class="rq-menu-links">


        <!-- DASHBOARD -->

        <a asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index"
           class="rq-menu-link @(isDashboard ? "active" : "")">

            <span class="rq-menu-icon">
                ◈
            </span>

            <span class="rq-menu-text">
                Dashboard
            </span>

            <span class="rq-menu-arrow">
                →
            </span>

        </a>



        <!-- MENU MANAGEMENT -->

        <a asp-area="Admin"
           asp-controller="MenuItem"
           asp-action="Index"
           class="rq-menu-link @(isMenuItem || isCategory ? "active" : "")">

            <span class="rq-menu-icon">
                ✦
            </span>

            <span class="rq-menu-text">
                Menu Management
            </span>

            <span class="rq-menu-arrow">
                →
            </span>

        </a>



        <!-- TABLES & QR -->

        <a asp-area="Admin"
           asp-controller="Table"
           asp-action="Index"
           class="rq-menu-link @(isTable ? "active" : "")">

            <span class="rq-menu-icon">
                ▦
            </span>

            <span class="rq-menu-text">
                Tables & QR
            </span>

            <span class="rq-menu-arrow">
                →
            </span>

        </a>



        <!-- ORDERS -->

        <a asp-area="Admin"
           asp-controller="Order"
           asp-action="Index"
           class="rq-menu-link @(isOrder ? "active" : "")">

            <span class="rq-menu-icon">
                ◇
            </span>

            <span class="rq-menu-text">
                Orders
            </span>

            <span class="rq-menu-arrow">
                →
            </span>

        </a>



        <!-- KITCHEN -->

        <a asp-area="Admin"
           asp-controller="KitchenStaff"
           asp-action="Index"
           class="rq-menu-link @(isKitchen ? "active" : "")">

            <span class="rq-menu-icon">
                ♙
            </span>

            <span class="rq-menu-text">
                Kitchen Staff
            </span>

            <span class="rq-menu-arrow">
                →
            </span>

        </a>



        <!-- DIVIDER -->

        <div class="rq-menu-divider">
        </div>



        <!-- LOGOUT -->

        <a asp-area=""
           asp-controller="Account"
           asp-action="Logout"
           class="rq-menu-link rq-logout">

            <span class="rq-menu-icon">
                ↪
            </span>

            <span class="rq-menu-text">
                Logout
            </span>

            <span class="rq-menu-arrow">
                →
            </span>

        </a>

    </div>

</aside>



<script>

    /* =========================================================
       RESTAURANT QR MENU
       ========================================================= */

    (function () {

        const trigger =
            document.getElementById("rqMenuTrigger");

        const close =
            document.getElementById("rqMenuClose");

        const overlay =
            document.getElementById("rqMenuOverlay");

        const sideMenu =
            document.getElementById("rqSideMenu");


        if (!trigger || !close || !overlay || !sideMenu) {
            return;
        }


        function openMenu() {

            sideMenu.classList.add("open");

            overlay.classList.add("open");

            trigger.setAttribute(
                "aria-expanded",
                "true"
            );

            document.body.style.overflow = "hidden";
        }


        function closeMenu() {

            sideMenu.classList.remove("open");

            overlay.classList.remove("open");

            trigger.setAttribute(
                "aria-expanded",
                "false"
            );

            document.body.style.overflow = "";
        }


        trigger.addEventListener(
            "click",
            function (event) {

                event.stopPropagation();

                if (sideMenu.classList.contains("open")) {

                    closeMenu();

                }
                else {

                    openMenu();

                }

            }
        );


        close.addEventListener(
            "click",
            closeMenu
        );


        overlay.addEventListener(
            "click",
            closeMenu
        );


        document.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Escape") {

                    closeMenu();

                }

            }
        );


        /* Prevent clicking inside menu from closing it */

        sideMenu.addEventListener(
            "click",
            function (event) {

                event.stopPropagation();

            }
        );


        /* Close menu after selecting a navigation item */

        const menuLinks =
            sideMenu.querySelectorAll(
                "a.rq-menu-link"
            );


        menuLinks.forEach(
            function (link) {

                link.addEventListener(
                    "click",
                    function () {

                        closeMenu();

                    }
                );

            }
        );

    })();

</script>