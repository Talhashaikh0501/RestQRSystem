@model RestaurantQR.ViewModels.MenuItemViewModel

@{
    ViewData["Title"] = "Create Menu Item";
}

<h1 style="font-family:'Fraunces',serif; margin-bottom:10px;">
    Create Menu Item
</h1>

<p style="color:#A39C90; margin-bottom:50px;">
    Add a new item to your restaurant menu.
</p>

<form asp-action="Create" method="post" style="max-width:700px;">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

    <div class="mb-4">
        <input asp-for="Name" class="form-input-premium" placeholder="Item Name" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <textarea asp-for="Description"
                  class="form-input-premium"
                  placeholder="Description"
                  style="min-height:120px;"></textarea>
    </div>

    <div class="mb-4">
        <div class="price-wrapper">
            <span class="currency-symbol">₹</span>
            <input asp-for="Price"
                   class="form-input-premium price-input"
                   placeholder="0.00"
                   step="0.01"
                   min="0" />
        </div>
        <span asp-validation-for="Price" class="text-danger small"></span>
        <span asp-validation-for="Price" class="text-danger small"></span>
    </div>

    <div class="mb-5">
        <select asp-for="CategoryId"
                asp-items="Model.Categories"
                class="form-input-premium">
        </select>
    </div>

    <div class="d-flex gap-3">
        <a asp-action="Index" class="btn-ghost">Back</a>
        <button type="submit" class="btn-gold">
            Create Item
        </button>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}