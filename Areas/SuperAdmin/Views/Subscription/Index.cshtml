@model IEnumerable<RestaurantQR.Models.SubscriptionPlan>

@{
    ViewData["Title"] = "Subscription Plans";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Subscription Plans</h2>
            <p class="text-muted mb-0">
                Manage subscription plans for restaurant administrators.
            </p>
        </div>

        <a asp-area="SuperAdmin"
           asp-controller="Subscription"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add New Plan
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Plan</th>
                            <th>Duration</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Type</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var plan in Model)
                            {
                                <tr>
                                    <td>@plan.Id</td>

                                    <td>
                                        <strong>@plan.Name</strong>
                                    </td>

                                    <td>
                                        @plan.DurationDays days
                                    </td>

                                    <td>
                                        <strong>₹@plan.Price.ToString("N2")</strong>
                                    </td>

                                    <td>
                                        @if (plan.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (plan.IsCustom)
                                        {
                                            <span class="badge bg-info">
                                                Custom
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">
                                                Standard
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <a asp-area="SuperAdmin"
                                           asp-controller="Subscription"
                                           asp-action="Edit"
                                           asp-route-id="@plan.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <form asp-area="SuperAdmin"
                                              asp-controller="Subscription"
                                              asp-action="ToggleStatus"
                                              asp-route-id="@plan.Id"
                                              method="post"
                                              style="display:inline;">

                                            @if (plan.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary">
                                                    Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">
                                                    Activate
                                                </button>
                                            }

                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    No subscription plans found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>