@model RestaurantQR.Models.SubscriptionPlan

@{
    ViewData["Title"] = "Edit Subscription Plan";
}

<style>

    .subscription-edit-page {
        --rq-white: #FFFDF7;
        --rq-cream: #F5E6CA;
        --rq-beige: #DCC7AA;
        --rq-coffee: #6F4E37;
        --rq-espresso: #4B3832;
        --rq-deep: #352822;
        --rq-gold: #B8894D;
        --rq-muted: #8B7565;
        --rq-danger: #965044;
        width: min(920px, calc(100% - 40px));
        margin: 0 auto;
        color: var(--rq-espresso);
        animation: subEditFade .65s ease both;
    }

    .sub-edit-hero {
        margin-bottom: 32px;
    }

    .sub-edit-eyebrow {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 15px;
        color: var(--rq-coffee);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 4px;
        text-transform: uppercase;
    }

        .sub-edit-eyebrow::before {
            content: "";
            width: 46px;
            height: 1px;
            background: var(--rq-gold);
        }

    .sub-edit-title {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(48px, 6vw, 74px);
        font-weight: 400;
        line-height: .96;
        letter-spacing: -3px;
        color: var(--rq-espresso);
    }

        .sub-edit-title em {
            color: var(--rq-coffee);
            font-style: italic;
            font-weight: 400;
        }

    .sub-edit-description {
        max-width: 680px;
        margin: 18px 0 0;
        color: var(--rq-muted);
        font-size: 14px;
        line-height: 1.8;
    }

    .sub-edit-card {
        position: relative;
        overflow: hidden;
        padding: 34px;
        border: 1px solid rgba(255,255,255,.95);
        border-radius: 30px;
        background: linear-gradient( 135deg, rgba(255,253,247,.92), rgba(245,230,202,.60) );
        box-shadow: 0 24px 70px rgba(75,56,50,.10);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

        .sub-edit-card::before {
            content: "";
            position: absolute;
            width: 210px;
            height: 210px;
            top: -105px;
            right: -95px;
            border-radius: 50%;
            background: rgba(220,199,170,.31);
            pointer-events: none;
        }

        .sub-edit-card::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            left: -75px;
            bottom: -75px;
            border-radius: 50%;
            background: rgba(184,137,77,.07);
            pointer-events: none;
        }

    .sub-edit-header {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 24px;
        margin-bottom: 28px;
        border-bottom: 1px solid rgba(75,56,50,.10);
    }

    .sub-edit-heading {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .sub-edit-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        background: var(--rq-coffee);
        color: var(--rq-white);
        font-size: 22px;
        box-shadow: 0 12px 28px rgba(111,78,55,.20);
    }

    .sub-edit-heading h2 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 24px;
        font-weight: 400;
        color: var(--rq-espresso);
    }

    .sub-edit-heading span {
        display: block;
        margin-top: 4px;
        color: var(--rq-muted);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .sub-edit-tag {
        color: var(--rq-gold);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .sub-edit-form {
        position: relative;
        z-index: 2;
    }

    .sub-edit-group {
        margin-bottom: 22px;
    }

    .sub-edit-label {
        display: block;
        margin-bottom: 9px;
        color: var(--rq-espresso);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.3px;
        text-transform: uppercase;
    }

        .sub-edit-label::before {
            content: "•";
            margin-right: 7px;
            color: var(--rq-gold);
        }

    .sub-edit-input {
        width: 100%;
        min-height: 56px;
        padding: 14px 17px;
        border: 1px solid rgba(111,78,55,.16);
        border-radius: 15px;
        outline: none;
        background: rgba(255,255,255,.72);
        color: var(--rq-espresso);
        font-size: 14px;
        transition: border-color .25s ease, background .25s ease, box-shadow .25s ease, transform .25s ease;
    }

        .sub-edit-input:hover {
            background: rgba(255,255,255,.92);
            border-color: rgba(111,78,55,.25);
        }

        .sub-edit-input:focus {
            background: var(--rq-white);
            border-color: var(--rq-gold);
            box-shadow: 0 0 0 4px rgba(184,137,77,.10), 0 10px 28px rgba(75,56,50,.07);
            transform: translateY(-1px);
        }

    .sub-edit-validation-summary {
        margin-bottom: 22px;
        padding: 14px 16px;
        border: 1px solid rgba(150,80,68,.15);
        border-left: 4px solid var(--rq-danger);
        border-radius: 14px;
        background: rgba(150,80,68,.06);
        color: var(--rq-danger);
        font-size: 12px;
    }

    .sub-edit-validation {
        display: block;
        margin-top: 7px;
        color: var(--rq-danger);
        font-size: 11px;
    }

    .sub-toggle-area {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 14px;
        margin-top: 6px;
        margin-bottom: 26px;
    }

    .sub-toggle-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: 74px;
        padding: 15px 17px;
        border: 1px solid rgba(111,78,55,.12);
        border-radius: 17px;
        background: rgba(245,230,202,.34);
    }

    .sub-toggle-copy strong {
        display: block;
        margin-bottom: 4px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 16px;
        font-weight: 400;
        color: var(--rq-espresso);
    }

    .sub-toggle-copy span {
        color: var(--rq-muted);
        font-size: 10px;
        line-height: 1.5;
    }

    .sub-toggle {
        position: relative;
        width: 50px;
        height: 28px;
        flex: 0 0 50px;
    }

        .sub-toggle input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .sub-toggle-slider {
        position: absolute;
        inset: 0;
        border-radius: 30px;
        background: #D9C7AD;
        cursor: pointer;
        transition: .25s ease;
    }

        .sub-toggle-slider::before {
            content: "";
            position: absolute;
            width: 22px;
            height: 22px;
            left: 3px;
            top: 3px;
            border-radius: 50%;
            background: var(--rq-white);
            box-shadow: 0 3px 10px rgba(75,56,50,.16);
            transition: .25s ease;
        }

    .sub-toggle input:checked + .sub-toggle-slider {
        background: var(--rq-coffee);
    }

        .sub-toggle input:checked + .sub-toggle-slider::before {
            transform: translateX(22px);
        }

    .sub-edit-info {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-top: 6px;
        margin-bottom: 25px;
    }

    .sub-edit-info-item {
        padding: 13px;
        border-radius: 13px;
        background: rgba(245,230,202,.30);
        color: var(--rq-muted);
        font-size: 10px;
        line-height: 1.5;
    }

        .sub-edit-info-item strong {
            display: block;
            margin-bottom: 3px;
            color: var(--rq-coffee);
            font-size: 10px;
        }

    .sub-edit-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-top: 28px;
        padding-top: 24px;
        border-top: 1px solid rgba(75,56,50,.10);
    }

    .sub-save-btn,
    .sub-cancel-btn {
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 22px;
        border-radius: 28px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: transform .25s ease, background .25s ease, color .25s ease, box-shadow .25s ease;
    }

    .sub-save-btn {
        border: 0;
        background: linear-gradient( 135deg, var(--rq-espresso), var(--rq-coffee) );
        color: var(--rq-white);
        cursor: pointer;
        box-shadow: 0 12px 28px rgba(75,56,50,.18);
    }

        .sub-save-btn:hover {
            color: var(--rq-white);
            transform: translateY(-2px);
            box-shadow: 0 17px 34px rgba(75,56,50,.24);
        }

    .sub-save-arrow {
        width: 29px;
        height: 29px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255,255,255,.14);
    }

    .sub-cancel-btn {
        border: 1px solid rgba(111,78,55,.16);
        background: rgba(255,253,247,.65);
        color: var(--rq-coffee);
    }

        .sub-cancel-btn:hover {
            color: var(--rq-white);
            background: var(--rq-coffee);
            transform: translateX(-2px);
        }

    @@keyframes subEditFade {

        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {

        .subscription-edit-page {
            width: calc(100% - 28px);
        }

        .sub-edit-card {
            padding: 27px 22px;
            border-radius: 25px;
        }

        .sub-toggle-area {
            grid-template-columns: 1fr;
        }

        .sub-edit-info {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {

        .subscription-edit-page {
            width: calc(100% - 22px);
        }

        .sub-edit-eyebrow {
            gap: 9px;
            font-size: 8px;
            letter-spacing: 2.5px;
        }

            .sub-edit-eyebrow::before {
                width: 28px;
            }

        .sub-edit-title {
            font-size: 42px;
            letter-spacing: -2px;
        }

        .sub-edit-description {
            margin-top: 13px;
            font-size: 13px;
            line-height: 1.65;
        }

        .sub-edit-card {
            padding: 20px 16px;
            border-radius: 22px;
        }

        .sub-edit-header {
            align-items: flex-start;
            margin-bottom: 22px;
            padding-bottom: 20px;
        }

        .sub-edit-heading {
            gap: 10px;
        }

        .sub-edit-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
        }

        .sub-edit-heading h2 {
            font-size: 20px;
        }

        .sub-edit-tag {
            display: none;
        }

        .sub-edit-input {
            min-height: 54px;
            font-size: 13px;
        }

        .sub-edit-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .sub-save-btn,
        .sub-cancel-btn {
            width: 100%;
        }
    }

</style>


<div class="subscription-edit-page">

    <section class="sub-edit-hero">

        <div class="sub-edit-eyebrow">
            SUBSCRIPTION MANAGEMENT
        </div>

        <h1 class="sub-edit-title">

            Edit
            <em>Subscription Plan.</em>

        </h1>

        <p class="sub-edit-description">

            Update this RestaurantQR subscription plan,
            adjust its duration or pricing and control whether
            it remains available for restaurant assignment.

        </p>

    </section>


    <section class="sub-edit-card">

        <div class="sub-edit-header">

            <div class="sub-edit-heading">

                <div class="sub-edit-icon">
                    ◈
                </div>

                <div>

                    <h2>
                        Plan Configuration
                    </h2>

                    <span>
                        Update Subscription Details
                    </span>

                </div>

            </div>


            <div class="sub-edit-tag">
                Edit Plan
            </div>

        </div>


        <form asp-action="Edit"
              asp-controller="Subscription"
              asp-area="SuperAdmin"
              method="post"
              class="sub-edit-form">

            <input type="hidden"
                   asp-for="Id" />

            <input type="hidden"
                   asp-for="CreatedAt" />


            <div asp-validation-summary="ModelOnly"
                 class="sub-edit-validation-summary">
            </div>


            <div class="sub-edit-group">

                <label asp-for="Name"
                       class="sub-edit-label">

                    Plan Name

                </label>


                <input asp-for="Name"
                       class="sub-edit-input"
                       placeholder="Enter subscription plan name" />


                <span asp-validation-for="Name"
                      class="sub-edit-validation">
                </span>

            </div>


            <div class="sub-edit-group">

                <label asp-for="DurationDays"
                       class="sub-edit-label">

                    Duration (Days)

                </label>


                <input asp-for="DurationDays"
                       type="number"
                       min="1"
                       class="sub-edit-input"
                       placeholder="Example: 90" />


                <span asp-validation-for="DurationDays"
                      class="sub-edit-validation">
                </span>

            </div>


            <div class="sub-edit-group">

                <label asp-for="Price"
                       class="sub-edit-label">

                    Price (₹)

                </label>


                <input asp-for="Price"
                       type="number"
                       step="0.01"
                       min="0"
                       class="sub-edit-input"
                       placeholder="Example: 4999" />


                <span asp-validation-for="Price"
                      class="sub-edit-validation">
                </span>

            </div>


            <div class="sub-toggle-area">


                <div class="sub-toggle-card">

                    <div class="sub-toggle-copy">

                        <strong>
                            Custom Subscription
                        </strong>

                        <span>
                            Keep this enabled when the plan is a custom package.
                        </span>

                    </div>


                    <label class="sub-toggle">

                        <input asp-for="IsCustom"
                               type="checkbox" />

                        <span class="sub-toggle-slider"></span>

                    </label>

                </div>


                <div class="sub-toggle-card">

                    <div class="sub-toggle-copy">

                        <strong>
                            Active Plan
                        </strong>

                        <span>
                            Active plans remain available for restaurant assignment.
                        </span>

                    </div>


                    <label class="sub-toggle">

                        <input asp-for="IsActive"
                               type="checkbox" />

                        <span class="sub-toggle-slider"></span>

                    </label>

                </div>

            </div>


            <div class="sub-edit-info">

                <div class="sub-edit-info-item">

                    <strong>
                        Existing Plan
                    </strong>

                    Saving will update this plan instead of creating a new one.

                </div>


                <div class="sub-edit-info-item">

                    <strong>
                        Pricing
                    </strong>

                    Update the price whenever the subscription package changes.

                </div>


                <div class="sub-edit-info-item">

                    <strong>
                        Availability
                    </strong>

                    Disable the plan when it should no longer be assigned.

                </div>

            </div>


            <div class="sub-edit-actions">

                <a asp-action="Index"
                   asp-controller="Subscription"
                   asp-area="SuperAdmin"
                   class="sub-cancel-btn">

                    ← Cancel

                </a>


                <button type="submit"
                        class="sub-save-btn">

                    Save Changes

                    <span class="sub-save-arrow">
                        →
                    </span>

                </button>

            </div>

        </form>

    </section>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}