@model RestaurantQR.Models.SubscriptionPlan

@{
    ViewData["Title"] = "Add Subscription Plan";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2>Add Subscription Plan</h2>
        <p class="text-muted">
            Create a new subscription plan for restaurant administrators.
        </p>
    </div>

    <div class="card shadow-sm border-0" style="max-width: 700px;">
        <div class="card-body p-4">

            <form asp-action="Create"
                  asp-controller="Subscription"
                  asp-area="SuperAdmin"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        Plan Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Example: 3 Months" />

                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DurationDays" class="form-label">
                        Duration (Days)
                    </label>

                    <input asp-for="DurationDays"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="Example: 90" />

                    <span asp-validation-for="DurationDays"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label">
                        Price (₹)
                    </label>

                    <input asp-for="Price"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           placeholder="Example: 4999" />

                    <span asp-validation-for="Price"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsCustom"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="IsCustom"
                           class="form-check-label">
                        Custom Subscription
                    </label>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive"
                           class="form-check-input"
                           type="checkbox"
                           checked />

                    <label asp-for="IsActive"
                           class="form-check-label">
                        Active
                    </label>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Create Plan
                    </button>

                    <a asp-action="Index"
                       asp-controller="Subscription"
                       asp-area="SuperAdmin"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}