        // =========================================================
        // UPDATE EXISTING CHART
        // =========================================================

        function updateChart(
            chart,
            points)
        {
            if (!chart) {
                return;
            }


            chart.data.labels =
                getLabels(points);


            chart.data.datasets[0].data =
                getValues(points);


            chart.update();
        }



        // =========================================================
        // UPDATE FULL DASHBOARD
        // =========================================================

        function applyDashboardData(data) {

            dashboardData = data;


            document.getElementById(
                "selectedRevenueLabel"
            ).textContent =
                data.selectedRevenueRangeLabel;


            document.getElementById(
                "selectedRevenueValue"
            ).textContent =
                formatCurrency(
                    data.selectedPaidSubscriptionRevenue
                );


            document.getElementById(
                "lifetimeRevenueValue"
            ).textContent =
                formatCurrency(
                    data.totalPaidSubscriptionRevenue
                );


            document.getElementById(
                "lastUpdatedText"
            ).textContent =
                formatUpdatedTime(
                    data.generatedAtUtc
                );


            updateChart(
                charts.revenue,
                data.subscriptionRevenueTrend
            );


            updateChart(
                charts.growth,
                data.restaurantGrowthTrend
            );


            updateChart(
                charts.restaurantStatus,
                data.restaurantStatusDistribution
            );


            updateChart(
                charts.subscriptionHealth,
                data.subscriptionStatusDistribution
            );


            updateChart(
                charts.plan,
                data.subscriptionPlanDistribution
            );


            updateChart(
                charts.expiry,
                data.subscriptionExpiryTrend
            );


            updateChart(
                charts.usage,
                data.platformUsageTrend
            );


            updateRangeButtons();
        }



        // =========================================================
        // RANGE BUTTONS
        // =========================================================

        function updateRangeButtons() {

            document
                .querySelectorAll(
                    ".sa-range-btn"
                )
                .forEach(button => {

                    button.classList.toggle(
                        "active",
                        button.dataset.range
                            === selectedRange
                    );
                });
        }


        function disableRangeButtons(
            disabled)
        {
            document
                .querySelectorAll(
                    ".sa-range-btn"
                )
                .forEach(button => {

                    button.disabled =
                        disabled;
                });
        }



        // =========================================================
        // FETCH FRESH SQL ANALYTICS
        // =========================================================

        async function refreshAnalytics(
            force = false)
        {
            if (refreshInProgress) {

                queuedRefresh = true;

                return;
            }


            refreshInProgress = true;

            queuedRefresh = false;


            page.classList.add(
                "is-loading"
            );


            disableRangeButtons(true);


            try {

                const separator =
                    analyticsUrl.includes("?")
                        ? "&"
                        : "?";


                const response =
                    await fetch(
                        analyticsUrl
                        + separator
                        + "range="
                        + encodeURIComponent(
                            selectedRange
                        ),
                        {
                            method: "GET",

                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            },

                            cache: "no-store"
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "Analytics request failed: "
                        + response.status
                    );
                }


                const data =
                    await response.json();


                applyDashboardData(data);

            }
            catch (error) {

                console.error(
                    "Unable to refresh SuperAdmin analytics.",
                    error
                );

            }
            finally {

                refreshInProgress = false;


                page.classList.remove(
                    "is-loading"
                );


                disableRangeButtons(false);


                if (queuedRefresh || force) {

                    if (queuedRefresh) {

                        queuedRefresh = false;

                        setTimeout(
                            () =>
                                refreshAnalytics(),
                            250
                        );
                    }
                }
            }
        }



        // =========================================================
        // RANGE CHANGE
        // =========================================================

        document
            .querySelectorAll(
                ".sa-range-btn"
            )
            .forEach(button => {

                button.addEventListener(
                    "click",
                    async () => {

                        const newRange =
                            button.dataset.range;


                        if (
                            !newRange
                            ||
                            newRange === selectedRange
                        ) {
                            return;
                        }


                        selectedRange =
                            newRange;


                        updateRangeButtons();


                        await refreshAnalytics();
                    }
                );
            });



        // =========================================================
        // SIGNALR LIVE CONNECTION
        // =========================================================

        let analyticsConnection = null;


        function setLiveState(
            connected)
        {
            const status =
                document.getElementById(
                    "liveStatus"
                );


            const text =
                document.getElementById(
                    "liveStatusText"
                );


            if (connected) {

                status.classList.remove(
                    "is-offline"
                );


                text.textContent =
                    "Connected";

            }
            else {

                status.classList.add(
                    "is-offline"
                );


                text.textContent =
                    "Reconnecting...";
            }
        }



        async function joinAnalyticsGroup() {

            if (
                !analyticsConnection
                ||
                analyticsConnection.state
                    !== signalR
                        .HubConnectionState
                        .Connected
            ) {
                return;
            }


            try {

                await analyticsConnection
                    .invoke(
                        "JoinSuperAdminAnalyticsGroup"
                    );

            }
            catch (error) {

                /*
                 * This method is added in File 5.
                 *
                 * Until File 5 is replaced,
                 * the normal 30-second fallback
                 * refresh still works.
                 */

                console.debug(
                    "SuperAdmin analytics group is not available yet.",
                    error
                );
            }
        }



        async function startSignalR() {

            if (
                typeof signalR
                === "undefined"
            ) {

                setLiveState(false);

                return;
            }


            analyticsConnection =
                new signalR.HubConnectionBuilder()

                    .withUrl(
                        "/orderHub"
                    )

                    .withAutomaticReconnect(
                        [
                            0,
                            2000,
                            5000,
                            10000,
                            20000
                        ]
                    )

                    .build();


            // -----------------------------------------------------
            // Dedicated dashboard refresh event.
            // Added to backend in later files.
            // -----------------------------------------------------

            analyticsConnection.on(
                "PlatformAnalyticsChanged",
                () => {

                    refreshAnalytics();
                }
            );


            /*
             * These listeners are harmless fallbacks.
             * The dedicated PlatformAnalyticsChanged
             * event will become the primary mechanism.
             */

            analyticsConnection.on(
                "NewOrder",
                () => {

                    refreshAnalytics();
                }
            );


            analyticsConnection.on(
                "OrderStatusChanged",
                () => {

                    refreshAnalytics();
                }
            );


            analyticsConnection.onreconnecting(
                () => {

                    setLiveState(false);
                }
            );


            analyticsConnection.onreconnected(
                async () => {

                    setLiveState(true);

                    await joinAnalyticsGroup();

                    await refreshAnalytics();
                }
            );


            analyticsConnection.onclose(
                () => {

                    setLiveState(false);
                }
            );


            try {

                await analyticsConnection.start();


                setLiveState(true);


                await joinAnalyticsGroup();

            }
            catch (error) {

                console.error(
                    "SuperAdmin SignalR connection failed.",
                    error
                );


                setLiveState(false);
            }
        }



        // =========================================================
        // INITIALIZE
        // =========================================================

        createCharts(
            dashboardData
        );


        applyDashboardData(
            dashboardData
        );


        updateRangeButtons();


        startSignalR();



        // =========================================================
        // FALLBACK REFRESH
        // =========================================================
        //
        // SignalR is the real-time mechanism.
        //
        // This is only a safety fallback so the dashboard
        // eventually refreshes even if a server-side event
        // is missed.
        // =========================================================

        window.setInterval(
            () => {

                refreshAnalytics();

            },
            30000
        );

    })();

</script>