@model RestaurantQR.ViewModels.SuperAdminDashboardViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Platform Analytics";

    var initialDashboardJson = JsonSerializer.Serialize(
        Model,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        }
    );
}

<div class="sa-analytics-page">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <section class="sa-analytics-header">

        <div>
            <div class="sa-eyebrow">
                RestaurantQR Business Intelligence
            </div>

            <h1 class="sa-page-title">
                Platform
                <em>Analytics</em>
            </h1>

            <p class="sa-page-description">
                Real-time insight into RestaurantQR subscription revenue,
                customer growth, subscription health and platform adoption.
            </p>
        </div>


        <div class="sa-live-area">

            <div class="sa-live-status" id="liveStatus">
                <span class="sa-live-dot"></span>

                <div>
                    <strong>LIVE</strong>
                    <small id="liveStatusText">
                        Connecting...
                    </small>
                </div>
            </div>

            <div class="sa-last-updated">
                Last updated
                <strong id="lastUpdatedText">
                    --
                </strong>
            </div>

        </div>

    </section>



    <!-- =========================================================
         REVENUE ANALYTICS
    ========================================================== -->

    <section class="sa-analytics-section sa-revenue-section">

        <div class="sa-section-heading">

            <div>
                <span class="sa-section-kicker">
                    RestaurantQR Revenue
                </span>

                <h2>
                    Paid Subscription Revenue
                </h2>

                <p>
                    Revenue received by RestaurantQR from successfully
                    paid restaurant subscriptions.
                </p>
            </div>


            <div class="sa-revenue-controls">

                <div class="sa-range-selector"
                     role="group"
                     aria-label="Revenue period">

                    <button type="button"
                            class="sa-range-btn"
                            data-range="30d">

                        30 Days

                    </button>

                    <button type="button"
                            class="sa-range-btn"
                            data-range="6m">

                        6 Months

                    </button>

                    <button type="button"
                            class="sa-range-btn"
                            data-range="1y">

                        1 Year

                    </button>

                </div>

            </div>

        </div>


        <div class="sa-revenue-summary">

            <div class="sa-revenue-stat">

                <span id="selectedRevenueLabel">
                    @Model.SelectedRevenueRangeLabel
                </span>

                <strong id="selectedRevenueValue">
                    ₹@Model.SelectedPaidSubscriptionRevenue.ToString("N2")
                </strong>

            </div>


            <div class="sa-revenue-divider"></div>


            <div class="sa-revenue-stat">

                <span>
                    Lifetime Paid Revenue
                </span>

                <strong id="lifetimeRevenueValue">
                    ₹@Model.TotalPaidSubscriptionRevenue.ToString("N2")
                </strong>

            </div>

        </div>


        <div class="sa-chart-large">

            <canvas id="subscriptionRevenueChart">
            </canvas>

        </div>

    </section>



    <!-- =========================================================
         CUSTOMER GROWTH
    ========================================================== -->

    <section class="sa-analytics-section">

        <div class="sa-section-heading">

            <div>
                <span class="sa-section-kicker">
                    Customer Acquisition
                </span>

                <h2>
                    RestaurantQR Customer Growth
                </h2>

                <p>
                    Cumulative growth of restaurants registered
                    on the RestaurantQR platform during the
                    latest 12 months.
                </p>
            </div>

        </div>


        <div class="sa-chart-medium">

            <canvas id="restaurantGrowthChart">
            </canvas>

        </div>

    </section>



    <!-- =========================================================
         BUSINESS HEALTH
    ========================================================== -->

    <div class="sa-two-column">

        <!-- Restaurant Activity -->

        <section class="sa-analytics-section">

            <div class="sa-section-heading">

                <div>
                    <span class="sa-section-kicker">
                        Customer Status
                    </span>

                    <h2>
                        Restaurant Activity
                    </h2>

                    <p>
                        Active and inactive RestaurantQR
                        customer accounts.
                    </p>
                </div>

            </div>


            <div class="sa-chart-donut">

                <canvas id="restaurantStatusChart">
                </canvas>

            </div>

        </section>



        <!-- Subscription Health -->

        <section class="sa-analytics-section">

            <div class="sa-section-heading">

                <div>
                    <span class="sa-section-kicker">
                        Subscription Health
                    </span>

                    <h2>
                        Customer Subscription Status
                    </h2>

                    <p>
                        Current subscription condition across
                        RestaurantQR customers.
                    </p>
                </div>

            </div>


            <div class="sa-chart-donut">

                <canvas id="subscriptionHealthChart">
                </canvas>

            </div>

        </section>

    </div>



    <!-- =========================================================
         PLAN MIX
    ========================================================== -->

    <section class="sa-analytics-section">

        <div class="sa-section-heading">

            <div>
                <span class="sa-section-kicker">
                    Product Mix
                </span>

                <h2>
                    Subscription Plan Distribution
                </h2>

                <p>
                    Distribution of active paid RestaurantQR
                    subscriptions by plan.
                </p>
            </div>

        </div>


        <div class="sa-chart-medium">

            <canvas id="subscriptionPlanChart">
            </canvas>

        </div>

    </section>



    <!-- =========================================================
         EXPIRY + PLATFORM USAGE
    ========================================================== -->

    <div class="sa-two-column">

        <!-- Expirations -->

        <section class="sa-analytics-section">

            <div class="sa-section-heading">

                <div>
                    <span class="sa-section-kicker">
                        Retention Outlook
                    </span>

                    <h2>
                        Upcoming Expirations
                    </h2>

                    <p>
                        Active paid subscriptions scheduled
                        to expire during the next six months.
                    </p>
                </div>

            </div>


            <div class="sa-chart-small">

                <canvas id="subscriptionExpiryChart">
                </canvas>

            </div>

        </section>



        <!-- Platform Usage -->

        <section class="sa-analytics-section">

            <div class="sa-section-heading">

                <div>
                    <span class="sa-section-kicker">
                        Product Adoption
                    </span>

                    <h2>
                        Platform Usage
                    </h2>

                    <p>
                        Orders processed through RestaurantQR
                        during the latest 14 days.
                    </p>
                </div>

            </div>


            <div class="sa-chart-small">

                <canvas id="platformUsageChart">
                </canvas>

            </div>

        </section>

    </div>



    <!-- =========================================================
         FOOTNOTE
    ========================================================== -->

    <div class="sa-dashboard-note">

        <span class="sa-note-line"></span>

        <p>
            Revenue analytics include only subscriptions whose
            payment status is marked as Paid. Restaurant order
            values are intentionally excluded from RestaurantQR
            business revenue.
        </p>

    </div>

</div>



<style>

    /* =========================================================
           ROOT
        ========================================================== */

    .sa-analytics-page {
        --sa-white: #FFFDF7;
        --sa-cream: #F5E6CA;
        --sa-beige: #DCC7AA;
        --sa-coffee: #6F4E37;
        --sa-espresso: #4B3832;
        --sa-deep: #352822;
        --sa-gold: #B8894D;
        --sa-muted: #8B7565;
        --sa-line: rgba(75, 56, 50, .12);
        width: min(1380px, calc(100% - 40px));
        margin: 0 auto;
        color: var(--sa-espresso);
    }



    /* =========================================================
           HEADER
        ========================================================== */

    .sa-analytics-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 50px;
        margin-bottom: 44px;
    }


    .sa-eyebrow {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 13px;
        color: var(--sa-coffee);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 3.4px;
        text-transform: uppercase;
    }


        .sa-eyebrow::before {
            content: "";
            display: block;
            width: 42px;
            height: 1px;
            background: var(--sa-gold);
        }


    .sa-page-title {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(48px, 6vw, 82px);
        font-weight: 400;
        line-height: .95;
        letter-spacing: -3.5px;
        color: var(--sa-espresso);
    }


        .sa-page-title em {
            color: var(--sa-coffee);
            font-weight: 400;
        }


    .sa-page-description {
        max-width: 760px;
        margin: 19px 0 0;
        color: var(--sa-muted);
        font-size: 14px;
        line-height: 1.8;
    }



    /* =========================================================
           LIVE STATUS
        ========================================================== */

    .sa-live-area {
        min-width: 185px;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 13px;
    }


    .sa-live-status {
        min-width: 165px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 16px;
        border: 1px solid rgba(111, 78, 55, .12);
        border-radius: 18px;
        background: rgba(255, 253, 247, .68);
        box-shadow: 0 12px 30px rgba(75, 56, 50, .06);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
    }


    .sa-live-dot {
        width: 10px;
        height: 10px;
        flex: 0 0 10px;
        border-radius: 50%;
        background: #A7B66D;
        box-shadow: 0 0 0 6px rgba(167, 182, 109, .13);
        animation: saLivePulse 2s ease-in-out infinite;
    }


    .sa-live-status strong {
        display: block;
        margin-bottom: 3px;
        color: var(--sa-espresso);
        font-size: 10px;
        letter-spacing: 2px;
    }


    .sa-live-status small {
        display: block;
        color: var(--sa-muted);
        font-size: 9px;
    }


    .sa-live-status.is-offline .sa-live-dot {
        background: #B78372;
        box-shadow: 0 0 0 6px rgba(183, 131, 114, .12);
        animation: none;
    }


    .sa-last-updated {
        padding-right: 4px;
        color: #A08673;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }


        .sa-last-updated strong {
            margin-left: 5px;
            color: var(--sa-coffee);
        }



    /* =========================================================
           ANALYTICS SECTIONS
        ========================================================== */

    .sa-analytics-section {
        position: relative;
        overflow: hidden;
        margin-bottom: 24px;
        padding: 30px 32px 28px;
        border-top: 1px solid rgba(111, 78, 55, .14);
        border-bottom: 1px solid rgba(111, 78, 55, .10);
        background: linear-gradient( 135deg, rgba(255, 253, 247, .52), rgba(245, 230, 202, .24) );
        box-shadow: 0 22px 60px rgba(75, 56, 50, .055);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
    }


        .sa-analytics-section::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 64px;
            height: 2px;
            background: var(--sa-gold);
        }


    .sa-section-heading {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 25px;
    }


    .sa-section-kicker {
        display: block;
        margin-bottom: 8px;
        color: #A28772;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 2.8px;
        text-transform: uppercase;
    }


    .sa-section-heading h2 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        color: var(--sa-espresso);
        font-size: 30px;
        font-weight: 400;
        letter-spacing: -.8px;
    }


    .sa-section-heading p {
        max-width: 680px;
        margin: 10px 0 0;
        color: var(--sa-muted);
        font-size: 12px;
        line-height: 1.7;
    }



    /* =========================================================
           TWO COLUMN ANALYTICS
        ========================================================== */

    .sa-two-column {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }



    /* =========================================================
           REVENUE
        ========================================================== */

    .sa-revenue-section {
        padding-top: 32px;
    }


    .sa-revenue-controls {
        flex-shrink: 0;
    }


    .sa-range-selector {
        display: inline-flex;
        padding: 4px;
        border: 1px solid rgba(75, 56, 50, .12);
        border-radius: 999px;
        background: rgba(255, 253, 247, .72);
    }


    .sa-range-btn {
        min-height: 38px;
        padding: 0 16px;
        border: none;
        border-radius: 999px;
        background: transparent;
        color: var(--sa-muted);
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: background .22s ease, color .22s ease, transform .22s ease;
    }


        .sa-range-btn:hover {
            color: var(--sa-espresso);
        }


        .sa-range-btn.active {
            background: var(--sa-espresso);
            color: var(--sa-white);
            box-shadow: 0 7px 18px rgba(75, 56, 50, .18);
        }


        .sa-range-btn:disabled {
            opacity: .6;
            cursor: wait;
        }


    .sa-revenue-summary {
        display: flex;
        align-items: stretch;
        gap: 30px;
        margin: 0 0 28px;
        padding: 20px 0 22px;
        border-top: 1px solid rgba(75, 56, 50, .08);
        border-bottom: 1px solid rgba(75, 56, 50, .08);
    }


    .sa-revenue-stat {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 7px;
    }


        .sa-revenue-stat span {
            color: var(--sa-muted);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.7px;
            text-transform: uppercase;
        }


        .sa-revenue-stat strong {
            font-family: Georgia, "Times New Roman", serif;
            color: var(--sa-espresso);
            font-size: clamp(25px, 3vw, 37px);
            font-weight: 400;
        }


    .sa-revenue-divider {
        width: 1px;
        background: rgba(75, 56, 50, .10);
    }



    /* =========================================================
           CHART SIZES
        ========================================================== */

    .sa-chart-large {
        position: relative;
        width: 100%;
        height: 390px;
    }


    .sa-chart-medium {
        position: relative;
        width: 100%;
        height: 330px;
    }


    .sa-chart-small {
        position: relative;
        width: 100%;
        height: 300px;
    }


    .sa-chart-donut {
        position: relative;
        width: 100%;
        height: 320px;
    }



    /* =========================================================
           FOOTNOTE
        ========================================================== */

    .sa-dashboard-note {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        padding: 16px 4px 0;
        margin-bottom: 15px;
    }


    .sa-note-line {
        width: 34px;
        height: 1px;
        margin-top: 8px;
        flex: 0 0 34px;
        background: var(--sa-gold);
    }


    .sa-dashboard-note p {
        max-width: 780px;
        margin: 0;
        color: #9B826F;
        font-size: 10px;
        line-height: 1.7;
        letter-spacing: .15px;
    }



    /* =========================================================
           LOADING
        ========================================================== */

    .sa-analytics-page.is-loading
    .sa-analytics-section {
        opacity: .72;
    }


    .sa-analytics-page.is-loading {
        cursor: progress;
    }



    /* =========================================================
           ANIMATION
        ========================================================== */

    @@keyframes saLivePulse {

        0%,
        100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(.78);
            opacity: .58;
        }
    }



    /* =========================================================
           RESPONSIVE
        ========================================================== */

    @@media (max-width: 1050px) {

        .sa-two-column {
            grid-template-columns: 1fr;
        }


        .sa-analytics-header {
            align-items: flex-start;
        }
    }


    @@media (max-width: 780px) {

        .sa-analytics-page {
            width: min( 100% - 24px, 1380px );
        }


        .sa-analytics-header {
            flex-direction: column;
            gap: 25px;
            margin-bottom: 32px;
        }


        .sa-live-area {
            width: 100%;
            align-items: flex-start;
        }


        .sa-live-status {
            width: 100%;
        }


        .sa-section-heading {
            flex-direction: column;
        }


        .sa-range-selector {
            width: 100%;
        }


        .sa-range-btn {
            flex: 1;
            padding-left: 10px;
            padding-right: 10px;
        }


        .sa-analytics-section {
            padding: 25px 20px 23px;
        }


        .sa-revenue-summary {
            gap: 18px;
        }


        .sa-revenue-stat strong {
            font-size: 25px;
        }


        .sa-chart-large {
            height: 330px;
        }


        .sa-chart-medium,
        .sa-chart-small,
        .sa-chart-donut {
            height: 285px;
        }
    }


    @@media (max-width: 520px) {

        .sa-page-title {
            font-size: 48px;
            letter-spacing: -2.5px;
        }


        .sa-revenue-summary {
            flex-direction: column;
        }


        .sa-revenue-divider {
            width: 100%;
            height: 1px;
        }


        .sa-range-selector {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
        }


        .sa-range-btn {
            padding: 0 7px;
            font-size: 9px;
        }


        .sa-section-heading h2 {
            font-size: 26px;
        }
    }

</style>



<!-- =========================================================
     CHART.JS
========================================================== -->

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js">
</script>


<!-- Existing local SignalR library in YOUR ZIP -->
<script src="~/lib/signalr/dist/browser/signalr.min.js">
</script>



<script>

    (() => {

        "use strict";


        // =========================================================
        // INITIAL DATA FROM ASP.NET
        // =========================================================

        let dashboardData =
            @Html.Raw(initialDashboardJson);


        let selectedRange =
            dashboardData.selectedRevenueRange || "30d";


        const analyticsUrl =
            '@Url.Action(
                                "Analytics",
                                "Dashboard",
                                new { area = "SuperAdmin" }
                        )';


        const page =
            document.querySelector(
                ".sa-analytics-page"
            );


        const charts = {};


        let refreshInProgress = false;

        let queuedRefresh = false;



        // =========================================================
        // COLORS
        // =========================================================

        const colors = {

            espresso:
                "#4B3832",

            coffee:
                "#6F4E37",

            gold:
                "#B8894D",

            beige:
                "#DCC7AA",

            cream:
                "#F5E6CA",

            muted:
                "#8B7565",

            green:
                "#91A664",

            amber:
                "#C89B58",

            rust:
                "#A96F55",

            rose:
                "#B98478",

            soft:
                "#CDBBA4"
        };



        // =========================================================
        // HELPERS
        // =========================================================

        function getLabels(points) {

            return (points || [])
                .map(point => point.label);
        }


        function getValues(points) {

            return (points || [])
                .map(point => Number(point.value || 0));
        }


        function formatCurrency(value) {

            return new Intl.NumberFormat(
                "en-IN",
                {
                    style: "currency",
                    currency: "INR",
                    maximumFractionDigits: 2
                }
            ).format(Number(value || 0));
        }


        function formatNumber(value) {

            return new Intl.NumberFormat(
                "en-IN"
            ).format(Number(value || 0));
        }


        function formatUpdatedTime(dateValue) {

            if (!dateValue) {
                return "--";
            }


            const date =
                new Date(dateValue);


            return date.toLocaleTimeString(
                [],
                {
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit"
                }
            );
        }



        // =========================================================
        // CHART.JS GLOBAL DEFAULTS
        // =========================================================

        if (typeof Chart !== "undefined") {

            Chart.defaults.font.family =
                'Arial, Helvetica, sans-serif';


            Chart.defaults.color =
                colors.muted;


            Chart.defaults.borderColor =
                "rgba(75,56,50,.08)";
        }



        // =========================================================
        // COMMON OPTIONS
        // =========================================================

        function lineOptions(
            currency = false)
        {
            return {

                responsive: true,

                maintainAspectRatio: false,

                interaction: {
                    intersect: false,
                    mode: "index"
                },

                animation: {
                    duration: 650
                },

                plugins: {

                    legend: {
                        display: false
                    },

                    tooltip: {

                        backgroundColor:
                            colors.espresso,

                        titleColor:
                            "#FFFDF7",

                        bodyColor:
                            "#FFFDF7",

                        padding: 12,

                        cornerRadius: 12,

                        callbacks: {

                            label(context) {

                                const value =
                                    context.parsed.y ?? 0;


                                return currency

                                    ? " " +
                                      formatCurrency(value)

                                    : " " +
                                      formatNumber(value);
                            }
                        }
                    }
                },

                scales: {

                    x: {

                        grid: {
                            display: false
                        },

                        border: {
                            display: false
                        },

                        ticks: {

                            color:
                                colors.muted,

                            maxRotation: 0,

                            autoSkip: true,

                            maxTicksLimit: 8,

                            font: {
                                size: 10
                            }
                        }
                    },

                    y: {

                        beginAtZero: true,

                        border: {
                            display: false
                        },

                        grid: {

                            color:
                                "rgba(75,56,50,.065)"
                        },

                        ticks: {

                            color:
                                colors.muted,

                            precision:
                                currency
                                    ? undefined
                                    : 0,

                            callback(value) {

                                return currency

                                    ? "₹" +
                                      new Intl.NumberFormat(
                                          "en-IN",
                                          {
                                              notation:
                                                  "compact",

                                              maximumFractionDigits:
                                                  1
                                          }
                                      ).format(value)

                                    : formatNumber(value);
                            },

                            font: {
                                size: 10
                            }
                        }
                    }
                }
            };
        }



        function doughnutOptions() {

            return {

                responsive: true,

                maintainAspectRatio: false,

                cutout: "68%",

                animation: {
                    duration: 650
                },

                plugins: {

                    legend: {

                        position: "bottom",

                        labels: {

                            usePointStyle: true,

                            pointStyle: "circle",

                            padding: 18,

                            color:
                                colors.muted,

                            font: {
                                size: 10
                            }
                        }
                    },

                    tooltip: {

                        backgroundColor:
                            colors.espresso,

                        titleColor:
                            "#FFFDF7",

                        bodyColor:
                            "#FFFDF7",

                        padding: 12,

                        cornerRadius: 12
                    }
                }
            };
        }



        function barOptions() {

            return {

                responsive: true,

                maintainAspectRatio: false,

                animation: {
                    duration: 650
                },

                plugins: {

                    legend: {
                        display: false
                    },

                    tooltip: {

                        backgroundColor:
                            colors.espresso,

                        titleColor:
                            "#FFFDF7",

                        bodyColor:
                            "#FFFDF7",

                        padding: 12,

                        cornerRadius: 12
                    }
                },

                scales: {

