                                        @if (!string.IsNullOrWhiteSpace(restaurant.CurrentPlan))
                                        {
                                            <span class="plan-text">
                                                @restaurant.CurrentPlan
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#A18B79;">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <span class="status-badge @StatusClass(restaurant.CurrentStatus)">
                                            @StatusText(restaurant.CurrentStatus)
                                        </span>

                                    </td>


