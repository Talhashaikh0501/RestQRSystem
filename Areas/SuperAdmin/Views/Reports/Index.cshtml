@model RestaurantQR.ViewModels.SubscriptionReportViewModel

@using RestaurantQR.Models

@{
    ViewData["Title"] = "Subscription Analytics";
    Layout = "~/Areas/SuperAdmin/Views/Shared/_SuperAdminLayout.cshtml";

    var selectedRestaurantId = ViewBag.SelectedRestaurantId as int?;
    var restaurants = ViewBag.Restaurants as IEnumerable<RestaurantQR.Models.Restaurant>
                      ?? Enumerable.Empty<RestaurantQR.Models.Restaurant>();

    /*
        IMPORTANT:
        Same restaurant name ko dropdown me repeat hone se rokta hai.
        Case-insensitive + whitespace-insensitive duplicate handling.
    */
    var uniqueRestaurants = restaurants
        .Where(r => r != null && !string.IsNullOrWhiteSpace(r.Name))
        .GroupBy(
            r => r.Name.Trim(),
            StringComparer.OrdinalIgnoreCase
        )
        .Select(g => g
            .OrderByDescending(x => x.IsActive)
            .ThenBy(x => x.Id)
            .First())
        .OrderBy(r => r.Name)
        .ToList();

    var currentStatus = Context.Request.Query["status"].ToString(); 
    var currentSearch = Context.Request.Query["search"].ToString();
    var currentDateRange = Context.Request.Query["dateRange"].ToString();

    if (string.IsNullOrWhiteSpace(currentDateRange))
    {
        currentDateRange = "all";
    }

    string StatusText(SubscriptionStatus? status)
    {
        return status switch
        {
            SubscriptionStatus.Active => "Active",
            SubscriptionStatus.Expired => "Expired",
            SubscriptionStatus.Pending => "Pending",
            SubscriptionStatus.Cancelled => "Cancelled",
            SubscriptionStatus.Suspended => "Suspended",
            _ => "No Active Plan"
        };
    }

    string StatusClass(SubscriptionStatus? status)
    {
        return status switch
        {
            SubscriptionStatus.Active => "status-active",
            SubscriptionStatus.Expired => "status-expired",
            SubscriptionStatus.Pending => "status-pending",
            SubscriptionStatus.Cancelled => "status-cancelled",
            SubscriptionStatus.Suspended => "status-suspended",
            _ => "status-none"
        };
    }
}

<style>
    /* =========================================================
           SUBSCRIPTION ANALYTICS
           ========================================================= */

    .report-page {
        width: 100%;
        max-width: 1550px;
        margin: 0 auto;
        padding: 95px 34px 90px;
        color: #352822;
        animation: reportPageIn .65s ease both;
    }

    @@keyframes reportPageIn {
        from

    {
        opacity: 0;
        transform: translateY(18px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* =========================================================
           PAGE HEADER
           ========================================================= */

    .report-header {
        position: relative;
        margin-bottom: 34px;
        padding-left: 76px;
    }

        .report-header::before {
            content: "";
            position: absolute;
            left: 0;
            top: 1px;
            width: 58px;
            height: 58px;
            border-radius: 18px;
            background: linear-gradient(145deg, #F5E6CA, #EFD9B2);
            box-shadow: inset 0 0 0 1px rgba(111,78,55,.08);
        }

        .report-header h1 {
            margin: 0;
            font-family: "Fraunces", Georgia, serif;
            font-size: clamp(36px, 4vw, 58px);
            line-height: 1;
            letter-spacing: -1.8px;
            color: #352822;
        }

        .report-header p {
            margin: 13px 0 0;
            font-family: Inter, Arial, sans-serif;
            font-size: 16px;
            color: #8B7565;
        }

    /* =========================================================
           FILTER PANEL
           ========================================================= */

    .filter-card {
        position: relative;
        z-index: 30;
        display: grid;
        grid-template-columns: 1.45fr 1fr 1fr 1fr auto;
        gap: 14px;
        align-items: end;
        padding: 28px;
        margin-bottom: 44px;
        background: rgba(255,253,247,.92);
        border: 1px solid #DFC8A7;
        border-radius: 28px;
        box-shadow: 0 20px 50px rgba(75,56,50,.06), inset 0 1px 0 rgba(255,255,255,.9);
        backdrop-filter: blur(14px);
    }

        .filter-card::after {
            content: "";
            position: absolute;
            right: -1px;
            top: -1px;
            width: 150px;
            height: 100px;
            border-radius: 0 28px 0 100%;
            background: rgba(245,230,202,.52);
            pointer-events: none;
            z-index: -1;
        }

    .filter-field {
        min-width: 0;
        position: relative;
    }

    .filter-label {
        display: block;
        margin: 0 0 10px 3px;
        font-family: Inter, Arial, sans-serif;
        font-size: 13px;
        font-weight: 800;
        color: #6F4E37;
        letter-spacing: .1px;
    }

    .search-box {
        position: relative;
    }

        .search-box i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #B8894D;
            font-size: 14px;
            pointer-events: none;
        }

        .search-box input {
            width: 100%;
            height: 54px;
            padding: 0 18px 0 45px;
            border: 1px solid #DFC8A7;
            border-radius: 16px;
            outline: none;
            background: rgba(255,253,247,.95);
            color: #352822;
            font-family: Inter, Arial, sans-serif;
            font-size: 14px;
            transition: .25s ease;
            box-sizing: border-box;
        }

            .search-box input::placeholder {
                color: #A48F7E;
            }

            .search-box input:focus {
                border-color: #B8894D;
                box-shadow: 0 0 0 4px rgba(184,137,77,.10);
                transform: translateY(-1px);
            }

    /* =========================================================
           CUSTOM DROPDOWN
           ========================================================= */

    .custom-select {
        position: relative;
        width: 100%;
    }

    .select-trigger {
        width: 100%;
        height: 54px;
        padding: 0 44px 0 17px;
        border: 1px solid #DFC8A7;
        border-radius: 16px;
        background: rgba(255,253,247,.96);
        color: #4B3832;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-align: left;
        font-family: Inter, Arial, sans-serif;
        font-size: 14px;
        cursor: pointer;
        outline: none;
        transition: border-color .25s ease, box-shadow .25s ease, background .25s ease, transform .25s ease;
    }

        .select-trigger:hover {
            border-color: #C89A5A;
            transform: translateY(-1px);
        }

    .custom-select.open .select-trigger {
        border-color: #B8894D;
        box-shadow: 0 0 0 4px rgba(184,137,77,.10);
        background: #FFFDF7;
    }

    .select-arrow {
        position: absolute;
        right: 17px;
        top: 50%;
        transform: translateY(-50%);
        color: #6F4E37;
        font-size: 12px;
        pointer-events: none;
        transition: transform .25s ease;
    }

    .custom-select.open .select-arrow {
        transform: translateY(-50%) rotate(180deg);
    }

    .select-menu {
        position: absolute;
        z-index: 100;
        left: 0;
        right: 0;
        top: calc(100% + 9px);
        max-height: 260px;
        overflow-y: auto;
        padding: 7px;
        border: 1px solid #DCC7AA;
        border-radius: 17px;
        background: rgba(255,253,247,.99);
        box-shadow: 0 18px 45px rgba(75,56,50,.16), 0 3px 8px rgba(75,56,50,.07);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px) scale(.98);
        transform-origin: top;
        transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
    }

    .custom-select.open .select-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
    }

    .select-menu::-webkit-scrollbar {
        width: 7px;
    }

    .select-menu::-webkit-scrollbar-track {
        background: #F5E6CA;
        border-radius: 20px;
    }

    .select-menu::-webkit-scrollbar-thumb {
        background: #B8894D;
        border-radius: 20px;
    }

    .select-option {
        width: 100%;
        min-height: 42px;
        border: 0;
        border-radius: 11px;
        background: transparent;
        padding: 0 13px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        color: #4B3832;
        font-family: Inter, Arial, sans-serif;
        font-size: 13px;
        text-align: left;
        cursor: pointer;
        transition: background .18s ease, color .18s ease, transform .18s ease;
    }

        .select-option:hover {
            background: #F5E6CA;
            color: #352822;
            transform: translateX(3px);
        }

        .select-option.selected {
            background: #6F4E37;
            color: #FFFDF7;
        }

            .select-option.selected::after {
                content: "\f00c";
                font-family: "Font Awesome 6 Free";
                font-weight: 900;
                font-size: 11px;
            }

    /* =========================================================
           APPLY BUTTON
           ========================================================= */

    .apply-wrapper {
        display: flex;
        align-items: end;
    }

    .apply-btn {
        height: 54px;
        min-width: 118px;
        padding: 0 24px;
        border: 0;
        border-radius: 16px;
        background: linear-gradient(135deg, #6F4E37, #4B3832);
        color: #FFFDF7;
        font-family: Inter, Arial, sans-serif;
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(75,56,50,.16);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .apply-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(75,56,50,.23);
        }

        .apply-btn:active {
            transform: translateY(-1px);
        }

        .apply-btn i {
            margin-right: 7px;
            font-size: 12px;
        }

    /* =========================================================
           CUSTOM DATE RANGE
           ========================================================= */

    .custom-date-panel {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        margin-top: -5px;
        transition: max-height .35s ease, opacity .3s ease, margin-top .35s ease;
    }

        .custom-date-panel.visible {
            max-height: 110px;
            opacity: 1;
            margin-top: 2px;
        }

    .date-field label {
        display: block;
        margin: 0 0 8px 3px;
        color: #8B7565;
        font-family: Inter, Arial, sans-serif;
        font-size: 12px;
        font-weight: 700;
    }

    .date-field input {
        width: 100%;
        height: 48px;
        padding: 0 14px;
        border-radius: 13px;
        border: 1px solid #DFC8A7;
        background: #FFFDF7;
        color: #4B3832;
        outline: none;
        box-sizing: border-box;
        font-family: Inter, Arial, sans-serif;
        transition: .25s ease;
    }

        .date-field input:focus {
            border-color: #B8894D;
            box-shadow: 0 0 0 4px rgba(184,137,77,.09);
        }

    /* =========================================================
           SECTION HEADINGS
           ========================================================= */

    .analytics-section {
        margin-bottom: 45px;
        animation: sectionIn .7s ease both;
    }

        .analytics-section:nth-of-type(2) {
            animation-delay: .08s;
        }

        .analytics-section:nth-of-type(3) {
            animation-delay: .15s;
        }

    @@keyframes sectionIn {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .section-heading {
        margin: 0 0 20px 2px;
    }

        .section-heading h2 {
            margin: 0;
            font-family: "Fraunces", Georgia, serif;
            font-size: 29px;
            line-height: 1.15;
            color: #352822;
            letter-spacing: -.6px;
        }

        .section-heading p {
            margin: 7px 0 0;
            color: #947C6A;
            font-family: Inter, Arial, sans-serif;
            font-size: 13px;
        }

    /* =========================================================
           STAT CARDS
           ========================================================= */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .stat-card {
        position: relative;
        min-height: 166px;
        padding: 22px;
        overflow: hidden;
        border-radius: 22px;
        border: 1px solid #E3CFAF;
        background: rgba(255,253,247,.90);
        box-shadow: 0 12px 32px rgba(75,56,50,.05);
        transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
    }

        .stat-card:hover {
            transform: translateY(-6px);
            border-color: #CFA66D;
            box-shadow: 0 20px 40px rgba(75,56,50,.11);
        }

        .stat-card::after {
            content: "";
            position: absolute;
            right: -24px;
            bottom: -28px;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: rgba(245,230,202,.76);
            pointer-events: none;
        }

    .stat-icon {
        width: 47px;
        height: 47px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #F5E6CA;
        color: #6F4E37;
        font-size: 17px;
        margin-bottom: 19px;
        transition: transform .3s ease;
    }

    .stat-card:hover .stat-icon {
        transform: rotate(-5deg) scale(1.07);
    }

    .stat-title {
        color: #8B7565;
        font-family: Inter, Arial, sans-serif;
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .stat-value {
        color: #352822;
        font-family: Inter, Arial, sans-serif;
        font-size: 30px;
        font-weight: 900;
        letter-spacing: -.8px;
    }

    .stat-subtitle {
        position: relative;
        z-index: 2;
        margin-top: 8px;
        color: #A18B79;
        font-family: Inter, Arial, sans-serif;
        font-size: 11px;
    }

    /* =========================================================
           RESTAURANT TABLE
           ========================================================= */

    .restaurant-table-card {
        overflow: hidden;
        border: 1px solid #DFC8A7;
        border-radius: 24px;
        background: rgba(255,253,247,.90);
        box-shadow: 0 14px 35px rgba(75,56,50,.05);
    }

    .table-scroll {
        width: 100%;
        overflow-x: auto;
    }

    .restaurant-table {
        width: 100%;
        min-width: 920px;
        border-collapse: collapse;
        font-family: Inter, Arial, sans-serif;
    }

        .restaurant-table thead th {
            padding: 19px 20px;
            text-align: left;
            color: #8B7565;
            background: rgba(245,230,202,.23);
            border-bottom: 1px solid #E4D2B8;
            font-size: 11px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .8px;
            white-space: nowrap;
        }

        .restaurant-table tbody tr {
            transition: background .2s ease;
        }

            .restaurant-table tbody tr:hover {
                background: rgba(245,230,202,.25);
            }

        .restaurant-table tbody td {
            padding: 20px;
            border-bottom: 1px solid #EDE0CD;
            color: #4B3832;
            font-size: 13px;
            vertical-align: middle;
        }

        .restaurant-table tbody tr:last-child td {
            border-bottom: 0;
        }

    .restaurant-name {
        color: #352822;
        font-weight: 850;
        font-size: 14px;
    }

    .owner-name {
        margin-top: 5px;
        color: #A08A78;
        font-size: 11px;
    }

    .revenue {
        color: #4B3832;
        font-size: 14px;
        font-weight: 900;
        white-space: nowrap;
    }

    .plan-text {
        color: #6F4E37;
        font-weight: 700;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 13px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 900;
        white-space: nowrap;
    }

        .status-badge::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

    .status-active {
        background: #E8EFDE;
        color: #60744D;
    }

        .status-active::before {
            background: #7F9158;
        }

    .status-expired {
        background: #F4E5E0;
        color: #9A5E4D;
    }

        .status-expired::before {
            background: #A86652;
        }

    .status-pending {
        background: #F8EEDB;
        color: #9A7544;
    }

        .status-pending::before {
            background: #C3944F;
        }

    .status-cancelled {
        background: #EEE6E2;
        color: #776158;
    }

        .status-cancelled::before {
            background: #776158;
        }

    .status-suspended {
        background: #E9E5EE;
        color: #685B77;
    }

        .status-suspended::before {
            background: #776B89;
        }

    .status-none {
        background: #F0ECE7;
        color: #8A786B;
    }

        .status-none::before {
            background: #A99B91;
        }

    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .empty-state {
        padding: 65px 25px;
        text-align: center;
    }

    .empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 15px;
        border-radius: 18px;
        background: #F5E6CA;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6F4E37;
        font-size: 19px;
    }

    .empty-state h3 {
        margin: 0;
        font-family: "Fraunces", Georgia, serif;
        font-size: 23px;
    }

    .empty-state p {
        margin: 8px 0 0;
        color: #96806F;
        font-family: Inter, Arial, sans-serif;
        font-size: 13px;
    }

    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 1200px) {
        .filter-card {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .filter-field:first-child {
            grid-column: 1 / -1;
        }

        .apply-wrapper {
            grid-column: 1 / -1;
        }

        .apply-btn {
            width: 100%;
        }

        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .report-page {
            padding: 82px 15px 70px;
        }

        .report-header {
            padding-left: 63px;
            margin-bottom: 28px;
        }

            .report-header::before {
                width: 48px;
                height: 48px;
                border-radius: 15px;
            }

            .report-header h1 {
                font-size: 37px;
                letter-spacing: -1px;
            }

            .report-header p {
                font-size: 13px;
                line-height: 1.5;
            }

        .filter-card {
            grid-template-columns: 1fr;
            padding: 20px;
            border-radius: 22px;
            gap: 15px;
        }

        .filter-field:first-child,
        .apply-wrapper {
            grid-column: auto;
        }

        .custom-date-panel {
            grid-template-columns: 1fr;
        }

            .custom-date-panel.visible {
                max-height: 190px;
            }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .stat-card {
            min-height: 150px;
        }

        .section-heading h2 {
            font-size: 25px;
        }

        .restaurant-table-card {
            border-radius: 20px;
        }
    }

    @@media (max-width: 480px) {
        .report-page {
            padding-left: 12px;
            padding-right: 12px;
        }

        .report-header h1 {
            font-size: 31px;
        }

        .filter-card {
            padding: 16px;
        }

        .stat-card {
            padding: 19px;
        }

        .stat-value {
            font-size: 27px;
        }
    }
</style>


<div class="report-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="report-header">
        <h1>Subscription Analytics</h1>
        <p>Monitor restaurant subscriptions, revenue and payment activity.</p>
    </div>


    <!-- =====================================================
         FILTERS
         ===================================================== -->

    <form method="get"
          asp-area="SuperAdmin"
          asp-controller="Reports"
          asp-action="Index"
          id="reportFilterForm">

        <div class="filter-card">

            <!-- SEARCH -->
            <div class="filter-field">

                <label class="filter-label">
                    Restaurant Search
                </label>

                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input type="text"
                           name="search"
                           value="@currentSearch"
                           placeholder="Search restaurant or plan..." />
                </div>

            </div>


            <!-- RESTAURANT -->
            <div class="filter-field">

                <label class="filter-label">
                    Restaurant
                </label>

                <div class="custom-select"
                     data-select="restaurant">

                    <input type="hidden"
                           name="restaurantId"
                           id="restaurantValue"
                           value="@(selectedRestaurantId?.ToString() ?? "")" />

                    <button type="button"
                            class="select-trigger">

                        <span class="selected-text">
                            @{
                                var selectedRestaurant = uniqueRestaurants
                                .FirstOrDefault(x => selectedRestaurantId.HasValue &&
                                x.Id == selectedRestaurantId.Value);
                            }

                            @(selectedRestaurant?.Name ?? "All Restaurants")
                        </span>

                        <i class="fa-solid fa-chevron-down select-arrow"></i>

                    </button>

                    <div class="select-menu">

                        <button type="button"
                                class="select-option @(selectedRestaurantId == null ? "selected" : "")"
                                data-value="">

                            <span>All Restaurants</span>

                        </button>

                        @foreach (var restaurant in uniqueRestaurants)
                        {
                            <button type="button"
                                    class="select-option @(selectedRestaurantId == restaurant.Id ? "selected" : "")"
                                    data-value="@restaurant.Id">

                                <span>@restaurant.Name</span>

                            </button>
                        }

                    </div>

                </div>

            </div>


            <!-- STATUS -->
            <div class="filter-field">

                <label class="filter-label">
                    Status
                </label>

                <div class="custom-select"
                     data-select="status">

                    <input type="hidden"
                           name="status"
                           id="statusValue"
                           value="@currentStatus" />

                    <button type="button"
                            class="select-trigger">

                        <span class="selected-text">

                            @{
                                var statusDisplay = currentStatus switch
                                {
                                    "Active" => "Active",
                                    "Expired" => "Expired",
                                    "Pending" => "Pending",
                                    "Cancelled" => "Cancelled",
                                    "Suspended" => "Suspended",
                                    _ => "All Status"
                                };
                            }

                            @statusDisplay

                        </span>

                        <i class="fa-solid fa-chevron-down select-arrow"></i>

                    </button>

                    <div class="select-menu">

                        <button type="button"
                                class="select-option @(string.IsNullOrEmpty(currentStatus) ? "selected" : "")"
                                data-value="">
                            <span>All Status</span>
                        </button>

                        <button type="button"
                                class="select-option @(currentStatus == "Active" ? "selected" : "")"
                                data-value="Active">
                            <span>Active</span>
                        </button>

                        <button type="button"
                                class="select-option @(currentStatus == "Expired" ? "selected" : "")"
                                data-value="Expired">
                            <span>Expired</span>
                        </button>

                        <button type="button"
                                class="select-option @(currentStatus == "Pending" ? "selected" : "")"
                                data-value="Pending">
                            <span>Pending</span>
                        </button>

                        <button type="button"
                                class="select-option @(currentStatus == "Cancelled" ? "selected" : "")"
                                data-value="Cancelled">
                            <span>Cancelled</span>
                        </button>

                        <button type="button"
                                class="select-option @(currentStatus == "Suspended" ? "selected" : "")"
                                data-value="Suspended">
                            <span>Suspended</span>
                        </button>

                    </div>

                </div>

            </div>


            <!-- DATE RANGE -->
            <div class="filter-field">

                <label class="filter-label">
                    Date Range
                </label>

                <div class="custom-select"
                     data-select="date">

                    <input type="hidden"
                           name="dateRange"
                           id="dateRangeValue"
                           value="@currentDateRange" />

                    <button type="button"
                            class="select-trigger">

                        <span class="selected-text">

                            @{
                                var dateDisplay = currentDateRange switch
                                {
                                    "today" => "Today",
                                    "7days" => "Last 7 Days",
                                    "30days" => "Last 30 Days",
                                    "month" => "This Month",
                                    "custom" => "Custom Range",
                                    _ => "All Time"
                                };
                            }

                            @dateDisplay

                        </span>

                        <i class="fa-solid fa-chevron-down select-arrow"></i>

                    </button>

                    <div class="select-menu">

                        <button type="button"
                                class="select-option @(currentDateRange == "all" ? "selected" : "")"
                                data-value="all">
                            <span>All Time</span>
                        </button>

                        <button type="button"
                                class="select-option @(currentDateRange == "today" ? "selected" : "")"
                                data-value="today">
                            <span>Today</span>
                        </button>

                        <button type="button"
                                class="select-option @(currentDateRange == "7days" ? "selected" : "")"
                                data-value="7days">
                            <span>Last 7 Days</span>
                        </button>

                        <button type="button"
                                class="select-option @(currentDateRange == "30days" ? "selected" : "")"
                                data-value="30days">
                            <span>Last 30 Days</span>
                        </button>

                        <button type="button"
                                class="select-option @(currentDateRange == "month" ? "selected" : "")"
                                data-value="month">
                            <span>This Month</span>
                        </button>

                        <button type="button"
                                class="select-option @(currentDateRange == "custom" ? "selected" : "")"
                                data-value="custom">
                            <span>Custom Range</span>
                        </button>

                    </div>

                </div>

            </div>


            <!-- APPLY -->
            <div class="apply-wrapper">

                <button type="submit"
                        class="apply-btn">

                    <i class="fa-solid fa-filter"></i>
                    Apply

                </button>

            </div>


            <!-- CUSTOM DATES -->
            <div class="custom-date-panel @(currentDateRange == "custom" ? "visible" : "")"
                 id="customDatePanel">

                <div class="date-field">

                    <label>
                        From Date
                    </label>

                    <input type="date"
                           name="fromDate"
                           value="@Context.Request.Query["fromDate"]" />

                </div>

                <div class="date-field">

                    <label>
                        To Date
                    </label>

                    <input type="date"
                           name="toDate"
                           value="@Context.Request.Query["toDate"]" />

                </div>

            </div>

        </div>

    </form>


