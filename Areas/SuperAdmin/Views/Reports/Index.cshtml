@model RestaurantQR.ViewModels.SubscriptionReportViewModel

@{
    ViewData["Title"] = "Subscription Reports";

    var restaurants =
        ViewBag.Restaurants
        as List<RestaurantQR.Models.Restaurant>
        ?? new List<RestaurantQR.Models.Restaurant>();

    int? selectedRestaurantId =
        ViewBag.SelectedRestaurantId as int?;

    var totalSubscriptions = Model.TotalSubscriptions;
    var activeSubscriptions = Model.ActiveSubscriptions;
    var expiredSubscriptions = Model.ExpiredSubscriptions;
    var pendingSubscriptions = Model.PendingSubscriptions;

    double activePercent = totalSubscriptions > 0
        ? (double)activeSubscriptions / totalSubscriptions * 100
        : 0;

    double expiredPercent = totalSubscriptions > 0
        ? (double)expiredSubscriptions / totalSubscriptions * 100
        : 0;

    double pendingPercent = totalSubscriptions > 0
        ? (double)pendingSubscriptions / totalSubscriptions * 100
        : 0;

    decimal averageRevenue = totalSubscriptions > 0
        ? Model.TotalRevenue / totalSubscriptions
        : 0;

    var today = DateTime.Now;

    var expiringSoonCount = Model.Restaurants.Count(x =>
        x.CurrentEndDate.HasValue &&
        x.CurrentEndDate.Value.ToLocalTime() > today &&
        x.CurrentEndDate.Value.ToLocalTime() <= today.AddDays(30));

    var noPlanCount = Model.Restaurants.Count(x =>
        string.IsNullOrWhiteSpace(x.CurrentPlan));

    var activeRestaurantCount = Model.Restaurants.Count(x =>
        x.CurrentStatus == SubscriptionStatus.Active);

    var restaurantCount = Model.Restaurants.Count;

    double activeRestaurantPercent = restaurantCount > 0
        ? (double)activeRestaurantCount / restaurantCount * 100
        : 0;

    var planGroups = Model.Restaurants
        .Where(x => !string.IsNullOrWhiteSpace(x.CurrentPlan))
        .GroupBy(x => x.CurrentPlan)
        .OrderByDescending(x => x.Count())
        .Take(5)
        .ToList();

    var maxPlanCount = planGroups.Any()
        ? planGroups.Max(x => x.Count())
        : 1;
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    /* =========================================================
           PAGE
           ========================================================= */

    .report-page {
        padding: 120px 28px 65px;
        max-width: 1500px;
