            transform: scale(1.35);
        }

        .stat-card:nth-child(2) {
            animation-delay: .06s;
        }

        .stat-card:nth-child(3) {
            animation-delay: .12s;
        }

        .stat-card:nth-child(4) {
            animation-delay: .18s;
        }

        .stat-card:nth-child(5) {
            animation-delay: .24s;
        }

        .stat-card:nth-child(6) {
            animation-delay: .30s;
        }

