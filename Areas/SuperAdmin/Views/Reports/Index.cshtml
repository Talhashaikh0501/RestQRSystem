            transform: translateY(-6px);
            box-shadow: 0 22px 50px rgba(75,56,50,.14);
        }

        .stat-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient( 90deg, #6F4E37, #B8894D, transparent );
