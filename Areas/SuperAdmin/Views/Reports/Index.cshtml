        <div class="restaurant-table-card">

            <div class="table-scroll">

                @if (Model.Restaurants != null && Model.Restaurants.Any())
                {
                    <table class="restaurant-table">

                        <thead>

                            <tr>

                                <th>
                                    Restaurant
                                </th>

                                <th>
                                    Paid Subscriptions
                                </th>

                                <th>
                                    Total Subscriptions
                                </th>

                                <th>
                                    Current Plan
                                </th>

                                <th>
