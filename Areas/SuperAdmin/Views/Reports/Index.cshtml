<script>
    document.addEventListener("DOMContentLoaded", function () {

        const customSelects = document.querySelectorAll(".custom-select");

        /*
         * =====================================================
         * CUSTOM DROPDOWN
         * =====================================================
         */

        customSelects.forEach(function (select) {

            const trigger = select.querySelector(".select-trigger");
            const menu = select.querySelector(".select-menu");
            const options = select.querySelectorAll(".select-option");
            const hiddenInput = select.querySelector("input[type='hidden']");
            const selectedText = select.querySelector(".selected-text");

            trigger.addEventListener("click", function (event) {

                event.stopPropagation();

                customSelects.forEach(function (other) {

                    if (other !== select) {
                        other.classList.remove("open");
                    }

                });

                select.classList.toggle("open");

            });


            options.forEach(function (option) {

                option.addEventListener("click", function (event) {

                    event.stopPropagation();

                    const value = option.dataset.value;
                    const text = option.querySelector("span").textContent.trim();

                    hiddenInput.value = value;
                    selectedText.textContent = text;

                    options.forEach(function (item) {
                        item.classList.remove("selected");
                    });

                    option.classList.add("selected");

                    select.classList.remove("open");


                    /*
                     * Custom date range open/close
                     */

                    if (select.dataset.select === "date") {

                        const datePanel =
                            document.getElementById("customDatePanel");

                        if (value === "custom") {
                            datePanel.classList.add("visible");
                        }
                        else {
                            datePanel.classList.remove("visible");
                        }

                    }

                });

            });

        });


        /*
         * =====================================================
         * CLOSE DROPDOWNS OUTSIDE CLICK
         * =====================================================
         */

        document.addEventListener("click", function () {

            customSelects.forEach(function (select) {
                select.classList.remove("open");
            });

        });


        /*
         * =====================================================
         * ESCAPE KEY
         * =====================================================
         */

        document.addEventListener("keydown", function (event) {

            if (event.key === "Escape") {

                customSelects.forEach(function (select) {
                    select.classList.remove("open");
                });

            }

        });


        /*
         * =====================================================
         * FILTER FORM
         * =====================================================
         */

        const form = document.getElementById("reportFilterForm");

        form.addEventListener("submit", function () {

            const dateValue =
                document.getElementById("dateRangeValue").value;

            const fromDate =
                document.querySelector("input[name='fromDate']");

            const toDate =
                document.querySelector("input[name='toDate']");


            /*
             * Custom range validation
             */

            if (dateValue === "custom") {

                if (!fromDate.value || !toDate.value) {

                    alert("Please select both From Date and To Date.");

                    event.preventDefault();

                    return;
                }

                if (fromDate.value > toDate.value) {

                    alert("From Date cannot be after To Date.");

                    event.preventDefault();

                    return;
                }

            }
            else {

                /*
                 * Prevent old custom dates from affecting
                 * normal date range requests.
                 */

                fromDate.value = "";
                toDate.value = "";

            }

        });

    });
</script>