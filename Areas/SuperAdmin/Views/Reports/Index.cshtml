    /* =========================================================
           ANIMATIONS
           ========================================================= */

    @@keyframes pageReveal {

        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeUp {

        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cardUp {

        from {
            opacity: 0;
            transform: translateY(25px) scale(.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes progressGrow {

        from {
            width: 0;
        }
    }

    @@keyframes chartReveal {

        from {
            opacity: 0;
            transform: scale(.75) rotate(-20deg);
        }

        to {
            opacity: 1;
            transform: scale(1) rotate(0);
        }
    }

    @@keyframes livePulse {

        0%, 100% {
            box-shadow: 0 0 0 4px rgba(127,145,88,.10);
        }

        50% {
            box-shadow: 0 0 0 8px rgba(127,145,88,.02);
        }
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1300px) {

        .stats-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .analytics-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .analytics-card:nth-child(3) {
            grid-column: span 2;
        }
    }


    @@media (max-width: 900px) {

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .analytics-grid {
            grid-template-columns: 1fr;
        }

        .analytics-card:nth-child(3) {
            grid-column: auto;
        }

        .insight-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 768px) {

        .report-page {
            padding: 108px 15px 45px;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 11px;
        }

        .stat-card {
            min-height: 145px;
            padding: 17px;
        }

        .stat-value {
            font-size: 23px;
        }

        .analytics-card {
            padding: 18px;
            border-radius: 20px;
        }

        .health-layout {
            gap: 18px;
        }

        .health-chart {
            width: 115px;
            height: 115px;
        }

            .health-chart::after {
                width: 78px;
                height: 78px;
            }

        .report-card {
            padding: 17px;
            border-radius: 21px;
        }

        .report-card-header {
            align-items: stretch;
            flex-direction: column;
        }

        .table-tools {
            width: 100%;
            margin-left: 0;
            flex-direction: column;
            align-items: stretch;
        }

        .search-box {
            width: 100%;
        }

        .restaurant-filter {
            width: 100%;
        }

        .report-count {
            align-self: flex-start;
        }
    }


    @@media (max-width: 480px) {

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .page-header-left h1 {
            font-size: 30px;
        }

        .health-layout {
            flex-direction: column;
            align-items: stretch;
        }

        .health-chart {
            margin: auto;
        }

        .revenue-mini-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

</style>


<div class="report-page">

    <div class="report-container">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <div class="page-header-left">

                <h1>
                    Subscription Reports
                </h1>

                <p>
                    Monitor restaurant subscriptions, revenue,
                    plans and account activity from one place.
                </p>

            </div>

            <div class="live-indicator">

                <span class="live-dot"></span>

                Live Analytics

            </div>

        </div>


        <!-- =====================================================
             PRIMARY ANALYTICS
             ===================================================== -->

        <div class="stats-grid">


            <div class="stat-card">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="fa-solid fa-store"></i>
                    </div>

                    <span class="stat-tag">
                        Overview
                    </span>

                </div>

                <div class="stat-label">
                    Total Restaurants
                </div>

                <div class="stat-value">
                    @Model.TotalRestaurants
                </div>

                <div class="stat-description">
                    Registered restaurants
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="fa-solid fa-credit-card"></i>
                    </div>

                    <span class="stat-tag">
                        Plans
                    </span>

                </div>

                <div class="stat-label">
                    Total Subscriptions
                </div>

                <div class="stat-value">
                    @Model.TotalSubscriptions
                </div>

                <div class="stat-description">
                    All subscription records
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                    <span class="stat-tag">
                        Live
                    </span>

                </div>

                <div class="stat-label">
                    Active
                </div>

                <div class="stat-value">
                    @Model.ActiveSubscriptions
                </div>

                <div class="stat-description">
                    Currently active plans
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>

                    <span class="stat-tag">
                        History
                    </span>

                </div>

                <div class="stat-label">
                    Expired
                </div>

                <div class="stat-value">
                    @Model.ExpiredSubscriptions
                </div>

                <div class="stat-description">
                    Expired subscriptions
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>

                    <span class="stat-tag">
                        Waiting
                    </span>

                </div>

                <div class="stat-label">
                    Pending
                </div>

                <div class="stat-value">
                    @Model.PendingSubscriptions
                </div>

                <div class="stat-description">
                    Awaiting confirmation
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="fa-solid fa-indian-rupee-sign"></i>
                    </div>

                    <span class="stat-tag">
                        Finance
                    </span>

                </div>

                <div class="stat-label">
                    Total Revenue
                </div>

                <div class="stat-value">
                    ₹@Model.TotalRevenue.ToString("N0")
                </div>

                <div class="stat-description">
                    Subscription revenue
                </div>

            </div>

        </div>


        <!-- =====================================================
             ADVANCED ANALYTICS
             ===================================================== -->

        <div class="analytics-grid">


            <!-- SUBSCRIPTION HEALTH -->

            <div class="analytics-card">

                <div class="analytics-card-header">

                    <div class="analytics-icon">
                        <i class="fa-solid fa-chart-pie"></i>
                    </div>

                    <div>

                        <h3>
                            Subscription Health
                        </h3>

                        <span>
                            Current status distribution
                        </span>

                    </div>

                </div>


                <div class="health-layout">


                    <div class="health-chart">

                        <div class="health-chart-center">

                            <strong>
                                @totalSubscriptions
                            </strong>

                            <span>
                                Total
                            </span>

                        </div>

                    </div>


                    <div class="health-list">


                        <div class="health-item">

                            <div class="health-item-top">

                                <div class="health-name">

                                    <span class="health-dot dot-active"></span>

                                    Active

                                </div>

                                <span class="health-number">
                                    @activeSubscriptions
                                </span>

                            </div>

                            <div class="mini-progress">

                                <span class="progress-active"></span>

                            </div>

                        </div>


                        <div class="health-item">

                            <div class="health-item-top">

                                <div class="health-name">

                                    <span class="health-dot dot-expired"></span>

                                    Expired

                                </div>

                                <span class="health-number">
                                    @expiredSubscriptions
                                </span>

                            </div>

                            <div class="mini-progress">

                                <span class="progress-expired"></span>

                            </div>

                        </div>


                        <div class="health-item">

                            <div class="health-item-top">

                                <div class="health-name">

                                    <span class="health-dot dot-pending"></span>

                                    Pending

                                </div>

                                <span class="health-number">
                                    @pendingSubscriptions
                                </span>

                            </div>

                            <div class="mini-progress">

                                <span class="progress-pending"></span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- REVENUE INTELLIGENCE -->

            <div class="analytics-card">

                <div class="analytics-card-header">

                    <div class="analytics-icon">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>

                    <div>

                        <h3>
                            Revenue Intelligence
                        </h3>

                        <span>
                            Financial subscription overview
                        </span>

                    </div>

                </div>


                <div class="revenue-main">

                    <div class="revenue-label">
                        Total Revenue
                    </div>

                    <div class="revenue-value">
                        ₹@Model.TotalRevenue.ToString("N0")
                    </div>

                    <div class="revenue-growth">

                        <i class="fa-solid fa-arrow-trend-up"></i>

                        Subscription revenue generated

                    </div>

                </div>


                <div class="revenue-mini-grid">


                    <div class="revenue-mini">

                        <div class="revenue-mini-label">
                            Average / Subscription
                        </div>

                        <div class="revenue-mini-value">
                            ₹@averageRevenue.ToString("N0")
                        </div>

                    </div>


                    <div class="revenue-mini">

                        <div class="revenue-mini-label">
                            Total Plans
                        </div>

                        <div class="revenue-mini-value">
                            @totalSubscriptions
                        </div>

                    </div>

                </div>

            </div>


            <!-- PLAN DISTRIBUTION -->

            <div class="analytics-card">

                <div class="analytics-card-header">

                    <div class="analytics-icon">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>

                    <div>

                        <h3>
                            Plan Distribution
                        </h3>

                        <span>
                            Most used subscription plans
                        </span>

                    </div>

                </div>


                @if (planGroups.Any())
                {

                    @foreach (var plan in planGroups)
                    {

                        var planWidth =
                        (double)plan.Count() /
                        maxPlanCount * 100;

                        <div class="plan-row">

                            <div class="plan-top">

                                <span class="plan-name">
                                    @plan.Key
                                </span>

                                <span class="plan-count">
                                    @plan.Count()
                                </span>

                            </div>

                            <div class="plan-track">

                                <span style="width:@planWidth.ToString("0.##")%;"></span>

                            </div>

                        </div>

                    }

                }
                else
                {

                    <div class="no-plan-message">

                        <i class="fa-solid fa-chart-column"></i>

                        <div style="margin-top:8px;">
                            No plan data available
                        </div>

                    </div>

                }

            </div>

        </div>


        <!-- =====================================================
             BUSINESS INSIGHTS
             ===================================================== -->

        <div class="insight-grid">


            <div class="insight-card">

                <div class="insight-icon">

                    <i class="fa-solid fa-chart-simple"></i>

                </div>

                <div class="insight-content">

                    <span>
                        Restaurant Activation
                    </span>

                    <strong>
                        @activeRestaurantPercent.ToString("0.0")%
                    </strong>

                </div>

            </div>


            <div class="insight-card">

                <div class="insight-icon">

                    <i class="fa-solid fa-calendar-days"></i>

                </div>

                <div class="insight-content">

                    <span>
                        Expiring Within 30 Days
                    </span>

                    <strong>
                        @expiringSoonCount
                    </strong>

                </div>

            </div>


            <div class="insight-card">

                <div class="insight-icon">

                    <i class="fa-solid fa-store-slash"></i>

                </div>

                <div class="insight-content">

                    <span>
                        Restaurants Without Plan
                    </span>

                    <strong>
                        @noPlanCount
                    </strong>

                </div>

            </div>

        </div>


        <!-- =====================================================
             RESTAURANT SUBSCRIPTION OVERVIEW
             ===================================================== -->

        <div class="report-card">


            <div class="report-card-header">


                <div class="report-title-area">

                    <h2>
                        Restaurant Subscription Overview
                    </h2>

                    <p>
                        Search and filter individual restaurant
                        subscription activity.
                    </p>

                </div>


                <!-- SEARCH + DROPDOWN + COUNT -->

                <div class="table-tools">


                    <!-- SEARCH -->

                    <div class="search-box"
                         id="searchBox">

                        <i class="fa-solid fa-magnifying-glass"></i>

                        <input type="text"
                               id="restaurantSearch"
                               placeholder="Search restaurant..."
                               autocomplete="off" />

                        <button type="button"
                                class="clear-search"
                                id="clearSearch">

                            <i class="fa-solid fa-xmark"></i>

                        </button>

                    </div>


                    <!-- RESTAURANT FILTER -->

                    <form method="get"
                          asp-area="SuperAdmin"
                          asp-controller="Reports"
                          asp-action="Index">

                        <select name="restaurantId"
                                class="restaurant-filter"
                                onchange="this.form.submit()">

                            <option value="">
                                All Restaurants
                            </option>

                            @foreach (var restaurant in restaurants)
                            {

                                if (selectedRestaurantId == restaurant.Id)
                                {

                                    <option value="@restaurant.Id"
                                            selected>

                                        @restaurant.Name

                                    </option>

                                }
                                else
                                {

                                    <option value="@restaurant.Id">

                                        @restaurant.Name

                                    </option>

                                }

                            }

                        </select>

                    </form>


                    <!-- COUNT -->

                    <span class="report-count"
                          id="reportCount">

                        @Model.Restaurants.Count restaurants

                    </span>

                </div>

            </div>


            @if (Model.Restaurants.Any())
            {

                <div class="table-wrap">


                    <table class="report-table"
                           id="restaurantTable">


                        <thead>

                            <tr>

                                <th>
                                    Restaurant
                                </th>

                                <th>
                                    Owner
                                </th>

                                <th>
                                    Subscriptions
                                </th>

                                <th>
                                    Current Plan
                                </th>

                                <th>
                                    Paid Amount
                                </th>

                                <th>
                                    Start
                                </th>

                                <th>
                                    End
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var restaurant in Model.Restaurants)
                            {

                                <tr class="restaurant-row">


                                    <td>

                                        <div class="restaurant-name">

                                            @restaurant.RestaurantName

                                        </div>

                                    </td>


                                    <td>

                                        <div class="owner-info">

                                            <span class="owner-name">

                                                @(restaurant.OwnerName
                                                                                        ?? "Not Available")

                                    </span>


                                    @if (!string.IsNullOrWhiteSpace(
                                                                        restaurant.OwnerEmail))
                                            {

                                                <span class="owner-email">

                                                    @restaurant.OwnerEmail

                                                </span>

                                            }

                                        </div>

                                    </td>


                                    <td>

                                        <strong>

                                            @restaurant.TotalSubscriptions

                                        </strong>


                                        @if (restaurant.ExpiredSubscriptions > 0)
                                        {

                                            <small style="
                                                            display:block;
                                                            color:#9B493D;
                                                            margin-top:3px;">

                                                @restaurant.ExpiredSubscriptions
                                                expired

                                            </small>

                                        }

                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                                                        restaurant.CurrentPlan))
                                        {

                                            <span class="plan-pill">

                                                @restaurant.CurrentPlan

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="status-pill status-none">

                                                No active plan

                                            </span>

                                        }

                                    </td>


                                    <td>

                                        <span class="amount">

                                            ₹@restaurant.TotalAmount.ToString("N0")

                                        </span>

                                    </td>


                                    <td>

                                        @if (restaurant.CurrentStartDate.HasValue)
                                        {

                                            <span class="date-text">

                                                @(restaurant.CurrentStartDate
                                                                                    .Value
                                                                                    .ToLocalTime()
                                                                                    .ToString("dd MMM yyyy"))

                                </span>

                                                                }
                                        else
                                        {

                                            <span class="date-text">
                                                —
                                            </span>

                                        }

                                    </td>


                                    <td>

                                        @if (restaurant.CurrentEndDate.HasValue)
                                        {

                                            <span class="date-text">

                                                @(restaurant.CurrentEndDate
                                                                                    .Value
                                                                                    .ToLocalTime()
                                                                                    .ToString("dd MMM yyyy"))

                                </span>

                                                                }
                                        else
                                        {

                                            <span class="date-text">
                                                —
                                            </span>

                                        }

                                    </td>


                                    <td>

                                        @if (restaurant.CurrentStatus ==
                                                                        SubscriptionStatus.Active)
                                        {

                                            <span class="status-pill status-active">

                                                <i class="fa-solid fa-circle"
                                                   style="font-size:5px;"></i>

                                                Active

                                            </span>

                                        }
                                        else if (restaurant.CurrentStatus ==
                                        SubscriptionStatus.Expired)
                                        {

                                            <span class="status-pill status-expired">

                                                <i class="fa-solid fa-circle"
                                                   style="font-size:5px;"></i>

                                                Expired

                                            </span>

                                        }
                                        else if (restaurant.CurrentStatus ==
                                        SubscriptionStatus.Pending)
                                        {

                                            <span class="status-pill status-pending">

                                                <i class="fa-solid fa-circle"
                                                   style="font-size:5px;"></i>

                                                Pending

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="status-pill status-none">

                                                —

                                            </span>

                                        }

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>


                    <!-- SEARCH EMPTY -->

                    <div class="search-empty"
                         id="searchEmpty">

                        <div class="search-empty-icon">

                            <i class="fa-solid fa-magnifying-glass"></i>

                        </div>

                        <h4>
                            No restaurant found
                        </h4>

                        <p>
                            Try another restaurant name.
                        </p>

                    </div>

                </div>

            }
            else
            {

                <div class="empty-report">

                    <div class="empty-report-icon">

                        <i class="fa-solid fa-chart-pie"></i>

                    </div>

                    <h4>
                        No restaurant data found
                    </h4>

                    <p>
                        There are no restaurants matching
                        the selected filter.
                    </p>

                </div>

            }

        </div>

    </div>

</div>


<!-- =========================================================
     SEARCH
     ========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const input =
            document.getElementById("restaurantSearch");

        const clear =
            document.getElementById("clearSearch");

        const searchBox =
            document.getElementById("searchBox");

        const table =
            document.getElementById("restaurantTable");

        const empty =
            document.getElementById("searchEmpty");

        const count =
            document.getElementById("reportCount");


        if (!input || !table) {
            return;
        }


        const rows =
            table.querySelectorAll(".restaurant-row");


        function performSearch() {

            const value =
                input.value
                    .trim()
                    .toLowerCase();


            let visible = 0;


            rows.forEach(function (row) {

                const nameElement =
                    row.querySelector(".restaurant-name");


                if (!nameElement) {
                    return;
                }


                const name =
                    nameElement.textContent
                        .trim()
                        .toLowerCase();


                if (
                    value === "" ||
                    name.includes(value)
                ) {

                    row.classList.remove(
                        "search-hidden"
                    );

                    visible++;

                }
                else {

                    row.classList.add(
                        "search-hidden"
                    );

                }

            });


            if (value.length > 0) {

                searchBox.classList.add(
                    "has-value"
                );

            }
            else {

                searchBox.classList.remove(
                    "has-value"
                );

            }


            count.textContent =
                visible +
                (
                    visible === 1
                        ? " restaurant"
                        : " restaurants"
                );


            count.classList.add("bump");

            setTimeout(function () {

                count.classList.remove("bump");

            }, 180);


            if (
                value !== "" &&
                visible === 0
            ) {

                empty.classList.add("show");

            }
            else {

                empty.classList.remove("show");

            }

        }


        input.addEventListener(
            "input",
            performSearch
        );


        clear.addEventListener(
            "click",
            function () {

                input.value = "";

                performSearch();

                input.focus();

            }
        );


        input.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Escape") {

                    input.value = "";

                    performSearch();

                }

            }
        );

    });

</script>