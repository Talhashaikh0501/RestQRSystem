@model RestaurantQR.ViewModels.ResetAdminPasswordViewModel

@{
    ViewData["Title"] = "Change Admin Password";
}

<style>

    /* =========================================================
           RESTAURANT QR
           SUPER ADMIN - RESET ADMIN PASSWORD
           LUXURY COFFEE THEME
           ========================================================= */

    .reset-password-page {
        --rq-white: #FFFDF7;
        --rq-cream: #F5E6CA;
        --rq-beige: #DCC7AA;
        --rq-coffee: #6F4E37;
        --rq-espresso: #4B3832;
        --rq-deep: #352822;
        --rq-gold: #B8894D;
        --rq-muted: #8B7565;
        --rq-danger: #915044;
        position: relative;
        width: min(920px, calc(100% - 40px));
        margin: 0 auto;
        color: var(--rq-espresso);
        animation: resetFadeUp .65s ease both;
    }


    /* =========================================================
           HERO
           ========================================================= */

    .reset-hero {
        margin-bottom: 32px;
    }

    .reset-eyebrow {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 15px;
        color: var(--rq-coffee);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 4px;
        text-transform: uppercase;
    }

        .reset-eyebrow::before {
            content: "";
            width: 45px;
            height: 1px;
            background: var(--rq-gold);
        }

    .reset-title {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(44px, 6vw, 72px);
        font-weight: 400;
        line-height: .97;
        letter-spacing: -3px;
        color: var(--rq-espresso);
    }

        .reset-title em {
            color: var(--rq-coffee);
            font-style: italic;
            font-weight: 400;
        }

    .reset-description {
        max-width: 650px;
        margin: 17px 0 0;
        color: var(--rq-muted);
        font-size: 14px;
        line-height: 1.8;
    }


    /* =========================================================
           MAIN CARD
           ========================================================= */

    .reset-card {
        position: relative;
        overflow: hidden;
        padding: 34px;
        border: 1px solid rgba(255,255,255,.95);
        border-radius: 30px;
        background: linear-gradient( 135deg, rgba(255,253,247,.90), rgba(245,230,202,.58) );
        box-shadow: 0 24px 70px rgba(75,56,50,.10);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

        .reset-card::before {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            right: -85px;
            top: -85px;
            border-radius: 50%;
            background: rgba(220,199,170,.28);
            pointer-events: none;
        }

        .reset-card::after {
            content: "";
            position: absolute;
            width: 140px;
            height: 140px;
            left: -70px;
            bottom: -70px;
            border-radius: 50%;
            background: rgba(184,137,77,.07);
            pointer-events: none;
        }


    /* =========================================================
           CARD HEADER
           ========================================================= */

    .reset-card-header {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 24px;
        margin-bottom: 26px;
        border-bottom: 1px solid rgba(75,56,50,.10);
    }

    .reset-card-heading {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .reset-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        background: var(--rq-coffee);
        color: var(--rq-white);
        font-size: 21px;
        box-shadow: 0 12px 28px rgba(111,78,55,.20);
    }

    .reset-card-heading h2 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 24px;
        font-weight: 400;
        color: var(--rq-espresso);
    }

    .reset-card-heading span {
        display: block;
        margin-top: 4px;
        color: var(--rq-muted);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .reset-security-label {
        color: var(--rq-gold);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }


    /* =========================================================
           ADMIN EMAIL
           ========================================================= */

    .admin-email-box {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
        padding: 17px 18px;
        border: 1px solid rgba(111,78,55,.12);
        border-radius: 17px;
        background: rgba(245,230,202,.34);
    }

    .admin-email-label {
        color: var(--rq-muted);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .admin-email-value {
        max-width: 65%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--rq-coffee);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 17px;
    }


    /* =========================================================
           FORM
           ========================================================= */

    .reset-form {
        position: relative;
        z-index: 2;
    }

    .reset-form-group {
        margin-bottom: 22px;
    }

    .reset-label {
        display: block;
        margin-bottom: 9px;
        color: var(--rq-espresso);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

        .reset-label::before {
            content: "•";
            margin-right: 7px;
            color: var(--rq-gold);
        }


    /* =========================================================
           PASSWORD FIELD
           ========================================================= */

    .password-field {
        position: relative;
    }

    .reset-input {
        width: 100%;
        min-height: 58px;
        padding: 14px 52px 14px 17px;
        border: 1px solid rgba(111,78,55,.16);
        border-radius: 15px;
        outline: none;
        background: rgba(255,255,255,.72);
        color: var(--rq-espresso);
        font-size: 14px;
        transition: border-color .25s ease, box-shadow .25s ease, background .25s ease, transform .25s ease;
    }

        .reset-input:hover {
            background: rgba(255,255,255,.91);
            border-color: rgba(111,78,55,.25);
        }

        .reset-input:focus {
            background: var(--rq-white);
            border-color: var(--rq-gold);
            box-shadow: 0 0 0 4px rgba(184,137,77,.10), 0 10px 28px rgba(75,56,50,.07);
            transform: translateY(-1px);
        }

        .reset-input::placeholder {
            color: #AF9987;
        }


    /* =========================================================
           SHOW PASSWORD BUTTON
           ========================================================= */

    .password-toggle {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 12px;
        background: transparent;
        color: var(--rq-coffee);
        cursor: pointer;
        font-size: 14px;
        transition: background .2s ease, transform .2s ease;
    }

        .password-toggle:hover {
            background: rgba(220,199,170,.28);
            transform: translateY(-50%) scale(1.04);
        }


    /* =========================================================
           VALIDATION
           ========================================================= */

    .reset-validation-summary {
        margin-bottom: 20px;
        padding: 13px 15px;
        border: 1px solid rgba(145,80,68,.15);
        border-radius: 13px;
        background: rgba(145,80,68,.06);
        color: var(--rq-danger);
        font-size: 12px;
    }

    .reset-validation {
        display: block;
        margin-top: 7px;
        color: var(--rq-danger);
        font-size: 11px;
    }


    /* =========================================================
           PASSWORD INFO
           ========================================================= */

    .password-info {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin: 6px 0 25px;
    }

    .password-info-item {
        padding: 12px;
        border-radius: 13px;
        background: rgba(245,230,202,.30);
        color: var(--rq-muted);
        font-size: 10px;
        line-height: 1.5;
    }

        .password-info-item strong {
            display: block;
            margin-bottom: 3px;
            color: var(--rq-coffee);
            font-size: 10px;
        }


    /* =========================================================
           FOOTER ACTIONS
           ========================================================= */

    .reset-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-top: 28px;
        padding-top: 24px;
        border-top: 1px solid rgba(75,56,50,.10);
    }

    .reset-back-btn,
    .reset-submit-btn {
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 21px;
        border-radius: 27px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: transform .25s ease, background .25s ease, color .25s ease, box-shadow .25s ease;
    }

    .reset-back-btn {
        border: 1px solid rgba(111,78,55,.16);
        background: rgba(255,253,247,.65);
        color: var(--rq-coffee);
    }

        .reset-back-btn:hover {
            color: var(--rq-white);
            background: var(--rq-coffee);
            transform: translateX(-2px);
        }

    .reset-submit-btn {
        border: 0;
        background: linear-gradient( 135deg, var(--rq-espresso), var(--rq-coffee) );
        color: var(--rq-white);
        cursor: pointer;
        box-shadow: 0 12px 28px rgba(75,56,50,.18);
    }

        .reset-submit-btn:hover {
            color: var(--rq-white);
            transform: translateY(-2px);
            box-shadow: 0 17px 34px rgba(75,56,50,.24);
        }

    .reset-submit-arrow {
        width: 29px;
        height: 29px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255,255,255,.13);
    }


    /* =========================================================
           ANIMATION
           ========================================================= */

    @@keyframes resetFadeUp {

        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================================================
           TABLET
           ========================================================= */

    @@media (max-width: 768px) {

        .reset-password-page {
            width: calc(100% - 28px);
        }

        .reset-card {
            padding: 27px 22px;
            border-radius: 25px;
        }

        .password-info {
            grid-template-columns: 1fr;
        }
    }


    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 576px) {

        .reset-password-page {
            width: calc(100% - 22px);
        }

        .reset-hero {
            margin-bottom: 22px;
        }

        .reset-eyebrow {
            gap: 9px;
            font-size: 8px;
            letter-spacing: 2.5px;
        }

            .reset-eyebrow::before {
                width: 28px;
            }

        .reset-title {
            font-size: 42px;
            letter-spacing: -2px;
        }

        .reset-description {
            margin-top: 13px;
            font-size: 13px;
            line-height: 1.65;
        }

        .reset-card {
            padding: 20px 16px;
            border-radius: 22px;
        }

        .reset-card-header {
            align-items: flex-start;
            margin-bottom: 22px;
            padding-bottom: 20px;
        }

        .reset-card-heading {
            gap: 10px;
        }

        .reset-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
        }

        .reset-card-heading h2 {
            font-size: 20px;
        }

        .reset-card-heading span {
            font-size: 7px;
            letter-spacing: 1.5px;
        }

        .reset-security-label {
            display: none;
        }

        .admin-email-box {
            align-items: flex-start;
            flex-direction: column;
            gap: 7px;
            padding: 15px;
        }

        .admin-email-value {
            max-width: 100%;
            white-space: normal;
            word-break: break-word;
            font-size: 15px;
        }

        .reset-input {
            min-height: 54px;
            font-size: 14px;
        }

        .reset-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .reset-back-btn,
        .reset-submit-btn {
            width: 100%;
        }
    }

</style>


<div class="reset-password-page">


    <!-- =========================================================
         HERO
         ========================================================= -->

    <section class="reset-hero">

        <div class="reset-eyebrow">
            ADMINISTRATOR SECURITY
        </div>

        <h1 class="reset-title">

            Change Admin
            <em>Password.</em>

        </h1>

        <p class="reset-description">

            Securely assign a new password to this Restaurant
            Administrator account while keeping all account and
            restaurant access details unchanged.

        </p>

    </section>


    <!-- =========================================================
         CARD
         ========================================================= -->

    <section class="reset-card">


        <!-- CARD HEADER -->

        <div class="reset-card-header">

            <div class="reset-card-heading">

                <div class="reset-icon">
                    ◈
                </div>

                <div>

                    <h2>
                        Security Credentials
                    </h2>

                    <span>
                        Restaurant Admin Access
                    </span>

                </div>

            </div>


            <div class="reset-security-label">
                Secure Update
            </div>

        </div>


        <!-- ADMIN EMAIL -->

        <div class="admin-email-box">

            <span class="admin-email-label">
                Administrator Email
            </span>

            <span class="admin-email-value"
                  title="@Model.AdminEmail">

                @Model.AdminEmail

            </span>

        </div>


        <!-- =====================================================
             FORM
             ===================================================== -->

        <form asp-area="SuperAdmin"
              asp-controller="Admin"
              asp-action="ResetPassword"
              method="post"
              class="reset-form">

            @Html.AntiForgeryToken()


            <!-- HIDDEN -->

            <input asp-for="UserId"
                   type="hidden" />

            <input asp-for="AdminEmail"
                   type="hidden" />


            <!-- VALIDATION SUMMARY -->

            <div asp-validation-summary="ModelOnly"
                 class="reset-validation-summary">
            </div>


            <!-- =================================================
                 NEW PASSWORD
                 ================================================= -->

            <div class="reset-form-group">

                <label asp-for="NewPassword"
                       class="reset-label">

                    New Password

                </label>


                <div class="password-field">

                    <input asp-for="NewPassword"
                           class="reset-input"
                           id="newPasswordInput"
                           placeholder="Enter new password"
                           autocomplete="new-password" />


                    <button type="button"
                            class="password-toggle"
                            data-target="newPasswordInput"
                            aria-label="Show or hide new password">

                        ◉

                    </button>

                </div>


                <span asp-validation-for="NewPassword"
                      class="reset-validation">
                </span>

            </div>


            <!-- =================================================
                 CONFIRM PASSWORD
                 ================================================= -->

            <div class="reset-form-group">

                <label asp-for="ConfirmPassword"
                       class="reset-label">

                    Confirm Password

                </label>


                <div class="password-field">

                    <input asp-for="ConfirmPassword"
                           class="reset-input"
                           id="confirmPasswordInput"
                           placeholder="Confirm new password"
                           autocomplete="new-password" />


                    <button type="button"
                            class="password-toggle"
                            data-target="confirmPasswordInput"
                            aria-label="Show or hide confirmation password">

                        ◉

                    </button>

                </div>


                <span asp-validation-for="ConfirmPassword"
                      class="reset-validation">
                </span>

            </div>


            <!-- =================================================
                 SECURITY INFO
                 ================================================= -->

            <div class="password-info">

                <div class="password-info-item">

                    <strong>
                        New Credential
                    </strong>

                    Replaces the admin's existing password.

                </div>


                <div class="password-info-item">

                    <strong>
                        Restaurant Access
                    </strong>

                    Existing restaurant assignment remains unchanged.

                </div>


                <div class="password-info-item">

                    <strong>
                        Protected Update
                    </strong>

                    Request is protected using an anti-forgery token.

                </div>

            </div>


            <!-- =================================================
                 ACTIONS
                 ================================================= -->

            <div class="reset-actions">


                <a asp-area="SuperAdmin"
                   asp-controller="Admin"
                   asp-action="Index"
                   class="reset-back-btn">

                    ← Back to Admins

                </a>


                <button type="submit"
                        class="reset-submit-btn">

                    Change Password

                    <span class="reset-submit-arrow">
                        →
                    </span>

                </button>

            </div>

        </form>

    </section>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const toggleButtons =
                    document.querySelectorAll(
                        ".password-toggle"
                    );


                toggleButtons.forEach(
                    function (button) {

                        button.addEventListener(
                            "click",
                            function () {

                                const targetId =
                                    button.getAttribute(
                                        "data-target"
                                    );

                                const input =
                                    document.getElementById(
                                        targetId
                                    );


                                if (!input) {
                                    return;
                                }


                                if (
                                    input.type ===
                                    "password"
                                ) {

                                    input.type =
                                        "text";

                                    button.textContent =
                                        "◎";

                                }
                                else {

                                    input.type =
                                        "password";

                                    button.textContent =
                                        "◉";

                                }

                            }
                        );

                    }
                );

            }
        );

    </script>

}