@model IEnumerable<RestaurantQR.ViewModels.RestaurantAdminListViewModel>

@{
    ViewData["Title"] = "Restaurant Admins";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Restaurant Admins</h1>

            <p class="text-muted mb-0">
                View and manage restaurant administrator accounts.
            </p>
        </div>

        <a asp-area="SuperAdmin"
           asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Dashboard
        </a>

    </div>


    @* Error Message *@

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <strong>Error:</strong>
            @TempData["ErrorMessage"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No restaurant admin accounts have been created yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Restaurant</th>
                            <th>Restaurant Status</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var admin in Model)
                        {
                            <tr>

                                <td>
                                    @admin.FullName
                                </td>

                                <td>
                                    @admin.Email
                                </td>

                                <td>
                                    @admin.RestaurantName
                                </td>

                                <td>

                                    @if (admin.RestaurantIsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="d-flex gap-2">

                                        <!-- RESET PASSWORD -->

                                        <a asp-area="SuperAdmin"
                                           asp-controller="Admin"
                                           asp-action="ResetPassword"
                                           asp-route-id="@admin.UserId"
                                           class="btn btn-warning btn-sm">

                                            Reset Password

                                        </a>


                                        <!-- DELETE ADMIN -->

                                        <form asp-area="SuperAdmin"
                                              asp-controller="Admin"
                                              asp-action="Delete"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@admin.UserId" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Are you sure you want to permanently delete this Admin account?');">

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>