@model RestaurantQR.ViewModels.AssignSubscriptionViewModel

@{
    ViewData["Title"] = "Assign Subscription";
}

<style>

    /* =========================================================
           RESTAURANT QR
           SUPER ADMIN - ASSIGN SUBSCRIPTION
           LUXURY COFFEE THEME
           ========================================================= */

    .assign-sub-page {
        --rq-white: #FFFDF7;
        --rq-cream: #F5E6CA;
        --rq-beige: #DCC7AA;
        --rq-coffee: #6F4E37;
        --rq-espresso: #4B3832;
        --rq-deep: #352822;
        --rq-gold: #B8894D;
        --rq-muted: #8B7565;
        --rq-danger: #965044;
        width: min(920px, calc(100% - 40px));
        margin: 0 auto;
        color: var(--rq-espresso);
        animation: assignFadeUp .65s ease both;
    }

    /* =========================================================
           HERO
           ========================================================= */

    .assign-hero {
        margin-bottom: 32px;
    }

    .assign-eyebrow {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 15px;
        color: var(--rq-coffee);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 4px;
        text-transform: uppercase;
    }

        .assign-eyebrow::before {
            content: "";
            width: 45px;
            height: 1px;
            background: var(--rq-gold);
        }

    .assign-title {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(46px, 6vw, 72px);
        font-weight: 400;
        line-height: .96;
        letter-spacing: -3px;
        color: var(--rq-espresso);
    }

        .assign-title em {
            color: var(--rq-coffee);
            font-style: italic;
            font-weight: 400;
        }

    .assign-description {
        max-width: 670px;
        margin: 18px 0 0;
        color: var(--rq-muted);
        font-size: 14px;
        line-height: 1.8;
    }

    /* =========================================================
           CARD
           ========================================================= */

    .assign-card {
        position: relative;
        overflow: hidden;
        padding: 34px;
        border: 1px solid rgba(255,255,255,.95);
        border-radius: 30px;
        background: linear-gradient( 135deg, rgba(255,253,247,.90), rgba(245,230,202,.58) );
        box-shadow: 0 24px 70px rgba(75,56,50,.10);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

        .assign-card::before {
            content: "";
            position: absolute;
            width: 200px;
            height: 200px;
            right: -95px;
            top: -95px;
            border-radius: 50%;
            background: rgba(220,199,170,.30);
            pointer-events: none;
        }

        .assign-card::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            left: -75px;
            bottom: -75px;
            border-radius: 50%;
            background: rgba(184,137,77,.07);
            pointer-events: none;
        }

    /* =========================================================
           CARD HEADER
           ========================================================= */

    .assign-card-header {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 24px;
        margin-bottom: 26px;
        border-bottom: 1px solid rgba(75,56,50,.10);
    }

    .assign-card-heading {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .assign-card-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        background: var(--rq-coffee);
        color: var(--rq-white);
        font-size: 22px;
        box-shadow: 0 12px 28px rgba(111,78,55,.20);
    }

    .assign-card-heading h2 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 24px;
        font-weight: 400;
        color: var(--rq-espresso);
    }

    .assign-card-heading span {
        display: block;
        margin-top: 4px;
        color: var(--rq-muted);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .assign-card-tag {
        color: var(--rq-gold);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    /* =========================================================
           FORM
           ========================================================= */

    .assign-form {
        position: relative;
        z-index: 2;
    }

    .assign-group {
        margin-bottom: 22px;
    }

    .assign-label {
        display: block;
        margin-bottom: 9px;
        color: var(--rq-espresso);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.4px;
        text-transform: uppercase;
    }

        .assign-label::before {
            content: "•";
            margin-right: 7px;
            color: var(--rq-gold);
        }

    /* =========================================================
           INPUTS / SELECT
           ========================================================= */

    .assign-input,
    .assign-select {
        width: 100%;
        min-height: 58px;
        padding: 14px 17px;
        border: 1px solid rgba(111,78,55,.16);
        border-radius: 15px;
        outline: none;
        background: rgba(255,255,255,.72);
        color: var(--rq-espresso);
        font-size: 14px;
        transition: border-color .25s ease, background .25s ease, box-shadow .25s ease, transform .25s ease;
    }

        .assign-input:hover,
        .assign-select:hover {
            background: rgba(255,255,255,.92);
            border-color: rgba(111,78,55,.25);
        }

        .assign-input:focus,
        .assign-select:focus {
            background: var(--rq-white);
            border-color: var(--rq-gold);
            box-shadow: 0 0 0 4px rgba(184,137,77,.10), 0 10px 28px rgba(75,56,50,.07);
            transform: translateY(-1px);
        }

        .assign-input[readonly] {
            background: rgba(245,230,202,.40);
            color: var(--rq-coffee);
            cursor: default;
        }

    /* =========================================================
           SELECT
           ========================================================= */

    .assign-select {
        cursor: pointer;
    }

    /* =========================================================
           RESTAURANT INFO
           ========================================================= */

    .restaurant-preview {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 15px 17px;
        border: 1px solid rgba(111,78,55,.12);
        border-radius: 16px;
        background: rgba(245,230,202,.34);
    }

    .restaurant-preview-icon {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: var(--rq-beige);
        color: var(--rq-coffee);
        font-size: 17px;
    }

    .restaurant-preview-copy small {
        display: block;
        margin-bottom: 4px;
        color: var(--rq-muted);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .restaurant-preview-copy strong {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 18px;
        font-weight: 400;
        color: var(--rq-espresso);
    }

    /* =========================================================
           VALIDATION
           ========================================================= */

    .assign-validation {
        display: block;
        margin-top: 7px;
        color: var(--rq-danger);
        font-size: 11px;
    }

    /* =========================================================
           INFO STRIP
           ========================================================= */

    .assign-info-strip {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin: 8px 0 25px;
    }

    .assign-info-item {
        padding: 13px;
        border-radius: 13px;
        background: rgba(245,230,202,.30);
        color: var(--rq-muted);
        font-size: 10px;
        line-height: 1.5;
    }

        .assign-info-item strong {
            display: block;
            margin-bottom: 3px;
            color: var(--rq-coffee);
            font-size: 10px;
        }

    /* =========================================================
           ACTIONS
           ========================================================= */

    .assign-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-top: 28px;
        padding-top: 24px;
        border-top: 1px solid rgba(75,56,50,.10);
    }

    .assign-submit-btn,
    .assign-cancel-btn {
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 22px;
        border-radius: 28px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: transform .25s ease, background .25s ease, color .25s ease, box-shadow .25s ease;
    }

    .assign-submit-btn {
        border: 0;
        background: linear-gradient( 135deg, var(--rq-espresso), var(--rq-coffee) );
        color: var(--rq-white);
        cursor: pointer;
        box-shadow: 0 12px 28px rgba(75,56,50,.18);
    }

        .assign-submit-btn:hover {
            color: var(--rq-white);
            transform: translateY(-2px);
            box-shadow: 0 17px 34px rgba(75,56,50,.24);
        }

    .assign-submit-arrow {
        width: 29px;
        height: 29px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255,255,255,.14);
    }

    .assign-cancel-btn {
        border: 1px solid rgba(111,78,55,.16);
        background: rgba(255,253,247,.65);
        color: var(--rq-coffee);
    }

        .assign-cancel-btn:hover {
            color: var(--rq-white);
            background: var(--rq-coffee);
            transform: translateX(-2px);
        }

    /* =========================================================
           ANIMATION
           ========================================================= */

    @@keyframes assignFadeUp {

        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 768px) {

        .assign-sub-page {
            width: calc(100% - 28px);
        }

        .assign-card {
            padding: 27px 22px;
            border-radius: 25px;
        }

        .assign-info-strip {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {

        .assign-sub-page {
            width: calc(100% - 22px);
        }

        .assign-hero {
            margin-bottom: 22px;
        }

        .assign-eyebrow {
            gap: 9px;
            font-size: 8px;
            letter-spacing: 2.5px;
        }

            .assign-eyebrow::before {
                width: 28px;
            }

        .assign-title {
            font-size: 42px;
            letter-spacing: -2px;
        }

        .assign-description {
            margin-top: 13px;
            font-size: 13px;
            line-height: 1.65;
        }

        .assign-card {
            padding: 20px 16px;
            border-radius: 22px;
        }

        .assign-card-header {
            align-items: flex-start;
            margin-bottom: 22px;
            padding-bottom: 20px;
        }

        .assign-card-heading {
            gap: 10px;
        }

        .assign-card-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
        }

        .assign-card-heading h2 {
            font-size: 20px;
        }

        .assign-card-heading span {
            font-size: 7px;
            letter-spacing: 1.4px;
        }

        .assign-card-tag {
            display: none;
        }

        .assign-input,
        .assign-select {
            min-height: 54px;
            font-size: 13px;
        }

        .assign-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .assign-submit-btn,
        .assign-cancel-btn {
            width: 100%;
        }
    }

</style>


<div class="assign-sub-page">

    <!-- =========================================================
         HERO
         ========================================================= -->

    <section class="assign-hero">

        <div class="assign-eyebrow">
            SUBSCRIPTION MANAGEMENT
        </div>

        <h1 class="assign-title">

            Assign
            <em>Subscription.</em>

        </h1>

        <p class="assign-description">

            Select the right subscription plan for
            <strong>@ViewBag.RestaurantName</strong>
            and define when the plan should begin.

        </p>

    </section>


    <!-- =========================================================
         CARD
         ========================================================= -->

    <section class="assign-card">

        <div class="assign-card-header">

            <div class="assign-card-heading">

                <div class="assign-card-icon">
                    ✦
                </div>

                <div>

                    <h2>
                        Subscription Details
                    </h2>

                    <span>
                        Restaurant plan assignment
                    </span>

                </div>

            </div>


            <div class="assign-card-tag">
                Platform Billing
            </div>

        </div>


        <form asp-area="SuperAdmin"
              asp-controller="Restaurant"
              asp-action="AssignSubscription"
              method="post"
              class="assign-form">

            @Html.AntiForgeryToken()


            <input type="hidden"
                   asp-for="RestaurantId" />


            <!-- =================================================
                 RESTAURANT
                 ================================================= -->

            <div class="assign-group">

                <label class="assign-label">
                    Restaurant
                </label>


                <div class="restaurant-preview">

                    <div class="restaurant-preview-icon">
                        ◈
                    </div>

                    <div class="restaurant-preview-copy">

                        <small>
                            Subscription For
                        </small>

                        <strong>
                            @ViewBag.RestaurantName
                        </strong>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 SUBSCRIPTION PLAN
                 ================================================= -->

            <div class="assign-group">

                <label asp-for="SubscriptionPlanId"
                       class="assign-label">

                    Subscription Plan

                </label>


                <select asp-for="SubscriptionPlanId"
                        class="assign-select"
                        required>

                    <option value="">
                        Select Subscription Plan
                    </option>

                    @foreach (var plan in ViewBag.Plans)
                    {
                        <option value="@plan.Id">

                            @plan.Name
                            — @plan.DurationDays days
                            — ₹@plan.Price.ToString("N2")

                        </option>
                    }

                </select>


                <span asp-validation-for="SubscriptionPlanId"
                      class="assign-validation">
                </span>

            </div>


            <!-- =================================================
                 START DATE
                 ================================================= -->

            <div class="assign-group">

                <label asp-for="StartDate"
                       class="assign-label">

                    Start Date

                </label>


                <input asp-for="StartDate"
                       type="date"
                       class="assign-input" />


                <span asp-validation-for="StartDate"
                      class="assign-validation">
                </span>

            </div>


            <!-- =================================================
                 INFO
                 ================================================= -->

            <div class="assign-info-strip">

                <div class="assign-info-item">

                    <strong>
                        Plan Activation
                    </strong>

                    Subscription begins from the selected start date.

                </div>


                <div class="assign-info-item">

                    <strong>
                        Restaurant Access
                    </strong>

                    Plan access remains linked to this restaurant.

                </div>


                <div class="assign-info-item">

                    <strong>
                        Secure Assignment
                    </strong>

                    This request is protected using anti-forgery validation.

                </div>

            </div>


            <!-- =================================================
                 ACTIONS
                 ================================================= -->

            <div class="assign-actions">


                <a asp-area="SuperAdmin"
                   asp-controller="Restaurant"
                   asp-action="Index"
                   class="assign-cancel-btn">

                    ← Cancel

                </a>


                <button type="submit"
                        class="assign-submit-btn">

                    Assign Subscription

                    <span class="assign-submit-arrow">
                        →
                    </span>

                </button>

            </div>

        </form>

    </section>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}