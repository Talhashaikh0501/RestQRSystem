@model RestaurantQR.ViewModels.SubscriptionSuccessViewModel

@{
    ViewData["Title"] = "Payment Successful";

    Layout = null;

    var emailSent =
        ViewBag.EmailSent is bool sent &&
        sent;

    var approvalPending =
        ViewBag.ApprovalPending is bool pending &&
        pending;

    var emailWarning =
        ViewBag.EmailWarning?.ToString();

    var restaurantName =
        Model.Subscription.Restaurant?.Name
        ?? "Restaurant";

    var planName =
        Model.Subscription.SubscriptionPlan?.Name
        ?? "Subscription Plan";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Payment Successful - RestaurantQR
    </title>


    <style>

        :root {
            --rq-white: #FFFDF7;
            --rq-cream: #F5E6CA;
            --rq-beige: #DCC7AA;
            --rq-coffee: #6F4E37;
            --rq-espresso: #4B3832;
            --rq-deep: #352822;
            --rq-gold: #B8894D;
            --rq-muted: #8B7565;

            --rq-green: #738653;
            --rq-green-soft: #EDF4E6;

            --rq-warning: #A9772D;
            --rq-warning-soft: #FFF5DE;

            --rq-red: #9A5A50;
            --rq-red-soft: #FBEDEA;
        }


        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }


        html,
        body {
            margin: 0;
            padding: 0;

            width: 100%;
            min-height: 100%;

            color: var(--rq-espresso);

            background: var(--rq-cream);
        }


        body {
            font-family:
                Arial,
                Helvetica,
                sans-serif;
        }


        /* =========================================================
           PAGE
        ========================================================= */

        .success-page {
            position: relative;

            min-height: 100vh;

            overflow: hidden;

            padding:
                30px 28px
                45px;

            background:
                radial-gradient(
                    circle at 8% 14%,
                    rgba(255,255,255,.95),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 90% 10%,
                    rgba(220,199,170,.58),
                    transparent 31%
                ),
                linear-gradient(
                    135deg,
                    #FFFDF7 0%,
                    #FAF1E1 42%,
                    #F5E6CA 72%,
                    #EAD4B2 100%
                );
        }


        .success-page::before {
            content: "";

            position: fixed;

            width: 430px;
            height: 430px;

            top: 240px;
            left: -230px;

            border-radius: 50%;

            background:
                rgba(111,78,55,.05);

            pointer-events: none;
        }


        .success-page::after {
            content: "";

            position: fixed;

            width: 520px;
            height: 520px;

            right: -270px;
            bottom: -250px;

            border-radius: 50%;

            background:
                rgba(184,137,77,.08);

            pointer-events: none;
        }


        /* =========================================================
           NAVBAR
        ========================================================= */

        .success-navbar {
            position: relative;

            z-index: 10;

            width:
                min(1180px, 100%);

            min-height: 82px;

            margin:
                0 auto
                48px;

            display: grid;

            grid-template-columns:
                1fr auto 1fr;

            align-items: center;

            padding:
                10px 18px;

            border:
                1px solid
                rgba(255,255,255,.96);

            border-radius: 44px;

            background:
                rgba(255,253,247,.90);

            box-shadow:
                0 18px 50px
                rgba(75,56,50,.13);

            backdrop-filter:
                blur(22px);

            -webkit-backdrop-filter:
                blur(22px);
        }


        .success-brand {
            grid-column: 2;

            text-align: center;

            text-decoration: none;

            white-space: nowrap;
        }


        .success-brand-main {
            font-family:
                Georgia,
                "Times New Roman",
                serif;

            font-size: 27px;

            font-weight: 700;

            letter-spacing: -.9px;

            color: var(--rq-espresso);
        }


        .success-brand-main span {
            color: var(--rq-gold);

            font-style: italic;
        }


        .success-brand-sub {
            display: block;

            margin-top: 5px;

            color:
                rgba(75,56,50,.48);

            font-size: 7px;

            font-weight: 700;

            letter-spacing: 4px;

            text-transform: uppercase;
        }


        .success-nav-right {
            grid-column: 3;

            justify-self: end;

            display: flex;

            align-items: center;

            gap: 10px;
        }


        .success-home-link {
            min-height: 46px;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            padding:
                0 19px;

            border:
                1px solid
                rgba(111,78,55,.14);

            border-radius: 25px;

            color: var(--rq-coffee);

            background:
                rgba(245,230,202,.42);

            text-decoration: none;

            font-size: 11px;

            font-weight: 700;

            transition:
                .25s ease;
        }


        .success-home-link:hover {
            color: var(--rq-white);

            background:
                var(--rq-coffee);

            transform:
                translateY(-2px);
        }


        /* =========================================================
           CONTAINER
        ========================================================= */

        .success-container {
            position: relative;

            z-index: 2;

            width:
                min(1030px, 100%);

            margin:
                0 auto;
        }


        /* =========================================================
           HERO
        ========================================================= */

        .success-hero {
            text-align: center;

            margin-bottom: 35px;

            animation:
                fadeUp .65s ease both;
        }


        .success-icon {
            width: 90px;
            height: 90px;

            margin:
                0 auto
                25px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 50%;

            color: #ffffff;

            background:
                linear-gradient(
                    135deg,
                    #91A665,
                    #6E824B
                );

            font-size: 40px;

            font-weight: 700;

            box-shadow:
                0 18px 40px
                rgba(111,132,74,.22),
                0 0 0 10px
                rgba(145,166,101,.10);

            animation:
                successPop
                .65s
                cubic-bezier(.2,.8,.2,1)
                both;
        }


        .success-eyebrow {
            display: inline-flex;

            align-items: center;

            gap: 12px;

            margin-bottom: 15px;

            color: var(--rq-coffee);

            font-size: 9px;

            font-weight: 700;

            letter-spacing: 3.5px;

            text-transform: uppercase;
        }


        .success-eyebrow::before,
        .success-eyebrow::after {
            content: "";

            width: 34px;
            height: 1px;

            background:
                var(--rq-gold);
        }


        .success-title {
            max-width: 900px;

            margin: 0 auto;

            font-family:
                Georgia,
                "Times New Roman",
                serif;

            font-size:
                clamp(
                    48px,
                    6vw,
                    74px
                );

            font-weight: 400;

            line-height: .98;

            letter-spacing: -3px;

            color: var(--rq-espresso);
        }


        .success-title em {
            color: var(--rq-coffee);

            font-style: italic;

            font-weight: 400;
        }


        .success-description {
            max-width: 690px;

            margin:
                20px auto 0;

            color: var(--rq-muted);

            font-size: 14px;

            line-height: 1.8;
        }


        /* =========================================================
           APPROVAL NOTICE
        ========================================================= */

        .approval-card {
            position: relative;

            overflow: hidden;

            margin-bottom: 20px;

            padding:
                26px 28px;

            display: flex;

            align-items: center;

            gap: 20px;

            border:
                1px solid
                rgba(184,137,77,.28);

            border-radius: 25px;

            background:
                linear-gradient(
                    135deg,
                    rgba(255,247,226,.96),
                    rgba(245,230,202,.75)
                );

            box-shadow:
                0 18px 48px
                rgba(75,56,50,.08);

            animation:
                fadeUp
                .7s ease both;
        }


        .approval-card::after {
            content: "";

            position: absolute;

            width: 180px;
            height: 180px;

            right: -80px;
            top: -85px;

            border-radius: 50%;

            background:
                rgba(184,137,77,.10);
        }


        .approval-icon {
            position: relative;

            z-index: 2;

            width: 58px;
            height: 58px;

            flex: 0 0 58px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 18px;

            color: #ffffff;

            background:
                var(--rq-gold);

            font-size: 24px;

            font-weight: 700;

            box-shadow:
                0 12px 28px
                rgba(184,137,77,.22);
        }


        .approval-content {
            position: relative;

            z-index: 2;
        }


        .approval-label {
            display: block;

            margin-bottom: 6px;

            color: #8C662C;

            font-size: 9px;

            font-weight: 800;

            letter-spacing: 2.5px;

            text-transform: uppercase;
        }


        .approval-title {
            margin:
                0 0 7px;

            font-family:
                Georgia,
                "Times New Roman",
                serif;

            font-size: 24px;

            font-weight: 400;

            color: var(--rq-espresso);
        }


        .approval-text {
            margin: 0;

            max-width: 780px;

            color: #806A4B;

            font-size: 13px;

            line-height: 1.7;
        }


        /* =========================================================
           EMAIL STATUS
        ========================================================= */

        .email-status {
            margin-bottom: 20px;

            display: flex;

            align-items: flex-start;

            gap: 14px;

            padding:
                18px 20px;

            border-radius: 19px;

            font-size: 12px;

            line-height: 1.65;
        }


        .email-status.success {
            color: #50623D;

            border:
                1px solid
                rgba(115,134,83,.20);

            background:
                rgba(237,244,230,.90);
        }


        .email-status.warning {
            color: #835347;

            border:
                1px solid
                rgba(154,90,80,.18);

            background:
                rgba(251,237,234,.90);
        }


        .email-status-icon {
            width: 31px;
            height: 31px;

            flex:
                0 0 31px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 10px;

            color: #ffffff;

            font-weight: 800;
        }


        .email-status.success
        .email-status-icon {
            background:
                var(--rq-green);
        }


        .email-status.warning
        .email-status-icon {
            background:
                var(--rq-red);
        }


        .email-status strong {
            color: inherit;
        }


        /* =========================================================
           DETAILS GRID
        ========================================================= */

        .success-overview {
            display: grid;

            grid-template-columns:
                repeat(
                    2,
                    minmax(0,1fr)
                );

            gap: 18px;

            margin-bottom: 20px;
        }


        .success-card {
            position: relative;

            overflow: hidden;

            padding:
                27px;

            border:
                1px solid
                rgba(255,255,255,.96);

            border-radius: 25px;

            background:
                linear-gradient(
                    135deg,
                    rgba(255,253,247,.93),
                    rgba(245,230,202,.56)
                );

            box-shadow:
                0 18px 48px
                rgba(75,56,50,.08);

            backdrop-filter:
                blur(15px);

            -webkit-backdrop-filter:
                blur(15px);

            animation:
                fadeUp
                .75s ease both;
        }


        .success-card::after {
            content: "";

            position: absolute;

            width: 150px;
            height: 150px;

            right: -80px;
            top: -80px;

            border-radius: 50%;

            background:
                rgba(220,199,170,.18);

            pointer-events: none;
        }


        .success-card-label {
            position: relative;

            z-index: 2;

            display: block;

            margin-bottom: 12px;

            color: var(--rq-muted);

            font-size: 8px;

            font-weight: 700;

            letter-spacing: 2.5px;

            text-transform: uppercase;
        }


        .success-card-title {
            position: relative;

            z-index: 2;

            margin:
                0 0 24px;

            font-family:
                Georgia,
                "Times New Roman",
                serif;

            font-size: 27px;

            font-weight: 400;

            color: var(--rq-espresso);
        }


        .success-row {
            position: relative;

            z-index: 2;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 15px;

            padding:
                12px 0;

            border-top:
                1px solid
                rgba(75,56,50,.08);
        }


        .success-row-label {
            color: var(--rq-muted);

            font-size: 11px;
        }


        .success-row-value {
            text-align: right;

            color: var(--rq-espresso);

            font-size: 12px;

            font-weight: 700;
        }


        .status-paid {
            display: inline-flex;

            align-items: center;

            gap: 7px;

            color: #637648;
        }


        .status-paid::before {
            content: "";

            width: 8px;
            height: 8px;

            border-radius: 50%;

            background:
                var(--rq-green);
        }


        .status-pending {
            display: inline-flex;

            align-items: center;

            gap: 7px;

            color: #936B2D;
        }


        .status-pending::before {
            content: "";

            width: 8px;
            height: 8px;

            border-radius: 50%;

            background:
                var(--rq-gold);
        }


        /* =========================================================
           LOGIN CREDENTIAL CARD
        ========================================================= */

        .admin-login-card {
            position: relative;

            overflow: hidden;

            margin-bottom: 20px;

            padding:
                29px;

            border:
                1px solid
                rgba(255,255,255,.96);

            border-radius: 27px;

            background:
                linear-gradient(
                    135deg,
                    rgba(255,253,247,.96),
                    rgba(245,230,202,.63)
                );

            box-shadow:
                0 20px 55px
                rgba(75,56,50,.10);

            animation:
                fadeUp .8s ease both;
        }


        .admin-login-header {
            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            margin-bottom: 25px;
        }


        .admin-login-heading {
            display: flex;

            align-items: center;

            gap: 14px;
        }


        .admin-login-icon {
            width: 49px;
            height: 49px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 16px;

            color: #ffffff;

            background:
                var(--rq-coffee);

            font-size: 20px;
        }


        .admin-login-heading h2 {
            margin: 0;

            font-family:
                Georgia,
                "Times New Roman",
                serif;

            font-size: 23px;

            font-weight: 400;

            color: var(--rq-espresso);
        }


        .admin-login-heading span {
            display: block;

            margin-top: 5px;

            color: var(--rq-muted);

            font-size: 8px;

            font-weight: 700;

            letter-spacing: 2px;

            text-transform: uppercase;
        }


        .pending-pill {
            display: inline-flex;

            align-items: center;

            gap: 7px;

            padding:
                9px 13px;

            border-radius: 18px;

            color: #8C662C;

            background:
                rgba(184,137,77,.12);

            font-size: 9px;

            font-weight: 800;

            text-transform: uppercase;

            white-space: nowrap;
        }


        .pending-pill::before {
            content: "";

            width: 7px;
            height: 7px;

            border-radius: 50%;

            background:
                var(--rq-gold);
        }


        .credential-grid {
            display: grid;

            grid-template-columns:
                repeat(
                    2,
                    minmax(0,1fr)
                );

            gap: 16px;
        }


        .credential-label {
            display: block;

            margin-bottom: 8px;

            color: var(--rq-muted);

            font-size: 8px;

            font-weight: 700;

            letter-spacing: 2px;

            text-transform: uppercase;
        }


        .credential-box {
            min-height: 59px;

            display: flex;

            align-items: center;

            gap: 10px;

            padding:
                9px 10px
                9px 17px;

            border:
                1px solid
                rgba(111,78,55,.13);

            border-radius: 17px;

            background:
                rgba(255,255,255,.68);
        }


        .credential-text {
            min-width: 0;

            flex: 1;

            overflow-wrap: anywhere;

            color: var(--rq-espresso);

            font-size: 13px;

            font-weight: 700;
        }


        .password-value {
            letter-spacing: 1px;

            color: var(--rq-coffee);
        }


        .copy-btn {
            flex:
                0 0 auto;

            min-height: 39px;

            padding:
                0 14px;

            border: 0;

            border-radius: 13px;

            color: #ffffff;

            background:
                var(--rq-espresso);

            font-size: 9px;

            font-weight: 700;

            cursor: pointer;

            transition:
                .2s ease;
        }


        .copy-btn:hover {
            background:
                var(--rq-coffee);

            transform:
                translateY(-1px);
        }


        .credential-note {
            margin:
                20px 0 0;

            padding-top: 18px;

            border-top:
                1px solid
                rgba(75,56,50,.08);

            color: var(--rq-muted);

            font-size: 12px;

            line-height: 1.7;
        }


        .credential-note strong {
            color: var(--rq-coffee);
        }


        /* =========================================================
           NEXT STEP
        ========================================================= */

        .next-step-card {
            margin-bottom: 24px;

            padding: 27px;

            border-radius: 25px;

            color: #ffffff;

            background:
                linear-gradient(
                    135deg,
                    var(--rq-deep),
                    var(--rq-espresso)
                );

            box-shadow:
                0 20px 50px
                rgba(53,40,34,.20);

            animation:
                fadeUp .85s ease both;
        }


        .next-step-label {
            display: block;

            margin-bottom: 10px;

            color: var(--rq-beige);

            font-size: 8px;

            font-weight: 700;

            letter-spacing: 2.4px;

            text-transform: uppercase;
        }


        .next-step-card h3 {
            margin:
                0 0 11px;

            font-family:
                Georgia,
                "Times New Roman",
                serif;

            font-size: 25px;

            font-weight: 400;

            color: #ffffff;
        }


        .next-step-card p {
            max-width: 800px;

            margin: 0;

            color:
                rgba(255,255,255,.72);

            font-size: 13px;

            line-height: 1.75;
        }


        /* =========================================================
           ACTIONS
        ========================================================= */

        .success-actions {
            display: flex;

            align-items: center;

            justify-content: center;

            gap: 12px;

            margin:
                27px 0
                45px;
        }


        .back-home-btn,
        .login-later-btn {
            min-height: 52px;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            padding:
                0 23px;

            border-radius: 28px;

            text-decoration: none;

            font-size: 11px;

            font-weight: 700;

            transition:
                .25s ease;
        }


        .back-home-btn {
            color: #ffffff;

            background:
                var(--rq-espresso);

            box-shadow:
                0 13px 29px
                rgba(75,56,50,.18);
        }


        .back-home-btn:hover {
            color: #ffffff;

            background:
                var(--rq-coffee);

            transform:
                translateY(-2px);
        }


        .login-later-btn {
            color: var(--rq-coffee);

            border:
                1px solid
                rgba(111,78,55,.15);

            background:
                rgba(255,253,247,.62);
        }


        .login-later-btn:hover {
            color: var(--rq-white);

            background:
                var(--rq-coffee);

            transform:
                translateY(-2px);
        }


        /* =========================================================
           FOOTER
        ========================================================= */

        .success-footer {
            position: relative;

            z-index: 2;

            width:
                min(1180px,100%);

            margin:
                0 auto;

            padding-top: 22px;

            display: grid;

            grid-template-columns:
                1fr auto 1fr;

            align-items: center;

            gap: 20px;

            border-top:
                1px solid
                rgba(75,56,50,.10);

            color: var(--rq-muted);

            font-size: 9px;
        }


        .success-footer-brand {
            font-family:
                Georgia,
                "Times New Roman",
                serif;

            font-size: 17px;

            font-weight: 700;

            color: var(--rq-espresso);
        }


        .success-footer-brand span {
            color: var(--rq-gold);
        }


        .success-footer-center {
            text-align: center;

            letter-spacing: 2px;

            text-transform: uppercase;
        }


        .success-footer-status {
            justify-self: end;

            display: flex;

            align-items: center;

            gap: 8px;
        }


        .footer-dot {
            width: 7px;
            height: 7px;

            border-radius: 50%;

            background:
                var(--rq-gold);

            box-shadow:
                0 0 0 4px
                rgba(184,137,77,.10);
        }


        /* =========================================================
           ANIMATIONS
        ========================================================= */

        @@keyframes fadeUp {

            from {
                opacity: 0;

                transform:
                    translateY(20px);
            }

            to {
                opacity: 1;

                transform:
                    translateY(0);
            }
        }


        @@keyframes successPop {

            from {
                opacity: 0;

                transform:
                    scale(.70);
            }

            to {
                opacity: 1;

                transform:
                    scale(1);
            }
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media (max-width: 800px) {

            .success-navbar {
                grid-template-columns:
                    1fr auto;

                padding:
                    10px 14px;
            }


            .success-brand {
                grid-column: 1;

                justify-self: start;

                text-align: left;
            }


            .success-nav-right {
                grid-column: 2;
            }


            .success-overview,
            .credential-grid {
                grid-template-columns:
                    1fr;
            }


            .approval-card {
                align-items:
                    flex-start;
            }
        }


        @@media (max-width: 600px) {

            .success-page {
                padding:
                    18px 14px
                    30px;
            }


            .success-navbar {
                min-height: 70px;

                margin-bottom:
                    38px;

                border-radius: 35px;
            }


            .success-brand-main {
                font-size: 21px;
            }


            .success-brand-sub {
                display: none;
            }


            .success-home-link {
                min-height: 40px;

                padding:
                    0 14px;

                font-size: 9px;
            }


            .success-icon {
                width: 76px;
                height: 76px;

                font-size: 34px;
            }


            .success-title {
                font-size: 44px;

                letter-spacing: -2px;
            }


            .success-description {
                font-size: 13px;
            }


            .approval-card {
                flex-direction:
                    column;

                padding:
                    22px;
            }


            .success-card,
            .admin-login-card,
            .next-step-card {
                padding:
                    22px;
            }


            .admin-login-header {
                align-items:
                    flex-start;

                flex-direction:
                    column;
            }


            .credential-box {
                align-items:
                    stretch;

                flex-direction:
                    column;

                padding:
                    13px;
            }


            .copy-btn {
                width: 100%;
            }


            .success-actions {
                flex-direction:
                    column;
            }


            .back-home-btn,
            .login-later-btn {
                width: 100%;
            }


            .success-footer {
                grid-template-columns:
                    1fr;

                text-align: center;
            }


            .success-footer-status {
                justify-self: center;
            }
        }

    </style>

</head>


<body>


    <div class="success-page">


        <!-- =====================================================
             NAVBAR
        ====================================================== -->

        <nav class="success-navbar">


            <a asp-controller="Home"
               asp-action="Index"
               class="success-brand">

                <span class="success-brand-main">

                    Restaurant<span>QR</span>

                </span>


                <span class="success-brand-sub">

                    Smart Dining Platform

                </span>

            </a>


            <div class="success-nav-right">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="success-home-link">

                    Home

                </a>

            </div>


        </nav>


        <!-- =====================================================
             CONTENT
        ====================================================== -->

        <main class="success-container">


            <!-- =================================================
                 HERO
            ================================================== -->

            <section class="success-hero">


                <div class="success-icon">

                    ✓

                </div>


                <div class="success-eyebrow">

                    Payment Received

                </div>


                <h1 class="success-title">

                    Payment
                    <em>Successful.</em>

                </h1>


                <p class="success-description">

                    We have successfully received your payment
                    for <strong>@restaurantName</strong>.
                    Your RestaurantQR administrator account has
                    been created and is now waiting for
                    Super Admin confirmation.

                </p>


            </section>


            <!-- =================================================
                 SUPERADMIN APPROVAL NOTICE
            ================================================== -->

            <section class="approval-card">


                <div class="approval-icon">

                    i

                </div>


                <div class="approval-content">

                    <span class="approval-label">

                        Account Status

                    </span>


                    <h2 class="approval-title">

                        Pending Super Admin Approval

                    </h2>


                    <p class="approval-text">

                        Your payment has been completed successfully.
                        Super Admin will verify and confirm your
                        subscription request. Your restaurant account
                        will become active only after confirmation.
                        You will receive another email as soon as your
                        account is approved.

                    </p>

                </div>


            </section>


            <!-- =================================================
                 EMAIL STATUS
            ================================================== -->

            @if (emailSent)
            {
                <div class="email-status success">

                    <div class="email-status-icon">

                        ✓

                    </div>


                    <div>

                        <strong>
                            Temporary login credentials sent.
                        </strong>

                        <br />

                        We have sent your RestaurantQR Admin email,
                        temporary password and pending approval
                        information to

                        <strong>
                            @Model.AdminEmail
                        </strong>.

                    </div>

                </div>
            }
            else if (!string.IsNullOrWhiteSpace(emailWarning))
            {
                <div class="email-status warning">

                    <div class="email-status-icon">

                        !

                    </div>


                    <div>

                        <strong>
                            Email could not be sent.
                        </strong>

                        <br />

                        @emailWarning

                    </div>

                </div>
            }


            <!-- =================================================
                 SUBSCRIPTION DETAILS
            ================================================== -->

            <section class="success-overview">


                <!-- RESTAURANT -->

                <article class="success-card">


                    <span class="success-card-label">

                        Restaurant Details

                    </span>


                    <h2 class="success-card-title">

                        @restaurantName

                    </h2>


                    <div class="success-row">

                        <span class="success-row-label">

                            Subscription Plan

                        </span>


                        <span class="success-row-value">

                            @planName

                        </span>

                    </div>


                    <div class="success-row">

                        <span class="success-row-label">

                            Amount Paid

                        </span>


                        <span class="success-row-value">

                            ₹@Model.Subscription
                                .Amount
                                .ToString("N2")

                        </span>

                    </div>


                    <div class="success-row">

                        <span class="success-row-label">

                            Payment Method

                        </span>


                        <span class="success-row-value">

                            @Model.Subscription.PaymentMethod

                        </span>

                    </div>


                </article>


                <!-- STATUS -->

                <article class="success-card">


                    <span class="success-card-label">

                        Current Status

                    </span>


                    <h2 class="success-card-title">

                        Approval Pending

                    </h2>


                    <div class="success-row">

                        <span class="success-row-label">

                            Payment

                        </span>


                        <span class="success-row-value status-paid">

                            Paid

                        </span>

                    </div>


                    <div class="success-row">

                        <span class="success-row-label">

                            Subscription

                        </span>


                        <span class="success-row-value status-pending">

                            Pending Approval

                        </span>

                    </div>


                    <div class="success-row">

                        <span class="success-row-label">

                            Restaurant Access

                        </span>


                        <span class="success-row-value">

                            Waiting for Super Admin

                        </span>

                    </div>


                </article>


            </section>


            <!-- =================================================
                 TEMP LOGIN CREDENTIALS
            ================================================== -->

            <section class="admin-login-card">


                <div class="admin-login-header">


                    <div class="admin-login-heading">


                        <div class="admin-login-icon">

                            ◈

                        </div>


                        <div>

                            <h2>

                                Restaurant Admin Credentials

                            </h2>


                            <span>

                                Save These Securely

                            </span>

                        </div>


                    </div>


                    <span class="pending-pill">

                        Approval Pending

                    </span>


                </div>


                <div class="credential-grid">


                    <!-- EMAIL -->

                    <div class="credential-group">


                        <span class="credential-label">

                            Admin Email

                        </span>


                        <div class="credential-box">


                            <span class="credential-text"
                                  id="adminEmailValue">

                                @if (!string.IsNullOrWhiteSpace(
                                    Model.AdminEmail))
                                {
                                    @Model.AdminEmail
                                }
                                else
                                {
                                    <text>
                                        Sent by email
                                    </text>
                                }

                            </span>


                            @if (!string.IsNullOrWhiteSpace(
                                Model.AdminEmail))
                            {
                                <button type="button"
                                        class="copy-btn"
                                        data-copy="adminEmailValue">

                                    Copy

                                </button>
                            }


                        </div>


                    </div>


                    <!-- TEMP PASSWORD -->

                    <div class="credential-group">


                        <span class="credential-label">

                            Temporary Password

                        </span>


                        <div class="credential-box">


                            <span class="credential-text password-value"
                                  id="tempPasswordValue">

                                @if (!string.IsNullOrWhiteSpace(
                                    Model.TemporaryPassword))
                                {
                                    @Model.TemporaryPassword
                                }
                                else
                                {
                                    <text>
                                        Check your payment email
                                    </text>
                                }

                            </span>


                            @if (!string.IsNullOrWhiteSpace(
                                Model.TemporaryPassword))
                            {
                                <button type="button"
                                        class="copy-btn"
                                        data-copy="tempPasswordValue">

                                    Copy

                                </button>
                            }


                        </div>


                    </div>


                </div>


                <p class="credential-note">

                    <strong>
                        Important:
                    </strong>

                    These credentials are created after successful
                    payment, but restaurant access remains disabled
                    until Super Admin confirms the request.
                    Keep the temporary password private.

                </p>


            </section>


            <!-- =================================================
                 WHAT HAPPENS NEXT
            ================================================== -->

            <section class="next-step-card">


                <span class="next-step-label">

                    What Happens Next

                </span>


                <h3>

                    Super Admin will confirm your request.

                </h3>


                <p>

                    Once your subscription is verified, RestaurantQR
                    will automatically activate your restaurant.
                    You will then receive a second email confirming
                    that your account is active. After receiving that
                    email, you can log in using the administrator
                    credentials provided above.

                </p>


            </section>


            <!-- =================================================
                 BUTTONS
            ================================================== -->

            <div class="success-actions">


                <a asp-controller="Home"
                   asp-action="Index"
                   class="back-home-btn">

                    Back to Home

                </a>


                <a asp-controller="Account"
                   asp-action="Login"
                   class="login-later-btn">

                    Login After Approval

                </a>


            </div>


        </main>


        <!-- =====================================================
             FOOTER
        ====================================================== -->

        <footer class="success-footer">


            <div class="success-footer-brand">

                Restaurant<span>QR</span>

            </div>


            <div class="success-footer-center">

                Smart Dining · Simplified

            </div>


            <div class="success-footer-status">

                <span class="footer-dot">
                </span>

                Awaiting Super Admin Approval

            </div>


        </footer>


    </div>


    <!-- =========================================================
         COPY BUTTON SCRIPT
    ========================================================== -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                document
                    .querySelectorAll(
                        ".copy-btn"
                    )
                    .forEach(
                        function (button) {

                            button.addEventListener(
                                "click",
                                async function () {

                                    const id =
                                        button.getAttribute(
                                            "data-copy"
                                        );


                                    const target =
                                        document.getElementById(
                                            id
                                        );


                                    if (!target) {
                                        return;
                                    }


                                    const text =
                                        target
                                            .textContent
                                            .trim();


                                    try {

                                        await navigator
                                            .clipboard
                                            .writeText(text);


                                        const oldText =
                                            button.textContent;


                                        button.textContent =
                                            "Copied ✓";


                                        setTimeout(
                                            function () {

                                                button.textContent =
                                                    oldText;

                                            },
                                            1300
                                        );

                                    }
                                    catch {

                                        button.textContent =
                                            "Select & Copy";


                                        setTimeout(
                                            function () {

                                                button.textContent =
                                                    "Copy";

                                            },
                                            1300
                                        );

                                    }

                                }
                            );

                        }
                    );

            }
        );

    </script>


</body>

</html>