@model RestaurantQR.ViewModels.PurchaseSubscriptionViewModel

@{
    ViewData["Title"] = "Buy Subscription";
}

<section class="section-premium" style="padding:80px 0;">
    <div class="container">

        <div style="max-width:850px; margin:0 auto;">

            <span class="section-label-num">SUBSCRIPTION</span>

            <h1 style="
                font-family:'Fraunces',serif;
                font-size:2.8rem;
                margin-bottom:15px;">
                Complete Your Subscription
            </h1>

            <p style="
                color:var(--text-dim);
                margin-bottom:40px;">
                Enter your restaurant details to continue with payment.
            </p>


            <!-- Selected Plan -->

            <div style="
                padding:30px;
                margin-bottom:35px;
                border:1px solid rgba(255,255,255,0.08);
                background:#1E1A17;">

                <span class="section-label-num">SELECTED PLAN</span>

                <h2 style="
                    font-family:'Fraunces',serif;
                    margin:12px 0;">
                    @Model.PlanName
                </h2>

                <div style="
                    font-family:'Fraunces',serif;
                    font-size:2.2rem;">
                    ₹@Model.Amount.ToString("N0")
                </div>

                <p style="
                    color:var(--text-dim);
                    margin:8px 0 0;">
                    @Model.DurationDays days access
                </p>

            </div>


            <!-- Restaurant Details -->

            <form asp-controller="Subscription"
                  asp-action="Buy"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="SubscriptionPlanId" type="hidden" />
                <input asp-for="PlanName" type="hidden" />
                <input asp-for="Amount" type="hidden" />
                <input asp-for="DurationDays" type="hidden" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger"
                     style="margin-bottom:20px;">
                </div>


                <h3 style="
                    font-family:'Fraunces',serif;
                    margin-bottom:25px;">
                    Restaurant Details
                </h3>


                <!-- Restaurant Name -->

                <div class="mb-3">
                    <label asp-for="RestaurantName"
                           class="form-label">
                        Restaurant Name
                    </label>

                    <input asp-for="RestaurantName"
                           class="form-control" />

                    <span asp-validation-for="RestaurantName"
                          class="text-danger">
                    </span>
                </div>


                <!-- Owner Name -->

                <div class="mb-3">
                    <label asp-for="OwnerName"
                           class="form-label">
                        Owner Name
                    </label>

                    <input asp-for="OwnerName"
                           class="form-control" />

                    <span asp-validation-for="OwnerName"
                          class="text-danger">
                    </span>
                </div>


                <!-- Email -->

                <div class="mb-3">
                    <label asp-for="Email"
                           class="form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>
                </div>


                <!-- Phone -->

                <div class="mb-3">
                    <label asp-for="Phone"
                           class="form-label">
                        Phone Number
                    </label>

                    <input asp-for="Phone"
                           class="form-control" />

                    <span asp-validation-for="Phone"
                          class="text-danger">
                    </span>
                </div>


                <!-- Address -->

                <div class="mb-3">
                    <label asp-for="Address"
                           class="form-label">
                        Address
                    </label>

                    <textarea asp-for="Address"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="Address"
                          class="text-danger">
                    </span>
                </div>


                <!-- Start Date -->

                <div class="mb-3">
                    <label asp-for="StartDate"
                           class="form-label">
                        Subscription Start Date
                    </label>

                    <input asp-for="StartDate"
                           class="form-control" />

                    <span asp-validation-for="StartDate"
                          class="text-danger">
                    </span>

                    <small style="color:var(--text-dim);">
                        Select the date from which your subscription should start.
                    </small>
                </div>




                <!-- Continue -->

                <button type="submit"
                        class="btn-gold"
                        style="border:none; padding:14px 30px;">

                    CONTINUE TO PAYMENT

                </button>

            </form>

        </div>

    </div>
</section>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}