@model RestaurantQR.ViewModels.PurchaseSubscriptionViewModel

@{
    ViewData["Title"] = "Payment Checkout";

    // Old public black layout intentionally disabled
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Payment Checkout - RestaurantQR</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>

        :root {
            --rq-white: #FFFDF7;
            --rq-cream: #F5E6CA;
            --rq-beige: #DCC7AA;
            --rq-coffee: #6F4E37;
            --rq-espresso: #4B3832;
            --rq-deep: #352822;
            --rq-gold: #B8894D;
            --rq-muted: #8B7565;
            --rq-danger: #965044;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
            background: var(--rq-cream);
            color: var(--rq-espresso);
            overflow-x: hidden;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
        }


        /* =========================================================
                   FULL PAGE
                   ========================================================= */

        .checkout-page {
            position: relative;
            min-height: 100vh;
            padding: 28px 28px 45px;
            background: radial-gradient( circle at 7% 13%, rgba(255,255,255,.96), transparent 30% ), radial-gradient( circle at 93% 11%, rgba(220,199,170,.65), transparent 31% ), linear-gradient( 135deg, #FFFDF7 0%, #FAF1E2 40%, #F5E6CA 70%, #EAD5B4 100% );
            overflow: hidden;
        }

            .checkout-page::before {
                content: "";
                position: fixed;
                width: 430px;
                height: 430px;
                left: -220px;
                top: 210px;
                border-radius: 50%;
                background: rgba(111,78,55,.045);
                pointer-events: none;
            }

            .checkout-page::after {
                content: "";
                position: fixed;
                width: 520px;
                height: 520px;
                right: -270px;
                bottom: -250px;
                border-radius: 50%;
                background: rgba(184,137,77,.075);
                pointer-events: none;
            }


        /* =========================================================
                   NAVBAR
                   ========================================================= */

        .checkout-navbar {
            position: relative;
            z-index: 100;
            width: min(1180px, 100%);
            height: 82px;
            margin: 0 auto 50px;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            padding: 0 18px;
            border: 1px solid rgba(255,255,255,.96);
            border-radius: 44px;
            background: rgba(255,253,247,.91);
            box-shadow: 0 18px 50px rgba(75,56,50,.13), inset 0 1px 0 rgba(255,255,255,.96);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
        }

        .checkout-brand {
            grid-column: 2;
            text-align: center;
            text-decoration: none;
            white-space: nowrap;
        }

        .checkout-brand-main {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 27px;
            font-weight: 700;
            letter-spacing: -.9px;
            color: var(--rq-espresso);
        }

            .checkout-brand-main span {
                color: var(--rq-gold);
                font-style: italic;
            }

        .checkout-brand-sub {
            display: block;
            margin-top: 6px;
            color: rgba(75,56,50,.48);
            font-size: 7px;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
        }

        .checkout-nav-right {
            grid-column: 3;
            justify-self: end;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .checkout-home-btn {
            min-height: 45px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 18px;
            border: 1px solid rgba(111,78,55,.15);
            border-radius: 24px;
            background: rgba(245,230,202,.42);
            color: var(--rq-coffee);
            text-decoration: none;
            font-size: 11px;
            font-weight: 700;
            transition: .25s ease;
        }

            .checkout-home-btn:hover {
                color: var(--rq-white);
                background: var(--rq-coffee);
                transform: translateY(-2px);
            }


        /* =========================================================
                   CONTENT
                   ========================================================= */

        .checkout-container {
            position: relative;
            z-index: 5;
            width: min(1000px, 100%);
            margin: 0 auto;
        }


        /* =========================================================
                   HERO
                   ========================================================= */

        .checkout-hero {
            margin-bottom: 34px;
            animation: checkoutFade .65s ease both;
        }

        .checkout-eyebrow {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 15px;
            color: var(--rq-coffee);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
        }

            .checkout-eyebrow::before {
                content: "";
                width: 46px;
                height: 1px;
                background: var(--rq-gold);
            }

        .checkout-title {
            margin: 0;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(52px, 7vw, 78px);
            font-weight: 400;
            line-height: .95;
            letter-spacing: -4px;
            color: var(--rq-espresso);
        }

            .checkout-title em {
                color: var(--rq-coffee);
                font-style: italic;
                font-weight: 400;
            }

        .checkout-description {
            max-width: 700px;
            margin: 20px 0 0;
            color: var(--rq-muted);
            font-size: 14px;
            line-height: 1.8;
        }


        /* =========================================================
                   SUMMARY GRID
                   ========================================================= */

        .checkout-summary-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
            margin-bottom: 20px;
        }

        .checkout-card {
            position: relative;
            overflow: hidden;
            padding: 28px;
            border: 1px solid rgba(255,255,255,.96);
            border-radius: 27px;
            background: linear-gradient( 135deg, rgba(255,253,247,.92), rgba(245,230,202,.58) );
            box-shadow: 0 22px 60px rgba(75,56,50,.09);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            animation: checkoutFade .72s ease both;
        }

            .checkout-card:nth-child(2) {
                animation-delay: .06s;
            }

            .checkout-card::before {
                content: "";
                position: absolute;
                width: 180px;
                height: 180px;
                right: -85px;
                top: -90px;
                border-radius: 50%;
                background: rgba(220,199,170,.28);
            }

        .checkout-card-label {
            position: relative;
            z-index: 1;
            display: block;
            margin-bottom: 13px;
            color: var(--rq-muted);
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
        }

        .checkout-plan-name {
            position: relative;
            z-index: 1;
            margin: 0 0 12px;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 29px;
            font-weight: 400;
            color: var(--rq-espresso);
        }

        .checkout-price {
            position: relative;
            z-index: 1;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 40px;
            color: var(--rq-coffee);
        }

        .checkout-duration {
            position: relative;
            z-index: 1;
            margin-top: 8px;
            color: var(--rq-muted);
            font-size: 12px;
        }


        /* =========================================================
                   RESTAURANT DETAILS
                   ========================================================= */

        .checkout-detail-row {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 18px;
            padding: 11px 0;
            border-bottom: 1px solid rgba(75,56,50,.08);
        }

            .checkout-detail-row:last-child {
                border-bottom: 0;
            }

        .checkout-detail-label {
            color: var(--rq-muted);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.4px;
            text-transform: uppercase;
        }

        .checkout-detail-value {
            max-width: 65%;
            color: var(--rq-coffee);
            text-align: right;
            font-size: 13px;
            font-weight: 600;
            word-break: break-word;
        }


        /* =========================================================
                   PAYMENT CARD
                   ========================================================= */

        .payment-panel {
            position: relative;
            overflow: hidden;
            padding: 32px;
            border: 1px solid rgba(255,255,255,.96);
            border-radius: 30px;
            background: linear-gradient( 135deg, rgba(255,253,247,.94), rgba(245,230,202,.60) );
            box-shadow: 0 25px 70px rgba(75,56,50,.10);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            animation: checkoutFade .8s ease both;
        }

            .payment-panel::before {
                content: "";
                position: absolute;
                width: 220px;
                height: 220px;
                right: -100px;
                top: -115px;
                border-radius: 50%;
                background: rgba(220,199,170,.30);
            }


        /* =========================================================
                   PAYMENT HEADER
                   ========================================================= */

        .payment-panel-header {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding-bottom: 23px;
            margin-bottom: 25px;
            border-bottom: 1px solid rgba(75,56,50,.10);
        }

        .payment-heading {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .payment-icon {
            width: 52px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 17px;
            background: var(--rq-coffee);
            color: var(--rq-white);
            font-size: 20px;
            box-shadow: 0 12px 27px rgba(111,78,55,.20);
        }

        .payment-heading h2 {
            margin: 0;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 24px;
            font-weight: 400;
            color: var(--rq-espresso);
        }

        .payment-heading span {
            display: block;
            margin-top: 4px;
            color: var(--rq-muted);
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .secure-tag {
            color: var(--rq-gold);
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }


        /* =========================================================
                   FORM
                   ========================================================= */

        .payment-form {
            position: relative;
            z-index: 2;
        }

        .payment-group {
            margin-bottom: 22px;
        }

        .payment-label {
            display: block;
            margin-bottom: 9px;
            color: var(--rq-espresso);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.4px;
            text-transform: uppercase;
        }

            .payment-label::before {
                content: "•";
                margin-right: 7px;
                color: var(--rq-gold);
            }

        .payment-select {
            width: 100%;
            min-height: 57px;
            padding: 14px 17px;
            border: 1px solid rgba(111,78,55,.16);
            border-radius: 15px;
            outline: none;
            background: rgba(255,255,255,.75);
            color: var(--rq-espresso);
            font-size: 14px;
            cursor: pointer;
            transition: .25s ease;
        }

            .payment-select:hover {
                background: rgba(255,255,255,.95);
                border-color: rgba(111,78,55,.25);
            }

            .payment-select:focus {
                background: var(--rq-white);
                border-color: var(--rq-gold);
                box-shadow: 0 0 0 4px rgba(184,137,77,.10), 0 10px 28px rgba(75,56,50,.07);
                transform: translateY(-1px);
            }

        .payment-validation {
            display: block;
            margin-top: 7px;
            color: var(--rq-danger);
            font-size: 11px;
        }


        /* =========================================================
                   AMOUNT
                   ========================================================= */

        .amount-box {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 24px;
            padding: 19px 20px;
            border: 1px solid rgba(111,78,55,.12);
            border-radius: 18px;
            background: rgba(245,230,202,.36);
        }

        .amount-copy span {
            display: block;
            margin-bottom: 5px;
            color: var(--rq-muted);
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .amount-copy strong {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 31px;
            font-weight: 400;
            color: var(--rq-coffee);
        }

        .amount-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 15px;
            background: var(--rq-espresso);
            color: var(--rq-white);
            font-size: 18px;
        }


        /* =========================================================
                   INFO STRIP
                   ========================================================= */

        .payment-info {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 10px;
            margin-bottom: 25px;
        }

        .payment-info-item {
            padding: 13px;
            border-radius: 13px;
            background: rgba(245,230,202,.30);
            color: var(--rq-muted);
            font-size: 10px;
            line-height: 1.5;
        }

            .payment-info-item strong {
                display: block;
                margin-bottom: 3px;
                color: var(--rq-coffee);
                font-size: 10px;
            }


        /* =========================================================
                   SUBMIT
                   ========================================================= */

        .payment-submit {
            width: 100%;
            min-height: 57px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 0 13px 0 22px;
            border: 0;
            border-radius: 30px;
            background: linear-gradient( 135deg, var(--rq-espresso), var(--rq-coffee) );
            color: var(--rq-white);
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 14px 30px rgba(75,56,50,.20);
            transition: .25s ease;
        }

            .payment-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 19px 38px rgba(75,56,50,.25);
            }

        .payment-submit-arrow {
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(255,255,255,.14);
            font-size: 16px;
        }


        /* =========================================================
                   FOOTER
                   ========================================================= */

        .checkout-footer {
            position: relative;
            z-index: 5;
            width: min(1180px,100%);
            min-height: 62px;
            margin: 45px auto 0;
            padding: 0 27px;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            border-radius: 34px;
            background: var(--rq-espresso);
            color: var(--rq-white);
            box-shadow: 0 18px 45px rgba(75,56,50,.21);
        }

        .checkout-footer-brand {
            font-family: Georgia, serif;
            font-size: 15px;
            font-weight: 700;
        }

            .checkout-footer-brand span {
                color: var(--rq-gold);
                font-style: italic;
            }

        .checkout-footer-center {
            color: rgba(255,253,247,.60);
            font-size: 8px;
            letter-spacing: 4px;
            text-transform: uppercase;
        }

        .checkout-footer-status {
            justify-self: end;
            display: flex;
            align-items: center;
            gap: 8px;
            color: rgba(255,253,247,.75);
            font-size: 9px;
        }

        .footer-status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #A8B86A;
            box-shadow: 0 0 0 5px rgba(168,184,106,.10);
        }


        /* =========================================================
                   ANIMATION
                   ========================================================= */

        @@keyframes checkoutFade {

            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }


        /* =========================================================
                   TABLET
                   ========================================================= */

        @@media (max-width: 850px) {

            .checkout-page {
                padding: 16px 18px 35px;
            }

            .checkout-navbar {
                height: 72px;
                margin-bottom: 38px;
            }

            .checkout-summary-grid {
                grid-template-columns: 1fr;
            }

            .payment-info {
                grid-template-columns: 1fr;
            }
        }


        /* =========================================================
                   MOBILE
                   ========================================================= */

        @@media (max-width: 600px) {

            .checkout-page {
                padding: 10px 10px 25px;
            }

            .checkout-navbar {
                height: 65px;
                padding: 0 10px;
                margin-bottom: 30px;
                border-radius: 34px;
            }

            .checkout-brand-main {
                font-size: 18px;
            }

            .checkout-brand-sub {
                margin-top: 4px;
                font-size: 5px;
                letter-spacing: 2px;
            }

            .checkout-home-btn {
                width: 42px;
                height: 42px;
                min-height: 42px;
                padding: 0;
                border-radius: 50%;
                font-size: 0;
            }

                .checkout-home-btn::before {
                    content: "⌂";
                    font-size: 15px;
                }

            .checkout-eyebrow {
                gap: 9px;
                font-size: 8px;
                letter-spacing: 2.5px;
            }

                .checkout-eyebrow::before {
                    width: 28px;
                }

            .checkout-title {
                font-size: 44px;
                letter-spacing: -2px;
            }

            .checkout-description {
                margin-top: 14px;
                font-size: 13px;
                line-height: 1.65;
            }

            .checkout-card,
            .payment-panel {
                padding: 20px 16px;
                border-radius: 22px;
            }

            .payment-panel-header {
                align-items: flex-start;
            }

            .payment-icon {
                width: 44px;
                height: 44px;
                border-radius: 14px;
            }

            .payment-heading h2 {
                font-size: 20px;
            }

            .secure-tag {
                display: none;
            }

            .checkout-detail-row {
                flex-direction: column;
                gap: 5px;
            }

            .checkout-detail-value {
                max-width: 100%;
                text-align: left;
            }

            .amount-copy strong {
                font-size: 26px;
            }

            .checkout-footer {
                min-height: 52px;
                padding: 0 14px;
                border-radius: 28px;
            }

            .checkout-footer-center {
                display: none;
            }

            .checkout-footer-brand {
                font-size: 12px;
            }

            .checkout-footer-status {
                font-size: 8px;
            }
        }

    </style>

</head>


<body>


    <div class="checkout-page">


        <!-- =========================================================
             NAVBAR
             ========================================================= -->

        <nav class="checkout-navbar">


            <div></div>


            <a asp-controller="Home"
               asp-action="Index"
               class="checkout-brand">

                <div class="checkout-brand-main">

                    Restaurant<span>QR</span>

                </div>

                <span class="checkout-brand-sub">

                    Smart Dining

                </span>

            </a>


            <div class="checkout-nav-right">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="checkout-home-btn">

                    Home

                </a>

            </div>


        </nav>


        <!-- =========================================================
             MAIN
             ========================================================= -->

        <main class="checkout-container">


            <!-- HERO -->

            <section class="checkout-hero">

                <div class="checkout-eyebrow">

                    PAYMENT CHECKOUT

                </div>


                <h1 class="checkout-title">

                    Complete Your
                    <em>Payment.</em>

                </h1>


                <p class="checkout-description">

                    Review your RestaurantQR subscription,
                    confirm your restaurant details and select
                    your preferred payment method.

                </p>

            </section>


            <!-- =====================================================
                 SUMMARY
                 ===================================================== -->

            <div class="checkout-summary-grid">


                <!-- PLAN -->

                <section class="checkout-card">

                    <span class="checkout-card-label">

                        Subscription Summary

                    </span>


                    <h2 class="checkout-plan-name">

                        @Model.PlanName

                    </h2>


                    <div class="checkout-price">

                        ₹@Model.Amount.ToString("N0")

                    </div>


                    <div class="checkout-duration">

                        @Model.DurationDays days access

                    </div>

                </section>


                <!-- RESTAURANT -->

                <section class="checkout-card">

                    <span class="checkout-card-label">

                        Restaurant Details

                    </span>


                    <div class="checkout-detail-row">

                        <span class="checkout-detail-label">

                            Restaurant

                        </span>

                        <span class="checkout-detail-value">

                            @Model.RestaurantName

                        </span>

                    </div>


                    <div class="checkout-detail-row">

                        <span class="checkout-detail-label">

                            Owner

                        </span>

                        <span class="checkout-detail-value">

                            @Model.OwnerName

                        </span>

                    </div>


                    <div class="checkout-detail-row">

                        <span class="checkout-detail-label">

                            Email

                        </span>

                        <span class="checkout-detail-value">

                            @Model.Email

                        </span>

                    </div>


                    <div class="checkout-detail-row">

                        <span class="checkout-detail-label">

                            Phone

                        </span>

                        <span class="checkout-detail-value">

                            @Model.Phone

                        </span>

                    </div>


                    <div class="checkout-detail-row">

                        <span class="checkout-detail-label">

                            Start Date

                        </span>

                        <span class="checkout-detail-value">

                            @Model.StartDate.ToString("dd MMM yyyy")

                        </span>

                    </div>

                </section>


            </div>


            <!-- =====================================================
                 PAYMENT FORM
                 ===================================================== -->

            <section class="payment-panel">


                <div class="payment-panel-header">


                    <div class="payment-heading">


                        <div class="payment-icon">

                            ₹

                        </div>


                        <div>

                            <h2>

                                Select Payment Method

                            </h2>

                            <span>

                                Secure Subscription Checkout

                            </span>

                        </div>


                    </div>


                    <span class="secure-tag">

                        Secure Payment

                    </span>


                </div>


                <form asp-controller="Subscription"
                      asp-action="PaymentCheckout"
                      method="post"
                      class="payment-form">


                    @Html.AntiForgeryToken()


                    <input asp-for="SubscriptionPlanId"
                           type="hidden" />

                    <input asp-for="RestaurantName"
                           type="hidden" />

                    <input asp-for="OwnerName"
                           type="hidden" />

                    <input asp-for="Email"
                           type="hidden" />

                    <input asp-for="Phone"
                           type="hidden" />

                    <input asp-for="Address"
                           type="hidden" />

                    <input asp-for="StartDate"
                           type="hidden" />

                    <input asp-for="PlanName"
                           type="hidden" />

                    <input asp-for="Amount"
                           type="hidden" />

                    <input asp-for="DurationDays"
                           type="hidden" />


                    <!-- PAYMENT METHOD -->

                    <div class="payment-group">

                        <label asp-for="PaymentMethod"
                               class="payment-label">

                            Payment Method

                        </label>


                        <select asp-for="PaymentMethod"
                                asp-items="Html.GetEnumSelectList<RestaurantQR.Models.PaymentMethod>()"
                                class="payment-select">

                            <option value="">

                                Select Payment Method

                            </option>

                        </select>


                        <span asp-validation-for="PaymentMethod"
                              class="payment-validation">
                        </span>


                    </div>


                    <!-- AMOUNT -->

                    <div class="amount-box">


                        <div class="amount-copy">

                            <span>

                                Amount To Pay

                            </span>

                            <strong>

                                ₹@Model.Amount.ToString("N0")

                            </strong>

                        </div>


                        <div class="amount-icon">

                            ₹

                        </div>


                    </div>


                    <!-- INFO -->

                    <div class="payment-info">


                        <div class="payment-info-item">

                            <strong>

                                Subscription

                            </strong>

                            @Model.PlanName for @Model.DurationDays days.

                        </div>


                        <div class="payment-info-item">

                            <strong>

                                Restaurant

                            </strong>

                            Payment is linked to @Model.RestaurantName.

                        </div>


                        <div class="payment-info-item">

                            <strong>

                                Secure Checkout

                            </strong>

                            Protected using anti-forgery validation.

                        </div>


                    </div>


                    <!-- PAY -->

                    <button type="submit"
                            class="payment-submit">


                        <span>

                            Confirm & Pay
                            ₹@Model.Amount.ToString("N0")

                        </span>


                        <span class="payment-submit-arrow">

                            →

                        </span>


                    </button>


                </form>


            </section>


        </main>


        <!-- =========================================================
             FOOTER
             ========================================================= -->

        <footer class="checkout-footer">


            <div class="checkout-footer-brand">

                Restaurant<span>QR</span>

            </div>


            <div class="checkout-footer-center">

                Smart Dining · Secure Checkout

            </div>


            <div class="checkout-footer-status">

                <span class="footer-status-dot">
                </span>

                Secure Payment

            </div>


        </footer>


    </div>


    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <partial name="_ValidationScriptsPartial" />


</body>

</html>