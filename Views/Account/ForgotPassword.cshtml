                <!-- =============================================
                     NOTE
                     ============================================= -->

                <div class="note">

                    <i class="bi bi-info-circle"></i>

                    <span>

                        Please use the same email address associated
                        with your RestaurantQR account so the
                        administrator can identify your account.

                    </span>

                </div>


            </section>

        </div>


        <!-- =====================================================
             FOOTER
             ===================================================== -->

        <footer class="footer">

            <div class="footer-brand">

                Restaurant<span>QR</span>

            </div>


            <div class="footer-copy">

                Smart Dining · Simplified

            </div>

        </footer>

    </main>


    <!-- =========================================================
         EMAIL SCRIPT
         ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const emailInput =
                    document.getElementById(
                        "userEmail"
                    );


                const emailButton =
                    document.getElementById(
                        "emailAdminButton"
                    );


                if (
                    !emailInput ||
                    !emailButton
                ) {

                    return;

                }


                function sendResetRequest() {

                    const userEmail =
                        emailInput.value.trim();


                    /* =========================================
                       EMPTY EMAIL
                       ========================================= */

                    if (!userEmail) {

                        emailInput.focus();

                        return;

                    }


                    /* =========================================
                       INVALID EMAIL
                       ========================================= */

                    if (!emailInput.checkValidity()) {

                        emailInput.reportValidity();

                        return;

                    }


                    /* =========================================
                       SUPER ADMIN EMAIL
                       ========================================= */

                    const adminEmail =
                        "talhask407@gmail.com";


                    /* =========================================
                       EMAIL SUBJECT
                       ========================================= */

                    const subject =
                        encodeURIComponent(

                            "RestaurantQR Password Reset Request"

                        );


                    /* =========================================
                       EMAIL BODY
                       ========================================= */

                    const body =
                        encodeURIComponent(

                            "Hello Super Admin,\n\n" +

                            "I am unable to access my RestaurantQR " +
                            "account and would like to request a " +
                            "password reset.\n\n" +

                            "Registered Email: " +
                            userEmail +
                            "\n\n" +

                            "Please assist me with resetting my " +
                            "RestaurantQR account password.\n\n" +

                            "Thank you."

                        );


                    /* =========================================
                       OPEN EMAIL CLIENT
                       ========================================= */

                    window.location.href =

                        "mailto:" +
                        adminEmail +

                        "?subject=" +
                        subject +

                        "&body=" +
                        body;

                }


                /* =============================================
                   BUTTON CLICK
                   ============================================= */

                emailButton.addEventListener(
                    "click",
                    sendResetRequest
                );


                /* =============================================
                   ENTER KEY
                   ============================================= */

                emailInput.addEventListener(
                    "keydown",
                    function (event) {

                        if (event.key === "Enter") {

                            event.preventDefault();

                            sendResetRequest();

                        }

                    }
                );

            }
        );

    </script>

</body>

</html>