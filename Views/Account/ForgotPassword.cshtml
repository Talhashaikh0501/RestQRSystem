@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Forgot Password | RestaurantQR</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <style>

        /* =========================================================
                   RESTAURANT QR
                   FORGOT PASSWORD
                   LUXURY COFFEE THEME
                   ========================================================= */

        :root {
            --rq-cream: #F5E6CA;
            --rq-light: #FFFDF7;
            --rq-beige: #DCC7AA;
            --rq-coffee: #6F4E37;
            --rq-espresso: #4B3832;
            --rq-deep: #352822;
            --rq-gold: #B8894D;
            --rq-muted: #8B7565;
            --rq-line: rgba(111, 78, 55, .16);
        }


        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }


        html,
        body {
            width: 100%;
            min-height: 100%;
        }


        body {
            min-height: 100vh;
            overflow-x: hidden;
            font-family: "Inter", sans-serif;
            color: var(--rq-espresso);
            background: radial-gradient( circle at 10% 10%, rgba(255,255,255,.98), transparent 28% ), radial-gradient( circle at 90% 12%, rgba(220,199,170,.75), transparent 30% ), radial-gradient( circle at 80% 90%, rgba(184,137,77,.13), transparent 30% ), linear-gradient( 135deg, #FFFDF7 0%, #F8ECD6 40%, #F0DDBD 100% );
        }


        /* =========================================================
                   DECORATIVE BACKGROUND
                   ========================================================= */

        .page-shell {
            position: relative;
            width: 100%;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 130px 24px 90px;
            overflow: hidden;
        }


            .page-shell::before {
                content: "";
                position: fixed;
                width: 520px;
                height: 520px;
                left: -270px;
                top: 10%;
                border: 1px solid rgba(111,78,55,.10);
                border-radius: 50%;
                pointer-events: none;
            }


            .page-shell::after {
                content: "";
                position: fixed;
                width: 650px;
                height: 650px;
                right: -340px;
                bottom: -330px;
                border-radius: 50%;
                background: rgba(184,137,77,.07);
                pointer-events: none;
            }


        .decor-ring {
            position: fixed;
            width: 260px;
            height: 260px;
            right: 8%;
            top: 12%;
            border-radius: 50%;
            border: 1px solid rgba(184,137,77,.15);
            pointer-events: none;
            animation: floatRing 8s ease-in-out infinite;
        }


            .decor-ring::after {
                content: "";
                position: absolute;
                inset: 32px;
                border-radius: inherit;
                border: 1px solid rgba(111,78,55,.08);
            }


        @@keyframes floatRing {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-18px);
            }
        }


        /* =========================================================
                   TOP DYNAMIC ISLAND
                   ========================================================= */

        .top-island {
            position: fixed;
            z-index: 1000;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: min(1180px, calc(100% - 44px));
            height: 82px;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            padding: 0 28px;
            border: 1px solid rgba(255,255,255,.95);
            border-radius: 45px;
            background: rgba(255,253,247,.88);
            box-shadow: 0 18px 50px rgba(75,56,50,.12), inset 0 1px 0 rgba(255,255,255,.95);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
        }


        /* =========================================================
                   NAV LEFT
                   ========================================================= */

        .nav-left {
            justify-self: start;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(75,56,50,.52);
        }


        .nav-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--rq-gold);
            box-shadow: 0 0 0 6px rgba(184,137,77,.10);
        }


        /* =========================================================
                   BRAND
                   ========================================================= */

        .brand {
            grid-column: 2;
            text-decoration: none;
            text-align: center;
            color: var(--rq-espresso);
        }


        .brand-main {
            font-family: "Playfair Display", Georgia, serif;
            font-size: 25px;
            font-weight: 700;
            line-height: 1;
            letter-spacing: -.7px;
        }


            .brand-main span {
                color: var(--rq-gold);
                font-style: italic;
            }


        .brand-sub {
            display: block;
            margin-top: 6px;
            font-size: 7px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: rgba(75,56,50,.50);
        }


        /* =========================================================
                   NAV RIGHT
                   ========================================================= */

        .nav-right {
            justify-self: end;
            display: flex;
            align-items: center;
        }


        .secure-pill {
            min-height: 42px;
            padding: 0 17px;
            display: flex;
            align-items: center;
            gap: 9px;
            border-radius: 24px;
            background: var(--rq-espresso);
            color: var(--rq-light);
            font-size: 9px;
            font-weight: 600;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            box-shadow: 0 10px 24px rgba(75,56,50,.18);
        }


            .secure-pill i {
                color: #E5C58F;
                font-size: 13px;
            }


        /* =========================================================
                   MAIN WRAPPER
                   ========================================================= */

        .forgot-wrapper {
            position: relative;
            z-index: 5;
            width: 100%;
            max-width: 1040px;
            display: grid;
            grid-template-columns: minmax(0, .9fr) minmax(400px, 1fr);
            align-items: center;
            gap: 75px;
        }


        /* =========================================================
                   LEFT CONTENT
                   ========================================================= */

        .forgot-intro {
            padding: 20px 0;
        }


        .eyebrow {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 24px;
            color: var(--rq-coffee);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 3.5px;
            text-transform: uppercase;
        }


            .eyebrow::before {
                content: "";
                width: 44px;
                height: 1px;
                background: var(--rq-gold);
            }


        .forgot-intro h1 {
            max-width: 520px;
            margin: 0;
            font-family: "Playfair Display", Georgia, serif;
            font-size: clamp(50px, 6vw, 78px);
            font-weight: 500;
            line-height: .98;
            letter-spacing: -3px;
            color: var(--rq-espresso);
        }


            .forgot-intro h1 em {
                display: block;
                color: var(--rq-coffee);
                font-weight: 500;
            }


        .intro-text {
            max-width: 490px;
            margin-top: 28px;
            color: var(--rq-muted);
            font-size: 15px;
            line-height: 1.85;
        }


        /* =========================================================
                   SECURITY FEATURE
                   ========================================================= */

        .security-feature {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-top: 35px;
        }


        .security-icon {
            width: 52px;
            height: 52px;
            flex: 0 0 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 17px;
            background: var(--rq-espresso);
            color: #E7C48D;
            font-size: 18px;
            box-shadow: 0 14px 30px rgba(75,56,50,.17);
        }


        .security-text strong {
            display: block;
            margin-bottom: 5px;
            font-family: "Playfair Display", serif;
            font-size: 16px;
            color: var(--rq-espresso);
        }


        .security-text span {
            color: var(--rq-muted);
            font-size: 12px;
            line-height: 1.5;
        }


        /* =========================================================
                   PASSWORD CARD
                   ========================================================= */

        .forgot-card {
            position: relative;
            width: 100%;
            padding: 48px 44px 40px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.94);
            border-radius: 34px;
            background: rgba(255,253,247,.80);
            box-shadow: 0 30px 75px rgba(75,56,50,.15), inset 0 1px 0 rgba(255,255,255,.95);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
        }


            .forgot-card::before {
                content: "";
                position: absolute;
                width: 170px;
                height: 170px;
                top: -100px;
                right: -80px;
                border-radius: 50%;
                background: rgba(184,137,77,.12);
            }


        .card-top {
            position: relative;
            z-index: 2;
            margin-bottom: 30px;
        }


        .lock-icon {
            width: 64px;
            height: 64px;
            margin-bottom: 23px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 21px;
            background: var(--rq-espresso);
            color: #E6C185;
            font-size: 24px;
            box-shadow: 0 14px 32px rgba(75,56,50,.20);
            animation: lockFloat 4s ease-in-out infinite;
        }


        @@keyframes lockFloat {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-5px);
            }
        }


        .card-label {
            display: block;
            margin-bottom: 8px;
            color: var(--rq-gold);
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
        }


        .card-title {
            margin: 0;
            font-family: "Playfair Display", Georgia, serif;
            font-size: 30px;
            font-weight: 600;
            color: var(--rq-espresso);
        }


        .card-description {
            margin-top: 10px;
            color: var(--rq-muted);
            font-size: 13px;
            line-height: 1.7;
        }


        /* =========================================================
                   SUPER ADMIN CARD
                   ========================================================= */

        .admin-box {
            position: relative;
            margin-bottom: 24px;
            padding: 18px 19px;
            display: flex;
            align-items: center;
            gap: 14px;
            border: 1px solid rgba(111,78,55,.13);
            border-radius: 18px;
            background: rgba(245,230,202,.38);
        }


        .admin-icon {
            width: 44px;
            height: 44px;
            flex: 0 0 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: rgba(111,78,55,.10);
            color: var(--rq-coffee);
            font-size: 17px;
        }


        .admin-details {
            min-width: 0;
        }


        .admin-label {
            margin-bottom: 5px;
            color: var(--rq-muted);
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }


        .admin-email {
            color: var(--rq-espresso);
            font-family: "Playfair Display", Georgia, serif;
            font-size: 14px;
            font-weight: 600;
            word-break: break-word;
        }


        /* =========================================================
                   FORM
                   ========================================================= */

        .form-group {
            margin-bottom: 20px;
        }


        .form-label {
            display: block;
            margin: 0 0 9px 3px;
            color: var(--rq-coffee);
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }


        .input-wrapper {
            position: relative;
        }


        .input-icon {
            position: absolute;
            z-index: 2;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--rq-gold);
            font-size: 16px;
            pointer-events: none;
        }


        .form-input {
            width: 100%;
            height: 58px;
            padding: 0 18px 0 50px;
            border: 1px solid rgba(111,78,55,.18);
            border-radius: 18px;
            outline: none;
            background: rgba(255,255,255,.72);
            color: var(--rq-espresso);
            font-family: "Inter", sans-serif;
            font-size: 13px;
            transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease, background .25s ease;
        }


            .form-input::placeholder {
                color: rgba(139,117,101,.60);
            }


            .form-input:hover {
                border-color: rgba(184,137,77,.38);
            }


            .form-input:focus {
                border-color: var(--rq-gold);
                background: #FFFDF9;
                box-shadow: 0 0 0 4px rgba(184,137,77,.10);
                transform: translateY(-1px);
            }


        /* =========================================================
                   EMAIL BUTTON
                   ========================================================= */

        .email-button {
            position: relative;
            width: 100%;
            height: 58px;
            margin-top: 5px;
            padding: 0 20px;
            border: 0;
            border-radius: 29px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--rq-espresso);
            color: var(--rq-light);
            cursor: pointer;
            font-family: "Inter", sans-serif;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .3px;
            box-shadow: 0 16px 32px rgba(75,56,50,.20);
            transition: transform .25s ease, box-shadow .25s ease;
        }


            .email-button::before {
                content: "";
                position: absolute;
                width: 100px;
                height: 100px;
                left: -110px;
                top: -20px;
                border-radius: 50%;
                background: rgba(255,255,255,.09);
                transition: left .45s ease;
            }


            .email-button:hover::before {
                left: calc(100% - 45px);
            }


            .email-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 20px 40px rgba(75,56,50,.26);
            }


        .button-left {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 11px;
        }


            .button-left i {
                color: #E8C58F;
                font-size: 16px;
            }


        .button-arrow {
            position: relative;
            z-index: 2;
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(255,255,255,.12);
            transition: transform .25s ease;
        }


        .email-button:hover
        .button-arrow {
            transform: translateX(3px);
        }


        /* =========================================================
                   BACK LINK
                   ========================================================= */

        .back-wrapper {
            margin-top: 24px;
            text-align: center;
        }


        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--rq-muted);
            text-decoration: none;
            font-size: 11px;
            font-weight: 600;
            transition: color .2s ease, transform .2s ease;
        }


            .back-link:hover {
                color: var(--rq-coffee);
                transform: translateX(-3px);
            }


        /* =========================================================
                   NOTE
                   ========================================================= */

        .note {
            margin-top: 25px;
            padding-top: 21px;
            border-top: 1px solid var(--rq-line);
            display: flex;
            gap: 10px;
            color: var(--rq-muted);
            font-size: 10px;
            line-height: 1.65;
        }


            .note i {
                flex: 0 0 auto;
                margin-top: 2px;
                color: var(--rq-gold);
            }


        /* =========================================================
                   FOOTER
                   ========================================================= */

        .footer {
            position: absolute;
            z-index: 5;
            left: 50%;
            bottom: 24px;
            transform: translateX(-50%);
            width: min(1180px, calc(100% - 44px));
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: rgba(75,56,50,.48);
            font-size: 8px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }


        .footer-brand {
            font-family: "Playfair Display", Georgia, serif;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0;
            text-transform: none;
            color: var(--rq-espresso);
        }


            .footer-brand span {
                color: var(--rq-gold);
                font-style: italic;
            }


        /* =========================================================
                   RESPONSIVE
                   ========================================================= */

        @@media (max-width: 900px) {

            .page-shell {
                align-items: flex-start;
                padding-top: 130px;
                padding-bottom: 100px;
            }


            .forgot-wrapper {
                max-width: 620px;
                grid-template-columns: 1fr;
                gap: 42px;
            }


            .forgot-intro {
                text-align: center;
            }


            .eyebrow {
                justify-content: center;
            }


            .intro-text {
                margin-left: auto;
                margin-right: auto;
            }


            .security-feature {
                max-width: 390px;
                margin-left: auto;
                margin-right: auto;
                text-align: left;
            }


            .forgot-intro h1 {
                margin-left: auto;
                margin-right: auto;
            }
        }


        @@media (max-width: 650px) {

            .top-island {
                top: 12px;
                width: calc(100% - 20px);
                height: 68px;
                padding: 0 17px;
                border-radius: 36px;
            }


            .nav-left {
                display: none;
            }


            .top-island {
                grid-template-columns: 1fr auto;
            }


            .brand {
                grid-column: 1;
                justify-self: start;
                text-align: left;
            }


            .brand-main {
                font-size: 19px;
            }


            .brand-sub {
                font-size: 5px;
                letter-spacing: 2.5px;
            }


            .nav-right {
                grid-column: 2;
            }


            .secure-pill {
                width: 42px;
                height: 42px;
                min-height: 42px;
                padding: 0;
                justify-content: center;
                border-radius: 50%;
            }


                .secure-pill span {
                    display: none;
                }


            .page-shell {
                padding: 105px 14px 95px;
            }


            .forgot-wrapper {
                gap: 30px;
            }


            .forgot-intro h1 {
                font-size: clamp(43px, 14vw, 60px);
                letter-spacing: -2px;
            }


            .intro-text {
                margin-top: 20px;
                font-size: 13px;
                line-height: 1.7;
            }


            .security-feature {
                margin-top: 25px;
            }


            .forgot-card {
                padding: 34px 22px 28px;
                border-radius: 28px;
            }


            .lock-icon {
                width: 58px;
                height: 58px;
                border-radius: 19px;
            }


            .card-title {
                font-size: 27px;
            }


            .admin-box {
                padding: 15px;
            }


            .form-input,
            .email-button {
                height: 55px;
            }


            .footer {
                bottom: 17px;
                width: calc(100% - 30px);
            }


            .footer-copy {
                display: none;
            }
        }


        @@media (max-width: 380px) {

            .forgot-card {
                padding: 30px 18px 25px;
            }


            .forgot-intro h1 {
                font-size: 42px;
            }


            .security-text span {
                font-size: 11px;
            }


            .admin-email {
                font-size: 12px;
            }
        }


        /* =========================================================
                   REDUCED MOTION
                   ========================================================= */

        @@media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                animation: none !important;
                transition: none !important;
            }
        }

    </style>

</head>


<body>

    <!-- =========================================================
         TOP DYNAMIC ISLAND
         ========================================================= -->

    <header class="top-island">

        <div class="nav-left">

            <span class="nav-dot"></span>

            Account Recovery

        </div>


        <a href="/"
           class="brand">

            <div class="brand-main">

                Restaurant<span>QR</span>

            </div>

            <span class="brand-sub">

                Smart Dining

            </span>

        </a>


        <div class="nav-right">

            <div class="secure-pill">

                <i class="bi bi-shield-check"></i>

                <span>
                    Secure Access
                </span>

            </div>

        </div>

    </header>


    <!-- =========================================================
         PAGE
         ========================================================= -->

    <main class="page-shell">

        <div class="decor-ring"></div>


        <div class="forgot-wrapper">


            <!-- =================================================
                 LEFT SIDE
                 ================================================= -->

            <section class="forgot-intro">

                <div class="eyebrow">

                    Secure Account Recovery

                </div>


                <h1>

                    Forgot your

                    <em>
                        password?
                    </em>

                </h1>


                <p class="intro-text">

                    Your RestaurantQR account security comes first.
                    Password resets are handled directly by the
                    Super Admin to keep administrator access protected.

                </p>


                <div class="security-feature">

                    <div class="security-icon">

                        <i class="bi bi-shield-lock"></i>

                    </div>


                    <div class="security-text">

                        <strong>
                            Protected Recovery
                        </strong>

                        <span>
                            Your request is sent directly to the
                            RestaurantQR Super Admin.
                        </span>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 RIGHT CARD
                 ================================================= -->

            <section class="forgot-card">


                <div class="card-top">

                    <div class="lock-icon">

                        <i class="bi bi-key"></i>

                    </div>


                    <span class="card-label">

                        Password Assistance

                    </span>


                    <h2 class="card-title">

                        Request a Reset

                    </h2>


                    <p class="card-description">

                        Enter the registered email address associated
                        with your RestaurantQR account.

                    </p>

                </div>


                <!-- =============================================
                     SUPER ADMIN
                     ============================================= -->

                <div class="admin-box">

                    <div class="admin-icon">

                        <i class="bi bi-person-check"></i>

                    </div>


                    <div class="admin-details">

                        <div class="admin-label">

                            RestaurantQR Super Admin

                        </div>


                        <div class="admin-email">

                            talhask407@gmail.com

                        </div>

                    </div>

                </div>


                <!-- =============================================
                     EMAIL
                     ============================================= -->

                <div class="form-group">

                    <label class="form-label"
                           for="userEmail">

                        Registered Email Address

                    </label>


                    <div class="input-wrapper">

                        <i class="bi bi-envelope input-icon"></i>


                        <input type="email"
                               id="userEmail"
                               class="form-input"
                               placeholder="you@restaurant.com"
                               autocomplete="email"
                               required />

                    </div>

                </div>


                <!-- =============================================
                     EMAIL SUPER ADMIN
                     ============================================= -->

                <button type="button"
                        class="email-button"
                        id="emailAdminButton">

                    <span class="button-left">

                        <i class="bi bi-send"></i>

                        Email Super Admin

                    </span>


                    <span class="button-arrow">

                        <i class="bi bi-arrow-right"></i>

                    </span>

                </button>


                <!-- =============================================
                     BACK
                     ============================================= -->

                <div class="back-wrapper">

                    <a href="/Account/Login"
                       class="back-link">

                        <i class="bi bi-arrow-left"></i>

                        Back to Sign In

                    </a>

