@{
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Forgot Password | RestaurantQR</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: "Inter", sans-serif;
            background: #f7f5f0;
            color: #222;
        }

        .page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .card {
            width: 100%;
            max-width: 520px;
            background: #ffffff;
            border-radius: 24px;
            padding: 48px 44px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
            text-align: center;
        }

        .logo {
            width: 64px;
            height: 64px;
            margin: 0 auto 28px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #1f1f1f;
            color: #c9a45c;
            font-family: "Playfair Display", serif;
            font-size: 21px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .icon {
            width: 52px;
            height: 52px;
            margin: 0 auto 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(201, 164, 92, 0.12);
            color: #b28b43;
            font-size: 23px;
        }

        h1 {
            font-family: "Playfair Display", serif;
            font-size: 32px;
            font-weight: 600;
            margin-bottom: 12px;
            color: #202020;
        }

        .subtitle {
            max-width: 420px;
            margin: 0 auto 30px;
            color: #707070;
            font-size: 15px;
            line-height: 1.7;
        }

        .admin-box {
            text-align: left;
            background: #faf9f6;
            border: 1px solid #e8e2d6;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 26px;
        }

        .admin-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            color: #8a8a8a;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .admin-email {
            color: #202020;
            font-size: 15px;
            font-weight: 600;
            word-break: break-word;
        }

        .form-group {
            text-align: left;
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            color: #555;
            text-transform: uppercase;
        }

        .form-input {
            width: 100%;
            height: 52px;
            padding: 0 16px;
            border: 1px solid #ddd8ce;
            border-radius: 12px;
            background: #fff;
            color: #222;
            font-family: inherit;
            font-size: 14px;
            outline: none;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

            .form-input:focus {
                border-color: #c9a45c;
                box-shadow: 0 0 0 3px rgba(201, 164, 92, 0.12);
            }

        .email-button {
            width: 100%;
            height: 52px;
            border: none;
            border-radius: 12px;
            background: #202020;
            color: #fff;
            font-family: inherit;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: transform .2s ease, background .2s ease;
        }

            .email-button:hover {
                background: #333;
                transform: translateY(-1px);
            }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-top: 22px;
            color: #777;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: color .2s ease;
        }

            .back-link:hover {
                color: #b28b43;
            }

        .note {
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #eeeae2;
            color: #999;
            font-size: 12px;
            line-height: 1.6;
        }

        @@media (max-width: 600px) {

            .page {
                padding: 20px 16px;
            }

            .card {
                padding: 36px 24px;
                border-radius: 20px;
            }

            h1 {
                font-size: 28px;
            }
        }

    </style>
</head>

<body>

    <main class="page">

        <section class="card">

            <div class="logo">
                QR
            </div>

            <div class="icon">
                <i class="bi bi-shield-lock"></i>
            </div>

            <h1>
                Forgot Password?
            </h1>

            <p class="subtitle">
                For security reasons, password resets are handled
                by the Super Admin. Please contact the administrator
                to request a password reset.
            </p>

            <div class="admin-box">

                <div class="admin-label">
                    Super Admin
                </div>

                <div class="admin-email">
                    talhask407@gmail.com
                </div>

            </div>

            <div class="form-group">

                <label class="form-label"
                       for="userEmail">
                    Registered Email Address
                </label>

                <input type="email"
                       id="userEmail"
                       class="form-input"
                       placeholder="Enter your registered email"
                       autocomplete="email"
                       required />

            </div>

            <button type="button"
                    class="email-button"
                    id="emailAdminButton">

                <i class="bi bi-envelope"></i>

                <span>
                    Email Super Admin
                </span>

            </button>

            <a href="/Account/Login"
               class="back-link">

                <i class="bi bi-arrow-left"></i>

                Back to Sign In

            </a>

            <div class="note">
                Please use the email address associated with
                your RestaurantQR account when contacting the
                Super Admin.
            </div>

        </section>

    </main>


    <script>

        const emailInput =
            document.getElementById("userEmail");

        const emailButton =
            document.getElementById("emailAdminButton");


        emailButton.addEventListener("click", function () {

            const userEmail =
                emailInput.value.trim();


            if (!userEmail) {

                emailInput.focus();

                return;
            }


            if (!emailInput.checkValidity()) {

                emailInput.reportValidity();

                return;
            }


            const adminEmail =
                "talhask407@gmail.com";


            const subject =
                encodeURIComponent(
                    "RestaurantQR Password Reset Request"
                );


            const body =
                encodeURIComponent(
                    "Hello Super Admin,\n\n" +
                    "I am unable to access my RestaurantQR account " +
                    "and would like to request a password reset.\n\n" +
                    "Registered Email: " +
                    userEmail +
                    "\n\n" +
                    "Please assist me with resetting my password.\n\n" +
                    "Thank you."
                );


            window.location.href =
                "mailto:" +
                adminEmail +
                "?subject=" +
                subject +
                "&body=" +
                body;

        });

    </script>

</body>
</html>