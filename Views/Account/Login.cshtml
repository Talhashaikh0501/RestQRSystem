@model RestaurantQR.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<section class="login-premium">
    <div class="container-fluid">
        <div class="row min-vh-100">

            <!-- LEFT PANEL -->
            <div class="col-lg-5 d-none d-lg-flex login-left">
                <div class="login-left-content">
                    <h1 class="login-brand">
                        Restaurant<span class="italic-accent">QR</span>
                    </h1>

                    <div class="login-divider"></div>

                    <h2 class="login-tagline">
                        Access your<br />
                        <span class="italic-accent">command center</span>.
                    </h2>

                    <p class="login-description">
                        Manage tables, menus, kitchen flow and guest experience —
                        all from one refined control panel.
                    </p>
                </div>
            </div>

            <!-- RIGHT PANEL -->
            <div class="col-lg-7 d-flex align-items-center justify-content-center login-right">

                <div class="login-form-wrapper">

                    <h3 class="login-form-title">
                        Sign In
                    </h3>

                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post"
                          class="login-form">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-4">
                        </div>

                        <!-- Email -->
                        <div class="form-group-premium">
                            <input asp-for="Email"
                                   class="form-input-premium"
                                   placeholder="Email address"
                                   autocomplete="email" />
                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>
                        </div>

                        <!-- Password -->
                        <div class="form-group-premium">
                            <input asp-for="Password"
                                   class="form-input-premium"
                                   placeholder="Password"
                                   autocomplete="current-password" />
                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>
                        </div>

                        <!-- Remember -->
                        <div class="form-check-premium">
                            <input asp-for="RememberMe"
                                   class="form-check-input-premium" />
                            <label asp-for="RememberMe">
                                Remember me
                            </label>
                        </div>

                        <button type="submit"
                                class="btn-gold w-100 mt-4">
                            Enter Dashboard
                        </button>

                    </form>

                </div>

            </div>
        </div>
    </div>
</section>