@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Privacy Policy";
}

<div class="rq-inner-page rq-privacy-page">

    <section class="rq-inner-hero">
        <div class="rq-container">

            <span class="rq-inner-eyebrow">
                RESTAURANTQR
            </span>

            <h1>
                Privacy
                <span>Policy.</span>
            </h1>

            <p>
                Your privacy matters to us. Here's how RestaurantQR
                handles information while providing our restaurant
                management platform.
            </p>

        </div>
    </section>


    <section class="rq-privacy-content">

        <div class="rq-container">

            <div class="rq-privacy-layout">

                <aside class="rq-privacy-nav">

                    <span>ON THIS PAGE</span>

                    <a href="#information">
                        Information We Collect
                    </a>

                    <a href="#usage">
                        How We Use Information
                    </a>

                    <a href="#security">
                        Data Security
                    </a>

                    <a href="#contact">
                        Contact Us
                    </a>

                </aside>


                <article class="rq-privacy-card">

                    <div class="rq-privacy-section"
                         id="information">

                        <span class="rq-privacy-number">
                            01
                        </span>

                        <h2>
                            Information We Collect
                        </h2>

                        <p>
                            RestaurantQR may collect information required
                            to create and operate restaurant accounts,
                            manage menus, process orders and provide
                            platform services.
                        </p>

                    </div>


                    <div class="rq-privacy-section"
                         id="usage">

                        <span class="rq-privacy-number">
                            02
                        </span>

                        <h2>
                            How We Use Information
                        </h2>

                        <p>
                            Information is used to provide, maintain and
                            improve RestaurantQR services, support
                            restaurant operations and communicate important
                            account or service information.
                        </p>

                    </div>


                    <div class="rq-privacy-section"
                         id="security">

                        <span class="rq-privacy-number">
                            03
                        </span>

                        <h2>
                            Data Security
                        </h2>

                        <p>
                            We take reasonable technical and organizational
                            measures to protect information handled through
                            the platform against unauthorized access,
                            alteration or disclosure.
                        </p>

                    </div>


                    <div class="rq-privacy-section"
                         id="contact">

                        <span class="rq-privacy-number">
                            04
                        </span>

                        <h2>
                            Questions About Privacy?
                        </h2>

                        <p>
                            If you have questions about this Privacy Policy
                            or how RestaurantQR handles information, please
                            contact our team.
                        </p>

                        <a class="rq-inner-cta"
                           asp-controller="Home"
                           asp-action="Contact">

                            Contact Us
                            <span>→</span>

                        </a>

                    </div>

                </article>

            </div>

        </div>

    </section>

</div>