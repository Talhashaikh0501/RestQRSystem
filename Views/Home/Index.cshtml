@model IEnumerable<RestaurantQR.Models.SubscriptionPlan>

@{
    ViewData["Title"] = "RestaurantQR — Premium Digital Dining";
}

<section class="hero-premium">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="hero-label">Digital Dining Platform</div>
                <h1 class="hero-title">
                    The <span class="italic-accent">quiet luxury</span><br>
                    of effortless ordering.
                </h1>
                <p class="hero-sub">
                    A refined ordering experience built for restaurants that care about
                    every detail — from the table to the kitchen to the till.
                </p>
                <div class="d-flex gap-3">
                    <a href="#how" class="btn-gold">Explore the Process</a>
                    <a asp-area="" asp-controller="Account" asp-action="Login" class="btn-ghost">Staff Sign In</a>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="hero-visual">
                    <div class="hero-frame">
                        <span class="corner tl"></span>
                        <span class="corner br"></span>
                        <img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?q=80&w=1200&auto=format&fit=crop" alt="Fine dining table setting">
                        <div class="hero-badge">
                            <div class="num">01</div>
                            <p>Every detail, considered</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="marquee-wrap">
    <div class="marquee-track">
        <span>Contactless Ordering</span>
        <span>Live Kitchen Sync</span>
        <span>Table Management</span>
        <span>Real-Time Analytics</span>
        <span>Premium Experience</span>
        <span>Contactless Ordering</span>
        <span>Live Kitchen Sync</span>
        <span>Table Management</span>
        <span>Real-Time Analytics</span>
        <span>Premium Experience</span>
    </div>
</div>

<section id="features" class="section-premium">
    <div class="container">
        <span class="section-label-num">Capabilities</span>
        <h2 class="reveal" style="max-width:600px; font-size:2.4rem; margin-bottom:60px;">
            Everything considered. Nothing compromised.
        </h2>

        <div class="feature-row reveal">
            <div class="feature-num">01</div>
            <div>
                <h3>Instant Table Ordering</h3>
                <p>Guests scan, browse, and order in seconds — no app downloads, no waiting for a server.</p>
            </div>
        </div>

        <div class="feature-row reveal">
            <div class="feature-num">02</div>
            <div>
                <h3>Live Kitchen Display</h3>
                <p>Orders appear the moment they're placed, with real-time status tracking from fire to plate.</p>
            </div>
        </div>

        <div class="feature-row reveal">
            <div class="feature-num">03</div>
            <div>
                <h3>Command Center for Owners</h3>
                <p>Full oversight of menu, staff, tables and order history — all in one refined dashboard.</p>
            </div>
        </div>
    </div>
</section>

<section id="how" class="section-premium">
    <div class="container">
        <span class="section-label-num">Process</span>
        <h2 class="reveal" style="max-width:600px; font-size:2.4rem; margin-bottom:60px;">
            From table to kitchen, in three moves.
        </h2>

        <div class="row g-5">
            <div class="col-md-4 reveal">
                <div class="section-label-num" style="font-size:2rem;">01</div>
                <h3 style="font-size:1.3rem;">Place the Code</h3>
                <p style="color:var(--text-dim);">A single QR code, elegantly placed on every table.</p>
            </div>
            <div class="col-md-4 reveal">
                <div class="section-label-num" style="font-size:2rem;">02</div>
                <h3 style="font-size:1.3rem;">Guest Orders</h3>
                <p style="color:var(--text-dim);">A refined digital menu, browsed and ordered in moments.</p>
            </div>
            <div class="col-md-4 reveal">
                <div class="section-label-num" style="font-size:2rem;">03</div>
                <h3 style="font-size:1.3rem;">Kitchen Responds</h3>
                <p style="color:var(--text-dim);">The order arrives live — no delay, no paper, no error.</p>
            </div>
        </div>
    </div>
</section>

<section id="pricing" class="section-premium">
    <div class="container">

        <span class="section-label-num">Subscriptions</span>

        <h2 class="reveal"
            style="max-width:650px; font-size:2.4rem; margin-bottom:20px;">
            Choose the plan that fits your restaurant.
        </h2>

        <p style="color:var(--text-dim); max-width:600px; margin-bottom:60px;">
            Start with a plan designed to give your restaurant
            a refined digital ordering experience.
        </p>

        <div class="row g-4">

            @if (Model != null && Model.Any())
            {
                foreach (var plan in Model)
                {
                    <div class="col-md-6 col-lg-4 reveal">

                        <div style="
                                    height:100%;
                                    padding:35px;
                                    border:1px solid rgba(255,255,255,0.08);
                                    background:#1E1A17;
                                    position:relative;
                                ">

                            @if (plan.IsCustom)
                            {
                                <div class="section-label-num"
                                     style="margin-bottom:15px;">
                                    CUSTOM
                                </div>
                            }

                            <h3 style="
                                        font-family:'Fraunces',serif;
                                        font-size:1.6rem;
                                        margin-bottom:20px;
                                    ">
                                @plan.Name
                            </h3>

                            <div style="
                                        font-family:'Fraunces',serif;
                                        font-size:2.5rem;
                                        margin-bottom:8px;
                                    ">
                                ₹@plan.Price.ToString("N0")
                            </div>

                            <p style="
                                        color:var(--text-dim);
                                        margin-bottom:30px;
                                    ">
                                @plan.DurationDays days access
                            </p>

                            <a asp-controller="Subscription"
                               asp-action="Buy"
                               asp-route-planId="@plan.Id"
                               class="btn-gold">
                                Buy Now
                            </a>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p style="color:var(--text-dim);">
                        Subscription plans are currently unavailable.
                    </p>
                </div>
            }

        </div>

    </div>
</section>

<section class="cta-premium">
    <div class="container">
        <span class="section-label-num">Begin</span>
        <h2 class="reveal" style="font-size:2.6rem; max-width:600px; margin:0 auto 30px;">
            Bring your restaurant into the present.
        </h2>
        <a href="https://mail.google.com/mail/?view=cm&fs=1&to=Talhashaikh89407@gmail.com&su=Restaurant%20Registration%20Request&body=Hello%2C%0A%0AI%20would%20like%20to%20register%20my%20restaurant%20on%20RestaurantQR.%0A%0ARestaurant%20Name%3A%20%0AOwner%20Name%3A%20%0AContact%20Number%3A%20%0A%0AThank%20you."
           target="_blank"
           class="btn-gold">
            Register Your Restaurant
        </a>
    </div>
</section>