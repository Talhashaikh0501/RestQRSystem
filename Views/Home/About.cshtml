@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "About Us";
}

<div class="rq-inner-page rq-about-page">

    <section class="rq-inner-hero">
        <div class="rq-container">

            <span class="rq-inner-eyebrow">
                ABOUT RESTAURANTQR
            </span>

            <h1>
                Simpler tools for
                <span>better dining.</span>
            </h1>

            <p>
                RestaurantQR helps restaurants simplify ordering,
                digital menus and everyday operations through one
                modern platform.
            </p>

        </div>
    </section>


    <section class="rq-about-content">
        <div class="rq-container">

            <div class="rq-about-grid">

                <div class="rq-about-copy rq-reveal">

                    <span class="rq-inner-label">
                        OUR APPROACH
                    </span>

                    <h2>
                        Built around the
                        <span>restaurant.</span>
                    </h2>

                    <p>
                        Restaurants should spend less time managing
                        complicated systems and more time creating
                        great experiences for their customers.
                    </p>

                    <p>
                        RestaurantQR brings digital menus, QR ordering,
                        table-based ordering and restaurant management
                        into a simple and connected experience.
                    </p>

                </div>


                <div class="rq-about-cards">

                    <div class="rq-about-card rq-reveal">
                        <span>01</span>
                        <h3>Simple</h3>
                        <p>
                            Easy-to-use tools designed for everyday
                            restaurant operations.
                        </p>
                    </div>

                    <div class="rq-about-card rq-reveal">
                        <span>02</span>
                        <h3>Connected</h3>
                        <p>
                            Keep menus, tables, orders and payments
                            connected in one platform.
                        </p>
                    </div>

                    <div class="rq-about-card rq-reveal">
                        <span>03</span>
                        <h3>Scalable</h3>
                        <p>
                            A platform designed to grow alongside
                            modern restaurants.
                        </p>
                    </div>

                    <div class="rq-about-card rq-reveal">
                        <span>04</span>
                        <h3>Customer First</h3>
                        <p>
                            Create a faster and smoother ordering
                            experience for every guest.
                        </p>
                    </div>

                </div>

            </div>

        </div>
    </section>


    <section class="rq-about-cta">
        <div class="rq-container">

            <div class="rq-about-cta-box rq-reveal">

                <span class="rq-inner-label">
                    READY TO GET STARTED?
                </span>

                <h2>
                    Make your restaurant
                    <span>simpler.</span>
                </h2>

                <p>
                    Explore RestaurantQR and discover a better way
                    to manage your restaurant.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="pricing"
                   class="rq-inner-cta">
                    Explore Plans
                    <span>→</span>
                </a>

            </div>

        </div>
    </section>

</div>