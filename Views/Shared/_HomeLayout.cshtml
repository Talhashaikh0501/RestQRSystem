<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f0e5" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/home-premium.css" asp-append-version="true" />
</head>
<body class="rq-public-body">
    <div class="rq-noise" aria-hidden="true"></div>

    <header class="rq-public-header" id="publicHeader">
        <div class="rq-nav-shell">
            <a class="rq-public-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Restaurant QR home">
                <span class="rq-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                        <path d="M15 14h2v2h-2zM19 14h2v5h-2zM14 19h3v2h-3zM18 20h3v1h-3z"></path>
                    </svg>
                </span>
                <span>Restaurant<span class="rq-brand-gold">QR</span></span>
            </a>

            <nav class="rq-desktop-nav" aria-label="Primary navigation">

                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="experience">
                    Experience
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="process">
                    How it works
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="pricing">
                    Plans
                </a>

            </nav>

            <div class="rq-nav-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="rq-logout-form">
                        <button type="submit" class="rq-nav-login">Logout</button>
                    </form>
                }
                else
                {
                    <a class="rq-nav-login" asp-area="" asp-controller="Account" asp-action="Login">Staff sign in</a>
                    <a class="rq-nav-primary"
                       asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="pricing">
                        Get started
                    </a>
                }
            </div>

            <button class="rq-menu-toggle" id="rqMenuToggle" type="button" aria-label="Open navigation" aria-controls="rqMobileMenu" aria-expanded="false">
                <span></span>
                <span></span>
            </button>
        </div>

        <div class="rq-mobile-menu" id="rqMobileMenu" aria-hidden="true">

            <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="experience">
                Experience
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="process">
                How it works
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="pricing">
                Plans
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit">Logout</button>
                </form>
            }
            else
            {
                <a asp-area="" asp-controller="Account" asp-action="Login">Staff sign in</a>
                <a class="rq-mobile-cta"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="pricing">
                    Get started
                </a>
            }
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="rq-footer">

        <div class="rq-container">

            <div class="rq-footer-main">

                <!-- Brand -->
                <div class="rq-footer-brand-column rq-footer-reveal">

                    <a class="rq-public-brand rq-footer-brand"
                       asp-controller="Home"
                       asp-action="Index">

                        <span class="rq-brand-mark" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none">
                                <rect x="3"
                                      y="3"
                                      width="7"
                                      height="7"
                                      rx="1.5"></rect>

                                <rect x="14"
                                      y="3"
                                      width="7"
                                      height="7"
                                      rx="1.5"></rect>

                                <rect x="3"
                                      y="14"
                                      width="7"
                                      height="7"
                                      rx="1.5"></rect>

                                <path d="M15 14h2v2h-2z
                                     M19 14h2v5h-2z
                                     M14 19h3v2h-3z
                                     M18 20h3v1h-3z">
                                </path>
                            </svg>
                        </span>

                        <span>
                            Restaurant<span class="rq-brand-gold">QR</span>
                        </span>

                    </a>


                    <p class="rq-footer-description">
                        A quieter, faster way to run modern dining.
                        Simplify orders, menus and restaurant operations
                        with one powerful platform.
                    </p>


                    <a class="rq-footer-primary-link"
                       asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="pricing">

                        Explore plans

                        <span>→</span>

                    </a>

                </div>


                <!-- Product -->
                <div class="rq-footer-column rq-footer-reveal">

                    <h3>Product</h3>

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="experience">
                        Experience
                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="process">
                        How It Works
                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="pricing">
                        Pricing
                    </a>

                </div>


                <!-- Platform -->
                <div class="rq-footer-column rq-footer-reveal">

                    <h3>Platform</h3>

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="experience">
                        QR Ordering
                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="experience">
                        Digital Menu
                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="process">
                        Live Orders
                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="experience">
                        Restaurant Management
                    </a>

                </div>


                <!-- Company -->
                <div class="rq-footer-column rq-footer-reveal">

                    <h3>Company</h3>

                    <a asp-controller="Home"
                       asp-action="About">
                        About Us
                    </a>

                    <a asp-controller="Home"
                       asp-action="Contact">
                        Contact Us
                    </a>

                    <a asp-controller="Home"
                       asp-action="Privacy">
                        Privacy Policy
                    </a>

                </div>


                <!-- Account -->
                <div class="rq-footer-column rq-footer-reveal">

                    <h3>Account</h3>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="rq-footer-logout-form">

                            <button type="submit">
                                Logout
                            </button>

                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login">
                            Staff Sign In
                        </a>

                        <a asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="pricing">
                            Get Started
                        </a>
                    }

                </div>

            </div>


            <!-- Footer Bottom -->
            <div class="rq-footer-bottom rq-footer-reveal">

                <div class="rq-footer-copyright">
                    © @DateTime.Now.Year RestaurantQR.
                    All rights reserved.
                </div>


                <div class="rq-footer-bottom-links">

                    <a asp-controller="Home"
                       asp-action="About">
                        About
                    </a>

                    <a asp-controller="Home"
                       asp-action="Contact">
                        Contact
                    </a>

                    <a asp-controller="Home"
                       asp-action="Privacy">
                        Privacy
                    </a>

                </div>


                <div class="rq-footer-tagline">
                    Built for modern restaurants.
                </div>

            </div>

        </div>

    </footer>

    <script>
        (() => {
            const header = document.getElementById('publicHeader');
            const toggle = document.getElementById('rqMenuToggle');
            const menu = document.getElementById('rqMobileMenu');
            const root = document.documentElement;
            const body = document.body;
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

            /* -----------------------------
               Navbar + mobile navigation
               ----------------------------- */
            const updateHeader = () => {
                header?.classList.toggle('is-scrolled', window.scrollY > 18);
            };

            const closeMenu = () => {
                if (!toggle || !menu) return;
                toggle.classList.remove('is-open');
                menu.classList.remove('is-open');
                toggle.setAttribute('aria-expanded', 'false');
                menu.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('rq-menu-open');
            };

            toggle?.addEventListener('click', () => {
                const open = !menu.classList.contains('is-open');
                toggle.classList.toggle('is-open', open);
                menu.classList.toggle('is-open', open);
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                menu.setAttribute('aria-hidden', open ? 'false' : 'true');
                document.body.classList.toggle('rq-menu-open', open);
            });

            menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));

            /* -----------------------------
               Scroll progress + reveal
               ----------------------------- */
            let ticking = false;

            const updateScrollEffects = () => {
                const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
                const progress = Math.min(1, Math.max(0, window.scrollY / max));
                root.style.setProperty('--rq-scroll-progress', progress.toFixed(4));
                updateHeader();
                ticking = false;
            };

            window.addEventListener('scroll', () => {
                if (!ticking) {
                    requestAnimationFrame(updateScrollEffects);
                    ticking = true;
                }
            }, { passive: true });

            const revealItems = document.querySelectorAll('[data-reveal]');
            if ('IntersectionObserver' in window && !reduceMotion) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.12, rootMargin: '0px 0px -4% 0px' });
                revealItems.forEach(item => observer.observe(item));
            } else {
                revealItems.forEach(item => item.classList.add('is-visible'));
            }

            /* -----------------------------
               Cursor ambient light
               ----------------------------- */
            if (finePointer && !reduceMotion) {
                window.addEventListener('pointermove', (event) => {
                    root.style.setProperty('--rq-mx', `${event.clientX}px`);
                    root.style.setProperty('--rq-my', `${event.clientY}px`);
                }, { passive: true });
            }

            /* -----------------------------
               Hero mouse parallax
               ----------------------------- */
            const hero = document.querySelector('.rq-hero');
            const product = document.querySelector('.rq-hero-product');

            if (hero && product && finePointer && !reduceMotion) {
                hero.addEventListener('pointermove', (event) => {
                    const rect = hero.getBoundingClientRect();
                    const nx = ((event.clientX - rect.left) / rect.width) - .5;
                    const ny = ((event.clientY - rect.top) / rect.height) - .5;
                    const px = nx * 13;
                    const py = ny * 11;
                    product.style.setProperty('--rq-px', `${px.toFixed(2)}px`);
                    product.style.setProperty('--rq-py', `${py.toFixed(2)}px`);
                    product.style.setProperty('--rq-orbit-x', `${(px * .16).toFixed(2)}px`);
                    product.style.setProperty('--rq-orbit-y', `${(py * .16).toFixed(2)}px`);
                    product.style.setProperty('--rq-chip-top-x', `${(px * -.55).toFixed(2)}px`);
                    product.style.setProperty('--rq-chip-top-y', `${(py * -.55).toFixed(2)}px`);
                    product.style.setProperty('--rq-chip-bottom-x', `${(px * .55).toFixed(2)}px`);
                    product.style.setProperty('--rq-chip-bottom-y', `${(py * .55).toFixed(2)}px`);
                }, { passive: true });

                hero.addEventListener('pointerleave', () => {
                    product.style.setProperty('--rq-px', '0px');
                    product.style.setProperty('--rq-py', '0px');
                    product.style.setProperty('--rq-orbit-x', '0px');
                    product.style.setProperty('--rq-orbit-y', '0px');
                    product.style.setProperty('--rq-chip-top-x', '0px');
                    product.style.setProperty('--rq-chip-top-y', '0px');
                    product.style.setProperty('--rq-chip-bottom-x', '0px');
                    product.style.setProperty('--rq-chip-bottom-y', '0px');
                });
            }

            /* -----------------------------
               3D card tilt + pointer glow
               ----------------------------- */
            const tiltCards = document.querySelectorAll('.rq-experience-card, .rq-plan-card');
            tiltCards.forEach(card => card.classList.add('rq-tilt'));

            if (finePointer && !reduceMotion) {
                tiltCards.forEach(card => {
                    card.addEventListener('pointermove', (event) => {
                        const rect = card.getBoundingClientRect();
                        const x = event.clientX - rect.left;
                        const y = event.clientY - rect.top;
                        const px = x / rect.width;
                        const py = y / rect.height;
                        const ry = (px - .5) * 7;
                        const rx = (.5 - py) * 7;

                        card.style.setProperty('--rq-rx', `${rx.toFixed(2)}deg`);
                        card.style.setProperty('--rq-ry', `${ry.toFixed(2)}deg`);
                        card.style.setProperty('--rq-glow-x', `${(px * 100).toFixed(1)}%`);
                        card.style.setProperty('--rq-glow-y', `${(py * 100).toFixed(1)}%`);
                    }, { passive: true });

                    card.addEventListener('pointerleave', () => {
                        card.style.setProperty('--rq-rx', '0deg');
                        card.style.setProperty('--rq-ry', '0deg');
                        card.style.setProperty('--rq-glow-x', '50%');
                        card.style.setProperty('--rq-glow-y', '50%');
                    });
                });
            }

            /* -----------------------------
               Magnetic CTA controls
               ----------------------------- */
            const magneticItems = document.querySelectorAll('.rq-btn, .rq-nav-primary, .rq-plan-button');
            if (finePointer && !reduceMotion) {
                magneticItems.forEach(item => {
                    item.addEventListener('pointermove', (event) => {
                        const rect = item.getBoundingClientRect();
                        const x = event.clientX - rect.left - rect.width / 2;
                        const y = event.clientY - rect.top - rect.height / 2;
                        item.style.setProperty('--rq-mag-x', `${(x * .10).toFixed(2)}px`);
                        item.style.setProperty('--rq-mag-y', `${(y * .14).toFixed(2)}px`);
                    }, { passive: true });

                    item.addEventListener('pointerleave', () => {
                        item.style.setProperty('--rq-mag-x', '0px');
                        item.style.setProperty('--rq-mag-y', '0px');
                    });
                });
            }

            /* -----------------------------
               Tiny number count-up effects
               ----------------------------- */
            const countTargets = [...document.querySelectorAll('.rq-owner-stat b')];
            const animateNumber = (element) => {
                const raw = element.textContent.trim();
                const target = Number(raw.replace(/[^0-9.]/g, ''));
                if (!Number.isFinite(target) || target <= 0) return;

                const duration = 1200;
                const start = performance.now();
                const decimals = raw.includes('.') ? 1 : 0;

                const frame = (now) => {
                    const t = Math.min(1, (now - start) / duration);
                    const eased = 1 - Math.pow(1 - t, 3);
                    element.textContent = (target * eased).toFixed(decimals);
                    if (t < 1) requestAnimationFrame(frame);
                    else element.textContent = raw;
                };
                requestAnimationFrame(frame);
            };

            if ('IntersectionObserver' in window && !reduceMotion) {
                const numberObserver = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            animateNumber(entry.target);
                            numberObserver.unobserve(entry.target);
                        }
                    });
                }, { threshold: .7 });
                countTargets.forEach(el => numberObserver.observe(el));
            }

            /* -----------------------------
               Smooth anchor scrolling offset
               ----------------------------- */
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', (event) => {
                    const id = anchor.getAttribute('href');
                    if (!id || id === '#') return;
                    const target = document.querySelector(id);
                    if (!target) return;

                    event.preventDefault();
                    const top = target.getBoundingClientRect().top + window.scrollY - 82;
                    window.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
                });
            });

            window.addEventListener('resize', () => {
                if (window.innerWidth > 900) closeMenu();
            });

            updateScrollEffects();
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
