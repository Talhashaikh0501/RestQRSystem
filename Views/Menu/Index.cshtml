                                Ordering for
                            </span>

                            <strong>
                                @Model.CustomerName
                            </strong>

                        </span>

                .serving-option label:hover {
                    border-color: #b48b45;
                    box-shadow: 0 4px 12px rgba(180, 139, 69, 0.10);
                }
                    </div>


            .serving-option label:active {
                transform: scale(0.97);
            }

        .serving-option-price {
            font-weight: 800;
        }
                    <a asp-controller="Menu"
                       asp-action="CustomerDetails"
                       asp-route-id="@Model.QRToken"
                       asp-route-change="true"
                       class="rq-menu-change">


        /* =========================================================
                   MENU FOOTER
                ========================================================= */

        .menu-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            width: 100%;
        }
                        Change

        .menu-price {
            color: #b48b45;
            font-size: 1rem;
            font-weight: 800;
        }
                    </a>

        .menu-add-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 96px;
            min-height: 42px;
            padding: 10px 18px;
            border: none;
            border-radius: 12px;
            background: #b48b45;
            color: #ffffff;
            font-size: 0.82rem;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 7px 17px rgba(180, 139, 69, 0.18);
            transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
        }
                </div>

            .menu-add-button:hover {
                background: #9d7638;
                box-shadow: 0 9px 20px rgba(157, 118, 56, 0.23);
            }
            </div>

            .menu-add-button:active {
                transform: scale(0.96);
            }

            .menu-add-button:disabled {
                opacity: 0.5;
                cursor: not-allowed;
                box-shadow: none;
            }
        </div>


        /* =========================================================
                   STICKY CART BAR
                ========================================================= */

        .sticky-cart-bar {
            position: fixed;
            left: 16px;
            right: 16px;
            bottom: max( 14px, env(safe-area-inset-bottom) );
            z-index: 2000;
            max-width: 868px;
            margin-left: auto;
            margin-right: auto;
            padding: 13px 15px;
            border: 1px solid rgba(255, 255, 255, 0.09);
            border-radius: 18px;
            background: rgba(40, 27, 22, 0.97);
            color: #ffffff;
            text-decoration: none;
            box-shadow: 0 15px 40px rgba(40, 27, 22, 0.25);
            transform: translateY(calc(100% + 40px));
            transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
            -webkit-backdrop-filter: blur(14px);
            backdrop-filter: blur(14px);
        }
    </section>



