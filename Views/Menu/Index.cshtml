            margin: 0 0 8px;
            color: #281b16;
            font-family: "DM Serif Display", serif;
            font-size: 1.4rem;
            font-weight: 400;
            line-height: 1.2;
            overflow-wrap: anywhere;
        }
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 aria-hidden="true">

        .menu-description {
            margin: 0 0 18px;
            color: #796f61;
            font-size: 0.88rem;
            font-weight: 400;
            line-height: 1.65;
            overflow-wrap: anywhere;
        }
                                <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"
                                      stroke="currentColor"
                                      stroke-width="1.7" />


        /* =========================================================
                   SERVING OPTIONS
                ========================================================= */
                                <path d="M4.5 20c.8-3.5 3.3-5.3 7.5-5.3s6.7 1.8 7.5 5.3"
                                      stroke="currentColor"
                                      stroke-width="1.7"
                                      stroke-linecap="round" />

        .serving-title {
            margin-bottom: 10px;
            color: #7a6f5c;
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }
                            </svg>

        .serving-options {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 18px;
        }
                        </span>


            .serving-option input {
                position: absolute;
                width: 1px;
                height: 1px;
                opacity: 0;
                pointer-events: none;
            }
                        <span class="rq-menu-customer-copy">

            .serving-option label {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                min-height: 42px;
                padding: 9px 13px;
                border: 1px solid #d8cbb3;
                border-radius: 12px;
                background: #ffffff;
                color: #6d614f;
                font-size: 0.8rem;
                font-weight: 700;
                line-height: 1.2;
                cursor: pointer;
                user-select: none;
                transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
            }
