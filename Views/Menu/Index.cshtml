@model RestaurantQR.ViewModels.QRMenuViewModel

@{
    ViewData["Title"] = Model.RestaurantName;
    Layout = "/Views/Shared/_CustomerLayout.cshtml";
}


<div class="rq-menu-page">


        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        h1,
        h2,
        h3 {
            font-family: "DM Serif Display", serif;
            letter-spacing: -0.02em;
        }
    <!-- =====================================================
         RESTAURANT HERO
    ====================================================== -->


        /* =========================================================
                   CUSTOM CONTAINER

                   Do NOT override Bootstrap .container globally.
                   This container gives proper space on mobile.
                ========================================================= */

        .menu-page-container {
            width: calc(100% - 32px);
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
        }
    <section class="rq-menu-hero">


        /* =========================================================
                   HERO SECTION
                ========================================================= */

        .menu-hero {
            position: relative;
            padding: 70px 0 48px;
            text-align: center;
            overflow: hidden;
        }
        <div class="rq-menu-shell">

            .menu-hero::before {
                content: "";
                position: absolute;
                width: 280px;
                height: 280px;
                left: 50%;
                top: 10px;
                transform: translateX(-50%);
                border-radius: 50%;
                background: radial-gradient( circle, rgba(180, 139, 69, 0.08) 0%, rgba(180, 139, 69, 0) 70% );
                pointer-events: none;
            }

        .menu-hero-content {
            position: relative;
            z-index: 1;
        }

        .menu-hero h1 {
            margin: 0;
            color: #281b16;
            font-size: clamp(2.5rem, 7vw, 4rem);
            font-weight: 400;
            line-height: 1.05;
            text-wrap: balance;
        }
            <div class="rq-menu-hero-card">

        .menu-hero p {
            margin: 18px 0 0;
            color: #7a6f5c;
            font-size: 1rem;
            font-weight: 500;
            letter-spacing: 0.01em;
        }
                <div class="rq-menu-eyebrow">


        /* =========================================================
                   CATEGORY STICKY NAVIGATION
                ========================================================= */

        .category-dock {
            position: sticky;
            /*
                        Keeps categories below the customer navbar.
                        If your navbar height changes later,
                        only change this value.
                    */
            top: 72px;
            z-index: 1000;
            padding: 12px 0 8px;
            background: rgba(249, 245, 236, 0.95);
            border-top: 1px solid rgba(40, 27, 22, 0.04);
            border-bottom: 1px solid rgba(40, 27, 22, 0.07);
            -webkit-backdrop-filter: blur(15px);
            backdrop-filter: blur(15px);
        }
                    <span class="rq-menu-eyebrow-dot"></span>

        .category-list {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            overflow-x: auto;
            overflow-y: hidden;
            padding: 2px 0 7px;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
            scroll-snap-type: x proximity;
        }
                    TABLE @Model.TableNumber

            .category-list::-webkit-scrollbar {
                display: none;
            }

        .category-pill {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            padding: 10px 19px;
            border: 1px solid #d8cbb3;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.92);
            color: #6d614f;
            font-size: 0.88rem;
            font-weight: 700;
            line-height: 1;
            text-decoration: none;
            white-space: nowrap;
            scroll-snap-align: start;
            box-shadow: 0 3px 10px rgba(69, 49, 34, 0.025);
            transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        }
                </div>


            .category-pill.active {
                color: #ffffff;
                background: #b48b45;
                border-color: #b48b45;
                box-shadow: 0 8px 18px rgba(180, 139, 69, 0.22);
            }

            .category-pill:active {
                transform: scale(0.96);
            }


        /* =========================================================
                   MENU CONTENT
                ========================================================= */

        .menu-content {
            padding-top: 38px;
            padding-bottom: 135px;
        }
                <h1 class="rq-menu-title">
                    @Model.RestaurantName
                </h1>


            .category-section:last-child {
                margin-bottom: 0;
            }

        .category-title {
            position: relative;
            margin: 0 0 22px;
            color: #281b16;
            font-size: clamp(2rem, 6vw, 2.7rem);
            font-weight: 400;
            line-height: 1.1;
            overflow-wrap: anywhere;
        }
                <p class="rq-menu-subtitle">
                    Scan. Order. Relax.
                </p>


            .menu-card:last-child {
                margin-bottom: 0;
            }

            .menu-card:hover {
                transform: translateY(-3px);
                border-color: rgba(180, 139, 69, 0.17);
                box-shadow: 0 16px 36px rgba(52, 36, 27, 0.10), 0 4px 10px rgba(52, 36, 27, 0.04);
            }
                <div class="rq-menu-customer-row">


        /* =========================================================
                   FOOD IMAGE
                ========================================================= */

        .menu-image-wrap {
            position: relative;
            width: 100%;
            overflow: hidden;
            background: #eee5d5;
        }

        .menu-image {
            display: block;
            width: 100%;
            height: 250px;
            object-fit: cover;
            object-position: center;
            transition: transform 0.5s ease;
        }
                    <div class="rq-menu-customer">

        .menu-card:hover .menu-image {
            transform: scale(1.025);
        }


        /* =========================================================
                   MENU CARD BODY
                ========================================================= */

        .menu-body {
            padding: 20px;
        }
                        <span class="rq-menu-customer-icon">

