@model RestaurantQR.ViewModels.QRMenuViewModel

@{
    ViewData["Title"] = Model.RestaurantName;
    Layout = "/Views/Shared/_CustomerLayout.cshtml";
}


<div class="rq-menu-page">


    <!-- =====================================================
         RESTAURANT HERO
    ====================================================== -->

    <section class="rq-menu-hero">

        <div class="rq-menu-shell">

            <div class="rq-menu-hero-card">

                <div class="rq-menu-eyebrow">

                    <span class="rq-menu-eyebrow-dot"></span>

                    TABLE @Model.TableNumber

                </div>


                <h1 class="rq-menu-title">
                    @Model.RestaurantName
                </h1>


                <p class="rq-menu-subtitle">
                    Scan. Order. Relax.
                </p>


                <div class="rq-menu-customer-row">

                    <div class="rq-menu-customer">

                        <span class="rq-menu-customer-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 aria-hidden="true">

                                <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"
                                      stroke="currentColor"
                                      stroke-width="1.7" />

                                <path d="M4.5 20c.8-3.5 3.3-5.3 7.5-5.3s6.7 1.8 7.5 5.3"
                                      stroke="currentColor"
                                      stroke-width="1.7"
                                      stroke-linecap="round" />

                            </svg>

                        </span>


                        <span class="rq-menu-customer-copy">

                            <span class="rq-menu-customer-label">
                                Ordering for
                            </span>

                            <strong>
                                @Model.CustomerName
                            </strong>

                        </span>

                    </div>


                    <a asp-controller="Menu"
                       asp-action="CustomerDetails"
                       asp-route-id="@Model.QRToken"
                       asp-route-change="true"
                       class="rq-menu-change">

                        Change

                    </a>

                </div>

            </div>

        </div>

    </section>



    <!-- =====================================================
         CATEGORY NAVIGATION
    ====================================================== -->
    @if (Model.Categories.Count > 0)
    {
        <div class="rq-category-dock"
             id="categoryDock">

            <div class="rq-menu-shell">

                <div class="rq-category-list"
                     id="categoryList">

                    @for (int i = 0;
                                    i < Model.Categories.Count;
                                    i++)
                    {
                        <a href="#category-@i"
                           class="rq-category-pill @(i == 0 ? "active" : "")"
                           data-category-index="@i">

                            @Model.Categories[i].Name

                        </a>
                    }

                </div>

            </div>

        </div>
    }



    <!-- =====================================================
         MENU CONTENT
    ====================================================== -->

    <div class="rq-menu-shell rq-menu-content">


        @if (Model.Categories.Count > 0)
        {
            @for (int categoryIndex = 0;
                    categoryIndex < Model.Categories.Count;
                    categoryIndex++)
            {
                var category =
                Model.Categories[categoryIndex];


                <section id="category-@categoryIndex"
                         class="rq-category-section"
                         data-category-section="@categoryIndex">


                    <!-- =========================================
                         CATEGORY HEADING
                    ========================================== -->

                    <div class="rq-category-heading">

                        <div>

                            <div class="rq-category-kicker">
                                OUR MENU
                            </div>


                            <h2 class="rq-category-title">
                                @category.Name
                            </h2>

                        </div>


                        <span class="rq-category-count">

                            @category.MenuItems.Count

                            @(category.MenuItems.Count == 1
                                                ? "item"
                                                : "items")

                </span>

                    </div>



                    <!-- =========================================
                         MENU ITEMS
                    ========================================== -->

                    <div class="rq-menu-grid">

                @foreach (var item in category.MenuItems)
                        {
                            <article class="rq-menu-card">


                                <!-- =================================
                                     IMAGE
                                ================================== -->
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <div class="rq-menu-image-wrap">

                                        <img src="@item.ImageUrl"
                                             class="rq-menu-image"
                                             alt="@item.Name"
                                             loading="lazy" />


                                        <div class="rq-menu-image-shade"></div>

                                    </div>
                                }
                                else
                                {
                                    <div class="rq-menu-image-placeholder">

                                        <div class="rq-menu-placeholder-mark">
                                            R
                                        </div>

                                        <span>
                                            RestaurantQR
                                        </span>

                                    </div>
                                }



                                <!-- =================================
                                     CARD BODY
                                ================================== -->

                                <div class="rq-menu-card-body">


                                    <div class="rq-menu-item-top">

                                        <h3 class="rq-menu-item-name">
                                            @item.Name
                                        </h3>

                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <p class="rq-menu-description">
                                            @item.Description
                                        </p>
                                    }



                                    <!-- =================================
                                         ITEM WITH SERVING OPTIONS
                                    ================================== -->
                                    @if (item.Options.Count > 0)
                                    {
                                        <form asp-controller="Cart"
                                              asp-action="Add"
                                              method="post"
                                              class="add-to-cart-form"
                                              data-item-name="@item.Name">

                                            @Html.AntiForgeryToken()


                                            <input type="hidden"
                                                   name="menuItemId"
                                                   value="@item.Id" />


                                            <input type="hidden"
                                                   name="qrToken"
                                                   value="@Model.QRToken" />


                                            <div class="rq-serving-header">

                                                <span>
                                                    Choose serving
                                                </span>


                                                <span class="rq-serving-required">
                                                    Required
                                                </span>

                                            </div>


                                            <div class="rq-serving-options">

                                                @foreach (var option in item.Options)
                                                {
                                                    var optionInputId =
                                                    $"option-{item.Id}-{option.Id}";


                                                    <div class="rq-serving-option">

                                                        <input type="radio"
                                                               id="@optionInputId"
                                                               name="optionId"
                                                               value="@option.Id"
                                                               required />


                                                        <label for="@optionInputId">

                                                            <span class="rq-serving-option-name">
                                                                @option.Name
                                                            </span>


                                                            <span class="rq-serving-option-price">
                                                                ₹@option.Price.ToString("N0")
                                                            </span>

                                                        </label>

                                                    </div>
                                                }

                                            </div>


                                            <div class="rq-menu-action-row">

                                                <div class="rq-menu-price-wrap">

                                                    <span class="rq-menu-price-label">
                                                        Price
                                                    </span>


                                                    <span class="rq-menu-price"
                                                          data-selected-price>

                                                        Select serving

                                                    </span>

                                                </div>


                                                <button type="submit"
                                                        class="rq-menu-add-button">

                                                    <span class="menu-add-label">
                                                        Add
                                                    </span>


                                                    <span class="menu-add-icon">
                                                        +
                                                    </span>

                                                </button>

                                            </div>

                                        </form>
                                    }
                                    else
                                    {

                                        <!-- =================================
                                             ITEM WITHOUT OPTIONS
                                        ================================== -->

                                        <form asp-controller="Cart"
                                              asp-action="Add"
                                              method="post"
                                              class="add-to-cart-form"
                                              data-item-name="@item.Name">

                                            @Html.AntiForgeryToken()


                                            <input type="hidden"
                                                   name="menuItemId"
                                                   value="@item.Id" />


                                            <input type="hidden"
                                                   name="optionId"
                                                   value="0" />


                                            <input type="hidden"
                                                   name="qrToken"
                                                   value="@Model.QRToken" />


                                            <div class="rq-menu-action-row">

                                                <div class="rq-menu-price-wrap">

                                                    <span class="rq-menu-price-label">
                                                        Price
                                                    </span>


                                                    <span class="rq-menu-price">
                                                        ₹@item.Price.ToString("N0")
                                                    </span>

                                                </div>


                                                <button type="submit"
                                                        class="rq-menu-add-button">

                                                    <span class="menu-add-label">
                                                        Add
                                                    </span>


                                                    <span class="menu-add-icon">
                                                        +
                                                    </span>

                                                </button>

                                            </div>

                                        </form>
                                    }

                                </div>

                            </article>
                        }

                    </div>

                </section>
            }
        }
        else
        {

            <!-- =================================================
                 EMPTY MENU
            ================================================== -->

            <div class="rq-menu-empty">

                <div class="rq-menu-empty-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         aria-hidden="true">

                        <path d="M5 4h14v16H5V4Z"
                              stroke="currentColor"
                              stroke-width="1.6"
                              stroke-linejoin="round" />

                        <path d="M8 8h8M8 12h6"
                              stroke="currentColor"
                              stroke-width="1.6"
                              stroke-linecap="round" />

                    </svg>

                </div>


                <h2>
                    Menu is being prepared
                </h2>


                <p>
                    There are currently no available
                    menu items for this restaurant.
                </p>

            </div>
        }

    </div>

</div>



<!-- =========================================================
     PERMANENT FIXED CART
========================================================= -->

<a asp-controller="Cart"
   asp-action="Index"
   id="sticky-cart-bar"
   class="rq-sticky-cart">

    <div class="rq-sticky-cart-left">


        <div class="rq-cart-bag-icon">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 aria-hidden="true">

                <path d="M5 8h14l-1 12H6L5 8Z"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linejoin="round" />

                <path d="M9 9V7a3 3 0 0 1 6 0v2"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round" />

            </svg>

        </div>


        <div class="rq-sticky-cart-info">

            <span class="rq-sticky-cart-count">

                <span id="sticky-cart-count">
                    @Model.CartQuantity
                </span>


                <span id="sticky-cart-item-label">

                    @(Model.CartQuantity == 1
                                        ? "item"
                                        : "items")

                </span>

            </span>


            <span class="rq-sticky-cart-total">

                ₹<span id="sticky-cart-total">@Model.CartTotal.ToString("N0")</span>

            </span>

        </div>

    </div>


    <span class="rq-sticky-cart-button">

        <span>
            View Cart
        </span>


        <span class="rq-sticky-cart-arrow">
            →
        </span>

    </span>

</a>



<!-- =========================================================
     ADD TO CART TOAST
========================================================= -->

<div id="menu-toast"
     class="rq-menu-toast"
     role="status"
     aria-live="polite">

    <span class="rq-menu-toast-check">
        ✓
    </span>


    <span id="menu-toast-message">
        Added to cart
    </span>

</div>



@section Scripts {

    <script src="~/js/customer-menu.js" asp-append-version="true"></script>

}