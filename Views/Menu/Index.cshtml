@model RestaurantQR.ViewModels.QRMenuViewModel

@{
    ViewData["Title"] = Model.RestaurantName;
    Layout = "/Views/Shared/_CustomerLayout.cshtml";
}

@section Styles {

    <style>

        /* =========================================================
                   CUSTOMER MENU PAGE
                ========================================================= */

        body {
            margin: 0;
            background: #f9f5ec;
            color: #2c2c2c;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        h1,
        h2,
        h3 {
            font-family: "DM Serif Display", serif;
            letter-spacing: -0.02em;
        }


        /* =========================================================
                   CUSTOM CONTAINER

                   Do NOT override Bootstrap .container globally.
                   This container gives proper space on mobile.
                ========================================================= */

        .menu-page-container {
            width: calc(100% - 32px);
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
        }


        /* =========================================================
                   HERO SECTION
                ========================================================= */

        .menu-hero {
            position: relative;
            padding: 70px 0 48px;
            text-align: center;
            overflow: hidden;
        }

            .menu-hero::before {
                content: "";
                position: absolute;
                width: 280px;
                height: 280px;
                left: 50%;
                top: 10px;
                transform: translateX(-50%);
                border-radius: 50%;
                background: radial-gradient( circle, rgba(180, 139, 69, 0.08) 0%, rgba(180, 139, 69, 0) 70% );
                pointer-events: none;
            }

        .menu-hero-content {
            position: relative;
            z-index: 1;
        }

        .menu-hero h1 {
            margin: 0;
            color: #281b16;
            font-size: clamp(2.5rem, 7vw, 4rem);
            font-weight: 400;
            line-height: 1.05;
            text-wrap: balance;
        }

        .menu-hero p {
            margin: 18px 0 0;
            color: #7a6f5c;
            font-size: 1rem;
            font-weight: 500;
            letter-spacing: 0.01em;
        }


        /* =========================================================
                   CATEGORY STICKY NAVIGATION
                ========================================================= */

        .category-dock {
            position: sticky;
            /*
                        Keeps categories below the customer navbar.
                        If your navbar height changes later,
                        only change this value.
                    */
            top: 72px;
            z-index: 1000;
            padding: 12px 0 8px;
            background: rgba(249, 245, 236, 0.95);
            border-top: 1px solid rgba(40, 27, 22, 0.04);
            border-bottom: 1px solid rgba(40, 27, 22, 0.07);
            -webkit-backdrop-filter: blur(15px);
            backdrop-filter: blur(15px);
        }

        .category-list {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            overflow-x: auto;
            overflow-y: hidden;
            padding: 2px 0 7px;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
            scroll-snap-type: x proximity;
        }

            .category-list::-webkit-scrollbar {
                display: none;
            }

        .category-pill {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            padding: 10px 19px;
            border: 1px solid #d8cbb3;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.92);
            color: #6d614f;
            font-size: 0.88rem;
            font-weight: 700;
            line-height: 1;
            text-decoration: none;
            white-space: nowrap;
            scroll-snap-align: start;
            box-shadow: 0 3px 10px rgba(69, 49, 34, 0.025);
            transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        }

            .category-pill:hover {
                color: #ffffff;
                background: #b48b45;
                border-color: #b48b45;
                box-shadow: 0 7px 16px rgba(180, 139, 69, 0.18);
            }

            .category-pill.active {
                color: #ffffff;
                background: #b48b45;
                border-color: #b48b45;
                box-shadow: 0 8px 18px rgba(180, 139, 69, 0.22);
            }

            .category-pill:active {
                transform: scale(0.96);
            }


        /* =========================================================
                   MENU CONTENT
                ========================================================= */

        .menu-content {
            padding-top: 38px;
            padding-bottom: 135px;
        }

        .category-section {
            margin-bottom: 58px;
            scroll-margin-top: 150px;
        }

            .category-section:last-child {
                margin-bottom: 0;
            }

        .category-title {
            position: relative;
            margin: 0 0 22px;
            color: #281b16;
            font-size: clamp(2rem, 6vw, 2.7rem);
            font-weight: 400;
            line-height: 1.1;
            overflow-wrap: anywhere;
        }

            .category-title::after {
                content: "";
                display: block;
                width: 42px;
                height: 3px;
                margin-top: 12px;
                border-radius: 999px;
                background: #b48b45;
            }


        /* =========================================================
                   MENU CARD
                ========================================================= */

        .menu-card {
            position: relative;
            width: 100%;
            margin-bottom: 24px;
            overflow: hidden;
            border: 1px solid rgba(68, 47, 32, 0.07);
            border-radius: 22px;
            background: #fffdf8;
            box-shadow: 0 8px 24px rgba(52, 36, 27, 0.07), 0 2px 6px rgba(52, 36, 27, 0.025);
            transform: translateZ(0);
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        }

            .menu-card:last-child {
                margin-bottom: 0;
            }

            .menu-card:hover {
                transform: translateY(-3px);
                border-color: rgba(180, 139, 69, 0.17);
                box-shadow: 0 16px 36px rgba(52, 36, 27, 0.10), 0 4px 10px rgba(52, 36, 27, 0.04);
            }


        /* =========================================================
                   FOOD IMAGE
                ========================================================= */

        .menu-image-wrap {
            position: relative;
            width: 100%;
            overflow: hidden;
            background: #eee5d5;
        }

        .menu-image {
            display: block;
            width: 100%;
            height: 250px;
            object-fit: cover;
            object-position: center;
            transition: transform 0.5s ease;
        }

        .menu-card:hover .menu-image {
            transform: scale(1.025);
        }


        /* =========================================================
                   MENU CARD BODY
                ========================================================= */

        .menu-body {
            padding: 20px;
        }

        .menu-name {
            margin: 0 0 8px;
            color: #281b16;
            font-family: "DM Serif Display", serif;
            font-size: 1.4rem;
            font-weight: 400;
            line-height: 1.2;
            overflow-wrap: anywhere;
        }

        .menu-description {
            margin: 0 0 18px;
            color: #796f61;
            font-size: 0.88rem;
            font-weight: 400;
            line-height: 1.65;
            overflow-wrap: anywhere;
        }


        /* =========================================================
                   SERVING OPTIONS
                ========================================================= */

        .serving-title {
            margin-bottom: 10px;
            color: #7a6f5c;
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        .serving-options {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 18px;
        }

        .serving-option {
            position: relative;
        }

            .serving-option input {
                position: absolute;
                width: 1px;
                height: 1px;
                opacity: 0;
                pointer-events: none;
            }

            .serving-option label {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                min-height: 42px;
                padding: 9px 13px;
                border: 1px solid #d8cbb3;
                border-radius: 12px;
                background: #ffffff;
                color: #6d614f;
                font-size: 0.8rem;
                font-weight: 700;
                line-height: 1.2;
                cursor: pointer;
                user-select: none;
                transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
            }

                .serving-option label:hover {
                    border-color: #b48b45;
                    box-shadow: 0 4px 12px rgba(180, 139, 69, 0.10);
                }

            .serving-option input:checked + label {
                color: #ffffff;
                background: #b48b45;
                border-color: #b48b45;
                box-shadow: 0 6px 15px rgba(180, 139, 69, 0.20);
            }

            .serving-option label:active {
                transform: scale(0.97);
            }

        .serving-option-price {
            font-weight: 800;
        }


        /* =========================================================
                   MENU FOOTER
                ========================================================= */

        .menu-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            width: 100%;
        }

        .menu-price {
            color: #b48b45;
            font-size: 1rem;
            font-weight: 800;
        }

        .menu-add-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 96px;
            min-height: 42px;
            padding: 10px 18px;
            border: none;
            border-radius: 12px;
            background: #b48b45;
            color: #ffffff;
            font-size: 0.82rem;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 7px 17px rgba(180, 139, 69, 0.18);
            transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
        }

            .menu-add-button:hover {
                background: #9d7638;
                box-shadow: 0 9px 20px rgba(157, 118, 56, 0.23);
            }

            .menu-add-button:active {
                transform: scale(0.96);
            }

            .menu-add-button:disabled {
                opacity: 0.5;
                cursor: not-allowed;
                box-shadow: none;
            }


        /* =========================================================
                   STICKY CART BAR
                ========================================================= */

        .sticky-cart-bar {
            position: fixed;
            left: 16px;
            right: 16px;
            bottom: max( 14px, env(safe-area-inset-bottom) );
            z-index: 2000;
            max-width: 868px;
            margin-left: auto;
            margin-right: auto;
            padding: 13px 15px;
            border: 1px solid rgba(255, 255, 255, 0.09);
            border-radius: 18px;
            background: rgba(40, 27, 22, 0.97);
            color: #ffffff;
            text-decoration: none;
            box-shadow: 0 15px 40px rgba(40, 27, 22, 0.25);
            transform: translateY(calc(100% + 40px));
            transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
            -webkit-backdrop-filter: blur(14px);
            backdrop-filter: blur(14px);
        }

            .sticky-cart-bar.show-cart {
                transform: translateY(0);
            }

        .sticky-cart-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .sticky-cart-count-wrap {
            color: rgba(255, 255, 255, 0.82);
            font-size: 0.84rem;
            font-weight: 600;
            white-space: nowrap;
        }

        #sticky-cart-count {
            color: #ffffff;
            font-weight: 800;
        }

        .sticky-cart-total {
            color: #ffffff;
            font-size: 1rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .sticky-cart-button {
            flex: 0 0 auto;
            padding: 10px 14px;
            border-radius: 11px;
            background: #b48b45;
            color: #ffffff;
            font-size: 0.82rem;
            font-weight: 800;
            white-space: nowrap;
        }


        /* =========================================================
                   TABLET
                ========================================================= */

        @@media (max-width: 767.98px) {

            .menu-page-container {
                width: calc(100% - 32px);
            }

            .menu-hero {
                padding-top: 58px;
                padding-bottom: 42px;
            }

            .menu-image {
                height: 235px;
            }
        }


        /* =========================================================
                   MOBILE
                ========================================================= */

        @@media (max-width: 575.98px) {

            .menu-page-container {
                width: calc(100% - 32px);
            }

            .menu-hero {
                padding-top: 54px;
                padding-bottom: 40px;
            }

                .menu-hero h1 {
                    font-size: clamp(2.45rem, 11vw, 3.25rem);
                    line-height: 1.03;
                }

                .menu-hero p {
                    margin-top: 16px;
                    font-size: 0.94rem;
                }

            .category-dock {
                top: 68px;
                padding-top: 10px;
                padding-bottom: 7px;
            }

            .category-list {
                gap: 9px;
            }

            .category-pill {
                min-height: 43px;
                padding: 9px 17px;
                font-size: 0.83rem;
            }

            .menu-content {
                padding-top: 32px;
                padding-bottom: 125px;
            }

            .category-section {
                margin-bottom: 48px;
                scroll-margin-top: 140px;
            }

            .category-title {
                margin-bottom: 18px;
                font-size: 2.05rem;
            }

                .category-title::after {
                    width: 36px;
                    margin-top: 10px;
                }

            .menu-card {
                margin-bottom: 20px;
                border-radius: 20px;
            }

            .menu-image {
                height: 215px;
            }

            .menu-body {
                padding: 18px;
            }

            .menu-name {
                font-size: 1.32rem;
            }

            .menu-description {
                margin-bottom: 16px;
                font-size: 0.85rem;
                line-height: 1.6;
            }

            .serving-options {
                gap: 7px;
            }

            .serving-option label {
                min-height: 40px;
                padding: 8px 11px;
                font-size: 0.77rem;
            }

            .menu-footer {
                flex-direction: row;
                align-items: center;
            }

            .menu-add-button {
                min-width: 90px;
                min-height: 41px;
            }

            .sticky-cart-bar {
                left: 12px;
                right: 12px;
                padding: 12px 13px;
                border-radius: 17px;
            }

            .sticky-cart-button {
                padding: 9px 12px;
                font-size: 0.78rem;
            }

            .sticky-cart-total {
                font-size: 0.92rem;
            }

            .sticky-cart-count-wrap {
                font-size: 0.78rem;
            }
        }


        /* =========================================================
                   SMALL MOBILE
                ========================================================= */

        @@media (max-width: 390px) {

            .menu-page-container {
                width: calc(100% - 28px);
            }

            .menu-hero {
                padding-top: 48px;
                padding-bottom: 36px;
            }

                .menu-hero h1 {
                    font-size: 2.35rem;
                }

                .menu-hero p {
                    font-size: 0.88rem;
                }

            .category-title {
                font-size: 1.9rem;
            }

            .menu-image {
                height: 195px;
            }

            .menu-body {
                padding: 16px;
            }

            .menu-name {
                font-size: 1.25rem;
            }

            .menu-add-button {
                min-width: 82px;
                padding-left: 14px;
                padding-right: 14px;
            }

            .sticky-cart-content {
                gap: 8px;
            }

            .sticky-cart-button {
                padding-left: 10px;
                padding-right: 10px;
            }
        }


        /* =========================================================
                   VERY SMALL MOBILE
                ========================================================= */

        @@media (max-width: 350px) {

            .menu-page-container {
                width: calc(100% - 24px);
            }

            .menu-hero h1 {
                font-size: 2.1rem;
            }

            .menu-image {
                height: 180px;
            }

            .menu-footer {
                gap: 10px;
            }

            .sticky-cart-total {
                display: none;
            }
        }

    </style>
}


<!-- =========================================================
     HERO
========================================================= -->

<section class="menu-hero">

    <div class="menu-page-container menu-hero-content">

        <h1>
            @Model.RestaurantName
        </h1>

        <p>
            Scan. Order. Relax.
        </p>

    </div>

</section>


<!-- =========================================================
     CATEGORY NAVIGATION
========================================================= -->
@if (Model.Categories.Any())
{
    <div class="category-dock">

        <div class="menu-page-container">

            <div class="category-list">

                @for (int i = 0; i < Model.Categories.Count; i++)
                {
                    <a href="#cat-@i"
                       class="category-pill @(i == 0 ? "active" : "")">

                        @Model.Categories[i].Name

                    </a>
                }

            </div>

        </div>

    </div>


    <!-- =========================================================
         MENU CONTENT
    ========================================================= -->

    <main class="menu-page-container menu-content">

        @for (int i = 0; i < Model.Categories.Count; i++)
        {
            var category = Model.Categories[i];

            <section id="cat-@i"
                     class="category-section">

                <h2 class="category-title">
                    @category.Name
                </h2>


                @foreach (var item in category.MenuItems)
                {
                    <article class="menu-card">

                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <div class="menu-image-wrap">

                                <img src="@item.ImageUrl"
                                     class="menu-image"
                                     alt="@item.Name"
                                     loading="lazy" />

                            </div>
                        }


                        <div class="menu-body">

                            <div class="menu-name">
                                @item.Name
                            </div>


                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="menu-description">
                                    @item.Description
                                </div>
                            }


                            <!-- =================================================
                                 ITEM WITH SERVING OPTIONS
                            ================================================== -->
                            @if (item.Options.Any())
                            {
                                <div class="serving-title">
                                    Choose Serving
                                </div>


                                <form asp-controller="Cart"
                                      asp-action="Add"
                                      method="post"
                                      class="add-to-cart-form">

                                    @Html.AntiForgeryToken()


                                    <input type="hidden"
                                           name="menuItemId"
                                           value="@item.Id" />


                                    <input type="hidden"
                                           name="qrToken"
                                           value="@Model.QRToken" />


                                    <div class="serving-options">

                                        @foreach (var option in item.Options)
                                        {
                                            var optionInputId =
                                            $"option-{item.Id}-{option.Id}";

                                            <div class="serving-option">

                                                <input type="radio"
                                                       id="@optionInputId"
                                                       name="optionId"
                                                       value="@option.Id"
                                                       required />


                                                <label for="@optionInputId">

                                                    <span>
                                                        @option.Name
                                                    </span>

                                                    <span class="serving-option-price">
                                                        ₹@option.Price.ToString("N0")
                                                    </span>

                                                </label>

                                            </div>
                                        }

                                    </div>


                                    <div class="menu-footer">

                                        <div class="menu-price"
                                             data-selected-price>

                                            Select serving

                                        </div>


                                        <button type="submit"
                                                class="menu-add-button">

                                            Add

                                        </button>

                                    </div>

                                </form>
                            }
                            else
                            {
                                <!-- =================================================
                                     ITEM WITHOUT SERVING OPTIONS
                                ================================================== -->

                                <div class="menu-footer">

                                    <div class="menu-price">

                                        ₹@item.Price.ToString("N0")

                                    </div>


                                    <form asp-controller="Cart"
                                          asp-action="Add"
                                          method="post"
                                          class="add-to-cart-form">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="menuItemId"
                                               value="@item.Id" />


                                        <input type="hidden"
                                               name="optionId"
                                               value="0" />


                                        <input type="hidden"
                                               name="qrToken"
                                               value="@Model.QRToken" />


                                        <button type="submit"
                                                class="menu-add-button">

                                            Add

                                        </button>

                                    </form>

                                </div>
                            }

                        </div>

                    </article>
                }

            </section>
        }

    </main>
}


<!-- =========================================================
     STICKY CART
========================================================= -->

<a asp-controller="Cart"
   asp-action="Index"
   id="sticky-cart-bar"
   class="sticky-cart-bar">

    <div class="sticky-cart-content">

        <div class="sticky-cart-count-wrap">

            <span id="sticky-cart-count">
                0
            </span>

            items

        </div>


        <div class="sticky-cart-total">

            ₹<span id="sticky-cart-total">0</span>

        </div>


        <div class="sticky-cart-button">

            View Cart →

        </div>

    </div>

</a>


@section Scripts {

    <script src="~/js/customer-menu.js"
            asp-append-version="true">
    </script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                /*
                =========================================================
                SERVING PRICE SELECTION
                =========================================================
                */

                document
                    .querySelectorAll(".menu-card")
                    .forEach(function (card) {

                        const radios =
                            card.querySelectorAll(
                                'input[name="optionId"]'
                            );

                        const priceDisplay =
                            card.querySelector(
                                "[data-selected-price]"
                            );


                        if (!priceDisplay) {
                            return;
                        }


                        radios.forEach(function (radio) {

                            radio.addEventListener(
                                "change",
                                function () {

                                    const label =
                                        card.querySelector(
                                            'label[for="' +
                                            radio.id +
                                            '"]'
                                        );


                                    if (!label) {
                                        return;
                                    }


                                    const priceElement =
                                        label.querySelector(
                                            ".serving-option-price"
                                        );


                                    if (!priceElement) {
                                        return;
                                    }


                                    priceDisplay.textContent =
                                        priceElement.textContent.trim();

                                }
                            );

                        });

                    });


                /*
                =========================================================
                CATEGORY ACTIVE STATE
                =========================================================
                */

                const categoryLinks =
                    document.querySelectorAll(
                        ".category-pill"
                    );


                categoryLinks.forEach(function (link) {

                    link.addEventListener(
                        "click",
                        function () {

                            categoryLinks.forEach(
                                function (otherLink) {

                                    otherLink.classList.remove(
                                        "active"
                                    );

                                }
                            );


                            link.classList.add(
                                "active"
                            );

                        }
                    );

                });


                /*
                =========================================================
                ACTIVE CATEGORY WHILE SCROLLING
                =========================================================
                */

                const categorySections =
                    document.querySelectorAll(
                        ".category-section"
                    );


                if (
                    "IntersectionObserver" in window &&
                    categorySections.length > 0
                ) {

                    const observer =
                        new IntersectionObserver(

                            function (entries) {

                                entries.forEach(
                                    function (entry) {

                                        if (!entry.isIntersecting) {
                                            return;
                                        }


                                        const sectionId =
                                            entry.target.id;


                                        const activeLink =
                                            document.querySelector(
                                                '.category-pill[href="#' +
                                                sectionId +
                                                '"]'
                                            );


                                        if (!activeLink) {
                                            return;
                                        }


                                        categoryLinks.forEach(
                                            function (link) {

                                                link.classList.remove(
                                                    "active"
                                                );

                                            }
                                        );


                                        activeLink.classList.add(
                                            "active"
                                        );


                                        activeLink.scrollIntoView({
                                            behavior: "smooth",
                                            block: "nearest",
                                            inline: "center"
                                        });

                                    }
                                );

                            },

                            {
                                root: null,
                                rootMargin:
                                    "-150px 0px -60% 0px",

                                threshold: 0
                            }

                        );


                    categorySections.forEach(
                        function (section) {

                            observer.observe(section);

                        }
                    );

                }

            }
