@model RestaurantQR.ViewModels.OrderConfirmationViewModel

@{
    ViewData["Title"] = "Order Confirmed";
    Layout = "/Views/Shared/_CustomerLayout.cshtml";
}

<style>

    /* =========================================================
           MAIN PAGE
           ========================================================= */

    .order-confirmation-page {
        --rq-white: #FFFDF7;
        --rq-cream: #F5E6CA;
        --rq-beige: #DCC7AA;
        --rq-coffee: #6F4E37;
        --rq-espresso: #4B3832;
        --rq-deep: #352822;
        --rq-gold: #B8894D;
        --rq-muted: #8B7565;
        --rq-green: #7F9158;
        --rq-orange: #B8894D;
        width: min(920px, calc(100% - 36px));
        margin: 0 auto;
        padding: 25px 0 70px;
        color: var(--rq-espresso);
        animation: orderFadeUp .7s ease both;
    }


    /* =========================================================
           HERO
           ========================================================= */

    .order-success-hero {
        text-align: center;
        margin-bottom: 30px;
    }


    .order-success-icon {
        position: relative;
        width: 92px;
        height: 92px;
        margin: 0 auto 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: linear-gradient( 135deg, var(--rq-green), #687A48 );
        color: var(--rq-white);
        font-size: 42px;
        font-weight: 700;
        box-shadow: 0 18px 42px rgba(105,123,75,.23), 0 0 0 10px rgba(127,145,88,.09);
        animation: orderSuccessPop .7s cubic-bezier(.2,.8,.2,1) both;
    }


    /* =========================================================
           COMPLETED SUCCESS ANIMATION
           ========================================================= */

    .order-confirmation-page.order-completed
    .order-success-icon {
        animation: completedIconPop .7s cubic-bezier(.17,.89,.32,1.49) both, completedGlow 2s ease-in-out infinite .7s;
        background: linear-gradient( 135deg, #7F9158, #53683B );
    }


        .order-confirmation-page.order-completed
        .order-success-icon::before {
            content: "";
            position: absolute;
            inset: -10px;
            border-radius: 50%;
            border: 2px solid rgba(127,145,88,.35);
            animation: completedRing 1.2s ease-out both;
        }


        .order-confirmation-page.order-completed
        .order-success-icon::after {
            content: "✓";
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 43px;
            font-weight: 700;
            color: #FFFDF7;
            animation: completedCheck .55s cubic-bezier(.17,.89,.32,1.49) .15s both;
        }


    .order-confirmation-page.order-completed
    .order-success-icon {
        font-size: 0;
    }


    /* =========================================================
           COMPLETION MESSAGE
           ========================================================= */

    .completion-message {
        display: none;
        max-width: 620px;
        margin: 18px auto 0;
        padding: 12px 18px;
        border-radius: 16px;
        background: rgba(127,145,88,.10);
        border: 1px solid rgba(127,145,88,.18);
        color: #647447;
        font-size: 13px;
        font-weight: 600;
        animation: completionMessage .6s ease both;
    }


    .order-confirmation-page.order-completed
    .completion-message {
        display: block;
    }


    /* =========================================================
           INVOICE CONTAINER
           ========================================================= */

    #invoice-container {
        width: 100%;
        max-width: 900px;
        margin: 30px auto 0;
        opacity: 0;
        transform: translateY(35px);
        transition: opacity .7s ease, transform .7s ease;
    }


        #invoice-container.invoice-visible {
            opacity: 1;
            transform: translateY(0);
        }


    /* =========================================================
           CONFETTI
           ========================================================= */

    .completion-confetti {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        overflow: hidden;
        z-index: 9999;
    }


    .confetti-piece {
        position: absolute;
        top: -20px;
        width: 8px;
        height: 14px;
        opacity: 0;
        border-radius: 2px;
        animation: confettiFall var(--fall-time) cubic-bezier(.15,.75,.35,1) forwards;
        animation-delay: var(--delay);
    }


    /* =========================================================
           EYEBROW
           ========================================================= */

    .order-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
        color: var(--rq-coffee);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 3.3px;
        text-transform: uppercase;
    }


        .order-eyebrow::before,
        .order-eyebrow::after {
            content: "";
            width: 32px;
            height: 1px;
            background: var(--rq-gold);
        }


    .order-title {
        max-width: 760px;
        margin: 0 auto;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(48px, 6vw, 72px);
        font-weight: 400;
        line-height: .96;
        letter-spacing: -3px;
        color: var(--rq-espresso);
    }


        .order-title em {
            color: var(--rq-coffee);
            font-style: italic;
            font-weight: 400;
        }


    .order-description {
        max-width: 620px;
        margin: 18px auto 0;
        color: var(--rq-muted);
        font-size: 14px;
        line-height: 1.75;
    }


    /* =========================================================
           MAIN CARD
           ========================================================= */

    .order-card {
        position: relative;
        overflow: hidden;
        padding: 30px;
        border: 1px solid rgba(255,255,255,.96);
        border-radius: 30px;
        background: linear-gradient( 135deg, rgba(255,253,247,.92), rgba(245,230,202,.60) );
        box-shadow: 0 26px 70px rgba(75,56,50,.10);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }


        .order-card::before {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            right: -105px;
            top: -105px;
            border-radius: 50%;
            background: rgba(220,199,170,.28);
            pointer-events: none;
        }


        .order-card::after {
            content: "";
            position: absolute;
            width: 160px;
            height: 160px;
            left: -80px;
            bottom: -80px;
            border-radius: 50%;
            background: rgba(184,137,77,.07);
            pointer-events: none;
        }


    /* =========================================================
           CARD HEADER
           ========================================================= */

    .order-card-header {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 23px;
        margin-bottom: 24px;
        border-bottom: 1px solid rgba(75,56,50,.10);
    }


    .order-card-heading {
        display: flex;
        align-items: center;
        gap: 13px;
    }


    .order-card-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        background: var(--rq-coffee);
        color: var(--rq-white);
        font-size: 20px;
        box-shadow: 0 12px 27px rgba(111,78,55,.20);
    }


    .order-card-heading h2 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 24px;
        font-weight: 400;
        color: var(--rq-espresso);
    }


    .order-card-heading span {
        display: block;
        margin-top: 4px;
        color: var(--rq-muted);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }


    .order-live-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #647447;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.7px;
        text-transform: uppercase;
    }


    .order-live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #83965D;
        box-shadow: 0 0 0 5px rgba(131,150,93,.10);
        animation: orderPulse 1.7s ease-in-out infinite;
    }


    /* =========================================================
           ORDER NUMBER
           ========================================================= */

    .order-number-panel {
        position: relative;
        z-index: 2;
        padding: 24px;
        margin-bottom: 18px;
        text-align: center;
        border: 1px solid rgba(111,78,55,.11);
        border-radius: 21px;
        background: rgba(255,253,247,.64);
    }


    .order-number-label {
        display: block;
        margin-bottom: 7px;
        color: var(--rq-muted);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 2.3px;
        text-transform: uppercase;
    }


    .order-number-value {
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(30px, 5vw, 46px);
        color: var(--rq-coffee);
        letter-spacing: -1px;
    }


    /* =========================================================
           DETAILS GRID
           ========================================================= */

    .order-details-grid {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 12px;
        margin-bottom: 20px;
    }


    .order-detail-card {
        min-height: 110px;
        padding: 17px;
        border-radius: 17px;
        background: rgba(245,230,202,.34);
        border: 1px solid rgba(111,78,55,.08);
    }


    .order-detail-label {
        display: block;
        margin-bottom: 9px;
        color: var(--rq-muted);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 1.8px;
        text-transform: uppercase;
    }


    .order-detail-value {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 21px;
        color: var(--rq-espresso);
    }


        .order-detail-value.price {
            color: var(--rq-coffee);
        }


    /* =========================================================
           STATUS
           ========================================================= */

    .order-status-panel {
        position: relative;
        z-index: 2;
        overflow: hidden;
        padding: 23px;
        border-radius: 21px;
        border: 1px solid rgba(184,137,77,.18);
        background: linear-gradient( 135deg, rgba(245,230,202,.48), rgba(255,253,247,.72) );
        transition: background .3s ease, border-color .3s ease;
    }


    .order-status-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 15px;
    }


    .order-status-heading {
        display: flex;
        align-items: center;
        gap: 12px;
    }


    .order-status-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: var(--rq-espresso);
        color: var(--rq-white);
        font-size: 16px;
    }


    .order-status-heading div:last-child span {
        display: block;
        margin-bottom: 3px;
        color: var(--rq-muted);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 1.6px;
        text-transform: uppercase;
    }


    .order-status-heading div:last-child strong {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 20px;
        font-weight: 400;
        color: var(--rq-espresso);
    }


    .order-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 34px;
        padding: 0 13px;
        border-radius: 18px;
        background: rgba(184,137,77,.13);
        color: #87633B;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .7px;
        text-transform: uppercase;
        transition: background .25s ease, color .25s ease;
    }


        .order-status-badge::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--rq-gold);
        }


    .order-status-message {
        margin: 0;
        color: var(--rq-muted);
        font-size: 12px;
        line-height: 1.7;
        transition: opacity .3s ease, transform .3s ease;
    }


    /* =========================================================
           STATUS COLORS
           ========================================================= */

    .order-status-badge.status-pending {
        background: rgba(184,137,77,.13);
        color: #87633B;
    }


        .order-status-badge.status-pending::before {
            background: var(--rq-gold);
        }


    .order-status-badge.status-accepted {
        background: rgba(111,78,55,.12);
        color: var(--rq-coffee);
    }


        .order-status-badge.status-accepted::before {
            background: var(--rq-coffee);
        }


    .order-status-badge.status-preparing {
        background: rgba(111,78,55,.16);
        color: var(--rq-espresso);
    }


        .order-status-badge.status-preparing::before {
            background: var(--rq-espresso);
        }


    .order-status-badge.status-ready {
        background: rgba(127,145,88,.13);
        color: #647447;
    }


        .order-status-badge.status-ready::before {
            background: #7F9158;
        }


    .order-status-badge.status-completed {
        background: rgba(127,145,88,.17);
        color: #59683D;
    }


        .order-status-badge.status-completed::before {
            background: #647447;
        }


    /* =========================================================
           PROGRESS
           ========================================================= */

    .order-progress {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(5,1fr);
        gap: 8px;
        margin-top: 20px;
    }


    .progress-step {
        position: relative;
        min-height: 8px;
        border-radius: 10px;
        background: rgba(111,78,55,.10);
        overflow: hidden;
    }


        .progress-step.active {
            background: linear-gradient( 90deg, var(--rq-gold), var(--rq-coffee) );
            animation: progressActivate .45s ease both;
        }


    .order-confirmation-page.order-completed
    .progress-step.active:last-child {
        background: linear-gradient( 90deg, #7F9158, #53683B );
        box-shadow: 0 0 12px rgba(127,145,88,.28);
    }


    /* =========================================================
           NOTE
           ========================================================= */

    .order-note {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 19px;
        padding: 14px 16px;
        border-radius: 15px;
        background: rgba(255,253,247,.54);
        color: var(--rq-muted);
        font-size: 11px;
        line-height: 1.65;
    }


    .order-note-icon {
        color: var(--rq-gold);
        font-size: 15px;
    }


    /* =========================================================
           ANIMATIONS
           ========================================================= */

    @@keyframes orderFadeUp {

        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@keyframes orderSuccessPop {

        0% {
            opacity: 0;
            transform: scale(.55);
        }

        70% {
            transform: scale(1.07);
        }

        100% {
            opacity: 1;
            transform: scale(1);
        }
    }


    @@keyframes orderPulse {

        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .45;
        }
    }


    @@keyframes completedIconPop {

        0% {
            transform: scale(.55) rotate(-12deg);
        }

        60% {
            transform: scale(1.15) rotate(4deg);
        }

        100% {
            transform: scale(1) rotate(0);
        }
    }


    @@keyframes completedCheck {

        0% {
            opacity: 0;
            transform: scale(.3) rotate(-15deg);
        }

        65% {
            opacity: 1;
            transform: scale(1.2) rotate(3deg);
        }

        100% {
            opacity: 1;
            transform: scale(1) rotate(0);
        }
    }


    @@keyframes completedRing {

        0% {
            opacity: .8;
            transform: scale(.75);
        }

        100% {
            opacity: 0;
            transform: scale(1.45);
        }
    }


    @@keyframes completedGlow {

        0%, 100% {
            box-shadow: 0 18px 42px rgba(105,123,75,.23), 0 0 0 10px rgba(127,145,88,.09);
        }

        50% {
            box-shadow: 0 20px 50px rgba(105,123,75,.38), 0 0 0 16px rgba(127,145,88,.07);
        }
    }


    @@keyframes completionMessage {

        from {
            opacity: 0;
            transform: translateY(10px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }


    @@keyframes progressActivate {

        from {
            opacity: .4;
            transform: scaleX(.7);
        }

        to {
            opacity: 1;
            transform: scaleX(1);
        }
    }


    @@keyframes confettiFall {

        0% {
            opacity: 1;
            transform: translate3d(0,-20px,0) rotate(0deg);
        }

        100% {
            opacity: 0;
            transform: translate3d( var(--drift), 105vh, 0 ) rotate(720deg);
        }
    }


    /* =========================================================
           TABLET
           ========================================================= */

    @@media (max-width: 760px) {

        .order-confirmation-page {
            width: calc(100% - 28px);
        }


        .order-details-grid {
            grid-template-columns: 1fr 1fr;
        }


        .order-detail-card:last-child {
            grid-column: 1 / -1;
        }
    }


    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 560px) {

        .order-confirmation-page {
            width: calc(100% - 20px);
            padding-top: 12px;
        }


        .order-success-icon {
            width: 76px;
            height: 76px;
            font-size: 33px;
        }


        .order-eyebrow {
            font-size: 7px;
            letter-spacing: 2px;
        }


            .order-eyebrow::before,
            .order-eyebrow::after {
                width: 18px;
            }


        .order-title {
            font-size: 42px;
            letter-spacing: -2px;
        }


        .order-description {
            font-size: 13px;
            line-height: 1.6;
        }


        .order-card {
            padding: 20px 15px;
            border-radius: 23px;
        }


        .order-card-header {
            align-items: flex-start;
        }


        .order-card-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
        }


        .order-card-heading h2 {
            font-size: 20px;
        }


        .order-live-tag {
            font-size: 0;
        }


            .order-live-tag::after {
                content: "LIVE";
                font-size: 8px;
            }


        .order-number-panel {
            padding: 19px 14px;
            border-radius: 18px;
        }


        .order-details-grid {
            grid-template-columns: 1fr;
        }


        .order-detail-card:last-child {
            grid-column: auto;
        }


        .order-detail-card {
            min-height: auto;
            padding: 14px;
        }


        .order-status-top {
            align-items: flex-start;
            flex-direction: column;
        }


        .order-status-panel {
            padding: 18px 15px;
            border-radius: 18px;
        }


        .completion-message {
            font-size: 12px;
        }


        #invoice-container {
            margin-top: 22px;
        }
    }


    /* =========================================================
           CUSTOMER INVOICE
           ========================================================= */

    .customer-invoice-wrapper {
        width: 100%;
    }


    .customer-invoice {
        position: relative;
        background: #FFFDF7;
        border: 1px solid #DCC7AA;
        border-radius: 28px;
        padding: 32px;
        box-shadow: 0 20px 60px rgba(75,56,50,.12);
        overflow: hidden;
    }


    /* Invoice top */

    .invoice-top {
        display: flex;
        align-items: center;
        gap: 20px;
        padding-bottom: 25px;
        border-bottom: 1px dashed #DCC7AA;
    }


    .invoice-success {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #7F9158;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        font-weight: 700;
        box-shadow: 0 10px 25px rgba(127,145,88,.25);
        animation: invoiceSuccessPop .6s ease both;
    }


    .invoice-title-area {
        flex: 1;
    }


    .invoice-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        color: #B8894D;
        margin-bottom: 4px;
    }


    .invoice-title-area h2 {
        margin: 0;
        color: #4B3832;
        font-size: 30px;
        font-weight: 800;
    }


    .invoice-title-area p {
        margin: 5px 0 0;
        color: #8B7565;
        font-size: 13px;
    }


    /* Restaurant */

    .invoice-restaurant {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 24px 0;
    }


    .restaurant-icon {
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        border-radius: 16px;
        background: #F5E6CA;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }


    .invoice-restaurant h3 {
        margin: 0 0 4px;
        color: #4B3832;
        font-size: 20px;
    }


    .invoice-restaurant p {
        margin: 2px 0;
        color: #8B7565;
        font-size: 12px;
    }


    /* Invoice info */

    .invoice-info-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 12px;
        margin-bottom: 25px;
    }


    .invoice-info-box {
        background: #F5E6CA;
        border-radius: 15px;
        padding: 15px;
    }


        .invoice-info-box span {
            display: block;
            color: #8B7565;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }


        .invoice-info-box strong {
            color: #4B3832;
            font-size: 13px;
            word-break: break-word;
        }


    /* Section */

    .section-heading {
        color: #B8894D;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 12px;
    }


    /* Customer */

    .invoice-customer {
        padding: 20px 0;
        border-top: 1px dashed #DCC7AA;
        border-bottom: 1px dashed #DCC7AA;
    }


    .customer-details {
        display: flex;
        gap: 50px;
    }


        .customer-details div {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }


        .customer-details span {
            font-size: 11px;
            color: #8B7565;
        }


        .customer-details strong {
            font-size: 14px;
            color: #4B3832;
        }


    /* Items */

    .invoice-items {
        padding-top: 24px;
    }


    .invoice-table {
        width: 100%;
    }


    .invoice-table-header,
    .invoice-table-row {
        display: grid;
        grid-template-columns: minmax(0,1fr) 70px 110px 110px;
        align-items: center;
        gap: 12px;
    }


    .invoice-table-header {
        padding: 11px 15px;
        background: #4B3832;
        color: #FFFDF7;
        border-radius: 12px;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
    }


    .invoice-table-row {
        padding: 15px;
        border-bottom: 1px solid #F0E4D3;
        color: #6F4E37;
        font-size: 13px;
    }


    .invoice-item-name {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }


        .invoice-item-name strong {
            color: #4B3832;
            font-size: 13px;
        }


        .invoice-item-name small {
            color: #8B7565;
            font-size: 11px;
        }


    .invoice-table-row > span,
    .invoice-table-row > strong {
        text-align: right;
    }


    /* Summary */

    .invoice-summary {
        width: 100%;
        max-width: 360px;
        margin: 25px 0 0 auto;
    }


    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 7px 0;
        color: #8B7565;
        font-size: 13px;
    }


        .summary-row strong {
            color: #4B3832;
        }


    .summary-line {
        height: 1px;
        background: #DCC7AA;
        margin: 8px 0;
    }


    .summary-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 13px 0;
        color: #4B3832;
    }


        .summary-total span {
            font-size: 15px;
            font-weight: 700;
        }


        .summary-total strong {
            font-size: 24px;
            color: #6F4E37;
        }


    /* Completed */

    .invoice-completed {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-top: 25px;
        padding: 15px;
        border-radius: 16px;
        background: rgba(127,145,88,.10);
        border: 1px solid rgba(127,145,88,.20);
    }


    .completed-icon {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #7F9158;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }


    .invoice-completed strong {
        display: block;
        color: #4B3832;
        font-size: 13px;
    }


    .invoice-completed span {
        display: block;
        color: #8B7565;
        font-size: 11px;
        margin-top: 2px;
    }


    /* Footer */

    .invoice-footer {
        text-align: center;
        padding: 25px 0 5px;
    }


        .invoice-footer p {
            margin: 0 0 5px;
            color: #6F4E37;
            font-size: 13px;
            font-weight: 600;
        }


        .invoice-footer span {
            color: #A18D7C;
            font-size: 10px;
        }


    /* Print */

    .invoice-actions {
        display: flex;
        justify-content: center;
        margin-top: 22px;
    }


    .invoice-print-btn {
        border: none;
        outline: none;
        padding: 12px 22px;
        border-radius: 12px;
        background: #6F4E37;
        color: #FFFDF7;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: transform .25s ease, box-shadow .25s ease;
    }


        .invoice-print-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(111,78,55,.22);
        }


    /* Invoice animation */

    @@keyframes invoiceSuccessPop {

        0% {
            opacity: 0;
            transform: scale(.5) rotate(-15deg);
        }

        70% {
            transform: scale(1.12) rotate(3deg);
        }

        100% {
            opacity: 1;
            transform: scale(1) rotate(0);
        }
    }


    /* =========================================================
           INVOICE MOBILE
           ========================================================= */

    @@media (max-width: 700px) {

        .customer-invoice {
            padding: 20px 15px;
            border-radius: 20px;
        }


        .invoice-top {
            align-items: flex-start;
        }


        .invoice-success {
            width: 46px;
            height: 46px;
            font-size: 21px;
        }


        .invoice-title-area h2 {
            font-size: 24px;
        }


        .invoice-label {
            font-size: 8px;
            letter-spacing: 1.4px;
        }


        .invoice-title-area p {
            font-size: 11px;
        }


        .invoice-info-grid {
            grid-template-columns: repeat(2,1fr);
        }


        .customer-details {
            flex-direction: column;
            gap: 10px;
        }


        .invoice-table-header,
        .invoice-table-row {
            grid-template-columns: minmax(0,1fr) 40px 75px 85px;
            gap: 7px;
        }


        .invoice-table-header {
            padding: 10px 8px;
            font-size: 8px;
        }


        .invoice-table-row {
            padding: 13px 8px;
            font-size: 11px;
        }


        .invoice-item-name strong {
            font-size: 11px;
        }


        .invoice-item-name small {
            font-size: 9px;
        }


        .summary-total strong {
            font-size: 20px;
        }
    }


    @@media (max-width: 420px) {

        .invoice-info-grid {
            gap: 8px;
        }


        .invoice-info-box {
            padding: 11px;
        }


            .invoice-info-box strong {
                font-size: 11px;
            }


        .invoice-table-header,
        .invoice-table-row {
            grid-template-columns: minmax(0,1fr) 30px 62px 72px;
            gap: 5px;
        }


        .invoice-table-row {
            font-size: 10px;
        }


            .invoice-table-row > span,
            .invoice-table-row > strong {
                white-space: nowrap;
            }


        .invoice-restaurant h3 {
            font-size: 17px;
        }
    }


    /* =========================================================
           PRINT
           ========================================================= */

    @@media print {

        body * {
            visibility: hidden !important;
        }


        #customer-invoice,
        #customer-invoice * {
            visibility: visible !important;
        }


        #customer-invoice {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            box-shadow: none;
            border: none;
        }


        .invoice-actions {
            display: none !important;
        }


        #invoice-container {
            margin: 0;
            max-width: none;
        }
    }

    /* =========================================================
       MY ORDERS BUTTON
       ========================================================= */

    .my-orders-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 20px;
        margin-top: 14px;
        border: 1px solid rgba(111, 78, 55, .18);
        border-radius: 13px;
        background: #FFFDF7;
        color: #6F4E37;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .2px;
        transition: transform .25s ease, background .25s ease, color .25s ease, box-shadow .25s ease;
    }

        .my-orders-button:hover {
            background: #6F4E37;
            color: #FFFDF7;
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(111, 78, 55, .18);
        }

        .my-orders-button:active {
            transform: translateY(0);
        }

    @@media (max-width: 560px) {

        .my-orders-button {
            width: 100%;
            margin-top: 12px;
        }
    }


    .my-orders-wrapper {
        text-align: center;
        margin-top: 8px;
    }
</style>


<div class="order-confirmation-page"
     id="order-confirmation-page">


    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="order-success-hero">


        <div class="order-success-icon"
             id="success-icon">

            ✓

        </div>


        <div class="order-eyebrow">

            ORDER CONFIRMED

        </div>


        <h1 class="order-title">

            Your Order is
            <em>Successfully Placed.</em>

        </h1>


        <p class="order-description">

            Your order has been sent directly to the restaurant.
            Stay on this page to receive live updates while
            your food is accepted and prepared.

        </p>


        <!-- Completion message -->

        <div class="completion-message"
             id="completion-message">

            ✓ Your order has been completed. Enjoy your meal!

        </div>


        <!-- =================================================
             CUSTOMER INVOICE
             Loaded automatically after Completed
             ================================================= -->

        <div id="invoice-container"></div>


        <div class="my-orders-wrapper">
            <a href="@Url.Action("MyOrders", "Order")"
               class="my-orders-button">
                🧾 View My Orders
            </a>
        </div>

    </section>


    <!-- =====================================================
         ORDER CARD
         ===================================================== -->

    <section class="order-card">


        <div class="order-card-header">


            <div class="order-card-heading">


                <div class="order-card-icon">

                    ◈

                </div>


                <div>

                    <h2>

                        Live Order Tracking

                    </h2>


                    <span>

                        RestaurantQR Kitchen Connection

                    </span>

                </div>


            </div>


            <div class="order-live-tag">

                <span class="order-live-dot"></span>

