<!-- Tracking -->

<input type="hidden"
       id="tracking-order-id"
       value="@Model.OrderId" />


<input type="hidden"
       id="tracking-token"
       value="@Model.TrackingToken" />


@section Scripts
{

    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>


    <script>


        /* =====================================================
           BASIC ELEMENTS
           ===================================================== */

        const orderId =
            Number(
                document
                    .getElementById(
                        "tracking-order-id"
                    )
                    .value
            );


        const trackingToken =
            document
                .getElementById(
                    "tracking-token"
                )
                .value;


        const statusElement =
            document.getElementById(
                "order-status"
            );


        const messageElement =
            document.getElementById(
                "status-message"
            );


        const progressSteps =
            document.querySelectorAll(
                ".progress-step"
            );


        const confirmationPage =
            document.getElementById(
                "order-confirmation-page"
            );


        const invoiceContainer =
            document.getElementById(
                "invoice-container"
            );


        const statusOrder = [

            "Pending",

            "Accepted",

            "Preparing",

            "Ready",

            "Completed"

        ];


        /* =====================================================
           COMPLETION ANIMATION
           ===================================================== */

        let completionAnimationPlayed =
            false;


        function playCompletedAnimation() {


            if (completionAnimationPlayed) {

                return;

            }


            completionAnimationPlayed =
                true;


            confirmationPage.classList.add(
                "order-completed"
            );


            createConfetti();


            console.log(
                "🎉 Order completed animation started."
            );

        }


        /* =====================================================
           CUSTOMER INVOICE
           ===================================================== */

        let customerInvoiceLoaded =
            false;


        async function loadCustomerInvoice() {


            if (customerInvoiceLoaded) {

                return;

            }


            if (!invoiceContainer) {

                return;

            }


            try {


                const response =
                    await fetch(
                        '@Url.Action("Invoice", "Order", new { id = Model.OrderId })'
                    );


                if (!response.ok) {

                    console.log(
                        "Invoice is not available yet."
                    );

                    return;

                }


                const html =
                    await response.text();


                invoiceContainer.innerHTML =
                    html;


                customerInvoiceLoaded =
                    true;


                /*
                 * Small delay so browser can
                 * trigger the entrance animation.
                 */

                requestAnimationFrame(
                    function () {

                        invoiceContainer.classList.add(
                            "invoice-visible"
                        );

                    }
                );


            }
            catch (error) {


                console.error(
                    "Unable to load invoice:",
                    error
                );


            }

        }


        /* =====================================================
           CONFETTI
           ===================================================== */

        function createConfetti() {


            const container =
                document.createElement(
                    "div"
                );


            container.className =
                "completion-confetti";


            document.body.appendChild(
                container
            );


            const pieces = 55;


            for (
                let i = 0;
                i < pieces;
                i++
            ) {


                const piece =
                    document.createElement(
                        "span"
                    );


                piece.className =
                    "confetti-piece";


                const left =
                    Math.random() * 100;


                const drift =
                    (Math.random() * 240) - 120;


                const delay =
                    Math.random() * .45;


                const fallTime =
                    2.5 +
                    Math.random() * 2;


                const rotation =
                    Math.random() * 360;


                piece.style.left =
                    left + "%";


                piece.style.setProperty(
                    "--drift",
                    drift + "px"
                );


                piece.style.setProperty(
                    "--delay",
                    delay + "s"
                );


                piece.style.setProperty(
                    "--fall-time",
                    fallTime + "s"
                );


                piece.style.transform =
                    "rotate(" +
                    rotation +
                    "deg)";


                const width =
                    5 +
                    Math.random() * 6;


                const height =
                    8 +
                    Math.random() * 9;


                piece.style.width =
                    width + "px";


                piece.style.height =
                    height + "px";


                const colors = [

                    "#7F9158",

                    "#B8894D",

                    "#6F4E37",

                    "#DCC7AA",

                    "#4B3832"

                ];


                piece.style.background =
                    colors[
                        Math.floor(
                            Math.random() *
                            colors.length
                        )
                    ];


                container.appendChild(
                    piece
                );

            }


            setTimeout(
                function () {

                    container.remove();

                },
                5500
            );

        }


        /* =====================================================
           UPDATE ORDER UI
           ===================================================== */

        function updateOrderUi(status) {


            statusElement.textContent =
                status;


            statusElement.className =
                "order-status-badge";


            const normalized =
                status.toLowerCase();


            if (
                normalized === "pending"
            ) {


                statusElement.classList.add(
                    "status-pending"
                );


                messageElement.textContent =
                    "Waiting for the restaurant to accept your order.";

            }


            else if (
                normalized === "accepted"
            ) {


                statusElement.classList.add(
                    "status-accepted"
                );


                messageElement.textContent =
                    "Your order has been accepted by the restaurant.";

            }


            else if (
                normalized === "preparing"
            ) {


                statusElement.classList.add(
                    "status-preparing"
                );


                messageElement.textContent =
                    "Your food is being freshly prepared.";

            }


            else if (
                normalized === "ready"
            ) {


                statusElement.classList.add(
                    "status-ready"
                );


                messageElement.textContent =
                    "Your order is ready! It will be served shortly.";

            }


            else if (
                normalized === "completed"
            ) {


                statusElement.classList.add(
                    "status-completed"
                );


                messageElement.textContent =
                    "Order completed. Enjoy your meal!";


                /*
                 * Completed animation
                 */

                playCompletedAnimation();


                /*
                 * Load invoice after
                 * completion animation.
                 */

                setTimeout(
                    loadCustomerInvoice,
                    700
                );

            }


            const currentIndex =
                statusOrder.indexOf(
                    status
                );


            progressSteps.forEach(
                function (step, index) {


                    if (
                        currentIndex >= 0 &&
                        index <= currentIndex
                    ) {


                        step.classList.add(
                            "active"
                        );

                    }


                    else {


                        step.classList.remove(
                            "active"
                        );

                    }

                }
            );

        }


        /* =====================================================
           INITIAL STATUS
           ===================================================== */

        updateOrderUi(
            "@Model.Status"
        );


        /*
         * If customer refreshes the page after
         * order was already completed,
         * invoice should still appear.
         */

        if (
            "@Model.Status".toLowerCase() ===
            "completed"
        ) {


            setTimeout(
                loadCustomerInvoice,
                500
            );

        }


        /* =====================================================
           SIGNALR
           ===================================================== */

        const connection =
            new signalR
                .HubConnectionBuilder()
                .withUrl("/orderHub")
                .withAutomaticReconnect()
                .build();


        connection.on(
            "OrderStatusChanged",
            function (data) {


                if (
                    Number(data.orderId) !==
                    orderId
                ) {

                    return;

                }


                updateOrderUi(
                    data.status
                );

            }
        );


        connection
            .start()
            .then(
                function () {


                    return connection.invoke(
                        "JoinOrderGroup",
                        trackingToken
                    );

                }
            )
            .catch(
                function (error) {


                    console.error(
                        "Order tracking connection error:",
                        error
                    );

                }
            );


        /* =====================================================
           REJOIN AFTER AUTO RECONNECT
           ===================================================== */

        connection.onreconnected(
            function () {


                connection
                    .invoke(
                        "JoinOrderGroup",
                        trackingToken
                    )
                    .catch(
                        function (error) {


                            console.error(
                                "Unable to rejoin order group:",
                                error
                            );

                        }
                    );

            }
        );


    </script>

}