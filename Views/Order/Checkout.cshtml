@model RestaurantQR.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
    Layout = "/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-4">

    <h1>Review Order</h1>

    <p class="text-muted">
        @Model.Cart.TableNumber
    </p>

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            @foreach (var item in Model.Cart.Items)
            {
                <div class="d-flex
                                justify-content-between
                                align-items-start
                                border-bottom py-2">

                    <div>

                        <strong>
                            @item.Name
                        </strong>

                        @if (!string.IsNullOrWhiteSpace(item.OptionName))
                        {
                            <div class="text-muted small mt-1">
                                Serving:
                                <strong>
                                    @item.OptionName
                                </strong>
                            </div>
                        }

                        <div class="text-muted mt-1">
                            @item.Quantity ×
                            ₹@item.Price.ToString("0.00")
                        </div>

                    </div>

                    <strong>
                        ₹@item.LineTotal.ToString("0.00")
                    </strong>

                </div>
            }

            <div class="text-end mt-3">

                <h4>
                    Total:
                    ₹@Model.Cart.Subtotal.ToString("0.00")
                </h4>

            </div>

        </div>

    </div>

    <form asp-controller="Order"
          asp-action="PlaceOrder"
          method="post">

        <div class="mb-3">

            <label asp-for="CustomerNote"
                   class="form-label">
            </label>

            <textarea asp-for="CustomerNote"
                      class="form-control"
                      rows="3"
                      placeholder="Example: No onions, less spicy...">
            </textarea>

            <span asp-validation-for="CustomerNote"
                  class="text-danger">
            </span>

        </div>

        <div class="d-flex
                    justify-content-between">

            <a asp-controller="Cart"
               asp-action="Index"
               class="btn btn-secondary">
                Back to Cart
            </a>

            <button type="submit"
                    class="btn btn-success btn-lg">
                Place Order
            </button>

        </div>

    </form>

</div>